{
  "name": "spectra",
  "version": "1.3.1",
  "description": "Spectra AI - Desktop Copilot",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "dist": "electron-builder --win nsis --x64"
  },
  "build": {
    "appId": "com.spectra.app",
    "productName": "⠀",
    "artifactName": "Spectra-Installer-amd64.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "web/**/*",
      "assets/**/*",
      "ai_providers.json",
      "ai_providers.example.json",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/blank.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Spectra AI"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/arthurhenriquelopes/Spectra.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/arthurhenriquelopes/Spectra/issues"
  },
  "homepage": "https://github.com/arthurhenriquelopes/Spectra#readme",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "openai": "^7.23.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  }
}
