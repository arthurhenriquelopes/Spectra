focus-divider\"></div>\n                            <div class=\"checkbox-group brief-mode-group\">\n                                <label class=\"brief-mode-label\"><input type=\"checkbox\" name=\"focus\" value=\"brief-human\"> 💬 Brief & Human<small>Senior-level answers in one natural paragraph</small></label>\n                            </div>\n                        </fieldset>\n                    </div>\n                    <fieldset>\n                        <legend>Job Description / Requirements</legend>\n                        <