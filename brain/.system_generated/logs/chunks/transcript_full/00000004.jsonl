Not found'}\")\n33: \n34:     # --- Method 3: Try multiple search attempts with delay ---\n35:     if not hwnd:\n36:         print(\"⚠️ Trying multiple search attempts...\")\n37:         for attempt in range(5):\n38:             time.sleep(0.05)\n39:             hwnd = _user32.FindWindowW(None, \"Spectra\")\n40:             if hwnd:\n41:                 print(f\"🔍 Method 3 (attempt {attempt + 1}): Found {hex(hwnd)}\")\n42:                 break\n43:         \n44:     # --- Apply the Protection ---\n45:     if not hwnd:\n46:         print(\"❌ CRITICAL: Could not obtain window handle! Screen capture protection NOT applied!\")\n47:         print(\"   This means the window WILL be visible in screen recordings!\")\n48:         return False\n49: \n50:     print(f\"🛡️ Applying WDA_EXCLUDEFROMCAPTURE (0x{WDA_EXCLUDEFROMCAPTURE:08X}) to window {hex(hwnd)}...\")\n51:     success = _user32.SetWindowDisplayAffinity(hwnd, WDA_EXCLUDEFROMCAPTURE)\n52: \n53:     if success:\n54:         print(f\"✅ SUCCESS: Window {hex(hwnd)} is now HIDDEN from screen capture!\")\n55:         print(\"   🎯 Window will appear as BLACK RECTANGLE in recordings/screen sharing\")\n56:         \n57:         # Set window handle and hide from taskbar\n58:         window_manager.set_window_handle(hwnd)\n59:         window_manager.hide_from_taskbar()\n60:         \n61:         # Start screen share indicator monitoring\n62:         window_manager.start_screen_share_monitor()\n63:         \n64:         # Verify the protection was applied\n65:         verify_protection(hwnd)\n66:         return True\n67:     else:\n68:         error_code = ctypes.GetLastError()\n69:         print(f\"❌ FAILED: SetWindowDisplayAffinity failed! Error Code: {error_code}\")\n70:         print(\"   🚨 WARNING: Window WILL be visible in screen recordings!\")\n71:         return False\n72: \n73: def verify_protection(hwnd) -> Optional[bool]:\n74:     \"\"\"Verify that capture protection is actually applied.\n75: \n76:     Returns True when the window's display affinity reads back as\n77:     WDA_EXCLUDEFROMCAPTURE, False when it reads back as something else, and\n78:     None when verification was not possible (API unavailable, call failed, or\n79:     an unexpected error). Diagnostic only - this never raises and the result\n80:     can safely be ignored.\n81:     \"\"\"\n82:     try:\n83:         print(f\"🔬 Verifying protection on window {hex(hwnd)}...\")\n84:         \n85:         if _HAS_GET_DISPLAY_AFFINITY:\n86:             affinity = wintypes.DWORD(0)\n87:             if _user32.GetWindowDisplayAffinity(hwnd, ctypes.byref(affinity)):\n88:                 if affinity.value == WDA_EXCLUDEFROMCAPTURE:\n89:                     print(f\"✅ CONFIRMED: display affinity is WDA_EXCLUDEFROMCAPTURE (0x{affinity.value:08X})\")\n90:                     return True\n91:                 print(f\"❌ MISMATCH: display affinity is 0x{affinity.value:08X}, expected 0x{WDA_EXCLUDEFROMCAPTURE:08X}\")\n92:                 print(\"   🚨 WARNING: Window may still be visible in screen recordings!\")\n93:                 return False\n94:             print(f\"⚠️ GetWindowDisplayAffinity failed (Error Code: {ctypes.GetLastError()}) - falling back to handle check\")\n95:         else:\n96:             print(\"⚠️ GetWindowDisplayAffinity unavailable on this system - falling back to handle check\")\n97: \n98:         is_window_valid = _user32.IsWindow(hwnd)\n99:         if is_window_valid:\n100:             print(\"✅ Window handle is valid - protection likely applied\")\n101:         else:\n102:             print(\"❌ Window handle is invalid - protection may have failed\")\n103:         return None\n104:             \n105:     except Exception as e:\n106:         print(f\"⚠️ Could not verify protection: {e}\")\n107: \nThe above content shows the entire, complete file contents of the requested file.\n"}
