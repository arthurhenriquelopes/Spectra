gManager = configManager;\n31: \n32: // --- Dependency Injection ---\n33: // Wire the managers together to avoid race conditions and reliance on globals.\n34: // This ensures the WebSocketHandler has a direct reference to the ProviderManager.\n35: webSocketHandler.setProviderManager(providerManager);\n36: \n37: // --- DOM Elements ---\n38: const views = {\n39:     onboarding: document.getElementById('onboarding-view'),\n40:     preflight: document.getElementById('preflight-view'),\n41:     live: document.getElementById('live-view'),\n42: };\n43: \n44: const micSelect = document.getElementById('mic-select');\n45: const proceedButton = document.getElementById('proceed-to-checks');\n46: const startButton = document.getElementById('start-interview-button');\n47: const backButton = document.getElementById('back-to-onboarding-btn');\n48: \n49: // --- Tab Management ---\n50: function setupTabs() {\n51:     const tabBtns = document.querySelectorAll('.tab-btn');\n52:     const tabPanes = document.querySelectorAll('.tab-pane');\n53: \n54:     tabBtns.forEach(btn => {\n55:         btn.addEventListener('click', () => {\n56:             const targetId = btn.getAttribute('data-tab');\n57: \n58:             // Update buttons\n59:             tabBtns.forEach(b => b.classList.remove('active'));\n60:             btn.classList.add('active');\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
