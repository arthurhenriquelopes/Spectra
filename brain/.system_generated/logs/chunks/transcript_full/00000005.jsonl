ss=\"container\">\r\n27:             <div class=\"brand-header\">\r\n28:                 <div class=\"brand-logo\">SPECTRA</div>\r\n29:                 <span class=\"brand-tagline\">AI Interview Coach</span>\r\n30:             </div>\r\n31:             <p class=\"subtitle\">Set up your profile, AI preferences, and API credentials.</p>\r\n32: \r\n33:             <!-- Tab Navigation -->\r\n34:             <div class=\"tabs-nav\">\r\n35:                 <button class=\"tab-btn active\" data-tab=\"profile-tab\">1. Your Profile</button>\r\n36:                 <button class=\"tab-btn\" data-tab=\"ai-setup-tab\">2. AI Setup</button>\r\n37:                 <button class=\"tab-btn\" data-tab=\"advanced-config-tab\">3. Advanced Config</button>\r\n38:                 <button class=\"tab-btn\" data-tab=\"commands-tab\">4. Commands & Tips</button>\r\n39:             </div>\r\n40: \r\n41:             <div class=\"tab-content\">\r\n42:                 <!-- Tab 1: Profile -->\r\n43:                 <div id=\"profile-tab\" class=\"tab-pane active\">\r\n44:                     <div class=\"onboarding-grid\">\r\n45:                         <fieldset class=\"grid-span-1\">\r\n46:                             <legend>Candidate Profile <button type=\"button\" id=\"fill-demo-btn\" class=\"demo-fill-btn\"\r\n47:                                     title=\"Fill with demo data\">⚡ Demo</button></legend>\r\n48:                             <input type=\"text\" id=\"user-name\" placeholder=\"Your Name\" required>\r\n49:                             <input type=\"text\" id=\"user-company\" placeholder=\"Company You're Interviewing With (Optional)\">\r\n50:                             <input type=\"text\" id=\"user-role\" placeholder=\"Target Role\" required>\r\n51:                             <div class=\"resume-input-group\">\r\n52:                                 <textarea id=\"user-resume\" placeholder=\"Paste your resume text here or upload a PDF...\" required></textarea>\r\n53:                                 <div class=\"resume-upload\">\r\n54:                                     <label for=\"resume-pdf-upload\" class=\"upload-btn\" title=\"Upload PDF resume\">📄 Upload PDF</label>\r\n55:                                     <input type=\"file\" id=\"resume-pdf-upload\" accept=\".pdf,.txt\" hidden>\r\n56:                                     <span id=\"resume-upload-status\" class=\"upload-status\"></span>\r\n57:                                 </div>\r\n58:                             </div>\r\n59:                         </fieldset>\r\n60: \r\n61:                         <fieldset class=\"grid-span-1\">\r\n62:                             <legend>Interview Focus</legend>\r\n63:                             <div class=\"checkbox-group\">\r\n64:                                 <label><input type=\"checkbox\" name=\"focus\" value=\"behavioral\"> Behavioral</label>\r\n65:                                 <label><input type=\"checkbox\" name=\"focus\" value=\"system-design\"> System Design</label>\r\n66:                                 <label><input type=\"checkbox\" name=\"focus\" value=\"dsa\"> Data Structures &\r\n67:                                     Algorithms</label>\r\n68:                                 <label><input type=\"checkbox\" name=\"focus\" value=\"coding\"> Coding</label>\r\n69:                                 <label><input type=\"checkbox\" name=\"focus\" value=\"cultural-fit\"> Cultural Fit</label>\r\n70:                                 <label><input type=\"checkbox\" name=\"focus\" value=\"hr\"> HR / Screening</label>\r\n71:                             </div>\r\n72:                             <div class=\"focus-divider\"></div>\r\n73:                             <div class=\"checkbox-group brief-mode-group\">\r\n74:                                 <label class=\"brief-mode-label\"><input type=\"checkbox\" name=\"focus\" value=\"brief-human\"> 💬 Brief & Human<small>Senior-level answers in one natural paragraph</small></label>\r\n75:                             </div>\r\n76:                         </fieldset>\r\n77:                     </div>\r\n78:                     <fieldset>\r\n79:                         <legend>Job Description / Requirements</legend>\r\n80:                         <textarea id=\"user-objectives\"\r\n81:                             placeholder=\"Paste the job description or key requirements here to give the AI context.\" required></textarea>\r\n82:                     </fieldset>\r\n83:                 </div>\r\n84: \r\n85:                 <!-- Tab 2: AI Setup -->\r\n86:                 <div id=\"ai-setup-tab\" class=\"tab-pane\">\r\n87:                     <fieldset>\r\n88:                         <legend>AI Configuration</legend>\r\n89:                         <div class=\"ai-config-section\">\r\n90:                             <div class=\"ai-config-primary\">\r\n91:                                 <h4>Primary AI Model (Default)</h4>\r\n92:                                 <div class=\"ai-config-group\">\r\n93:                                     <select id=\"ai-provider-select\" aria-label=\"Primary AI provider\" required>\r\n94:                                         <option value=\"\">Select AI Provider</option>\r\n95:                                     </select>\r\n96:                                     <select id=\"ai-model-select\" aria-label=\"Primary AI model\" disabled required>\r\n97:                                         <option value=\"\">Select Model</option>\r\n98:                                     </select>\r\n99:                                 </div>\r\n100:                                 <small class=\"config-hint\">Primary model will be used by default for all\r\n101:                                     responses</small>\r\n102:                             </div>\r\n103: \r\n104:                             <div class=\"ai-config-secondary\">\r\n105:                                 <h4>Secondary AI Model (Optional)</h4>\r\n106:                                 <div class=\"ai-config-group\">\r\n107:                                     <select id=\"ai-secondary-provider-select\" aria-label=\"Secondary AI provider\">\r\n108:                                         <option value=\"\">Select Secondary Provider (Optional)</option>\r\n109:                                     </select>\r\n110:                                     <select id=\"ai-secondary-model-select\" aria-label=\"Secondary AI model\" disabled>\r\n111:                                         <option value=\"\">Select Secondary Model</option>\r\n112:                                     </select>\r\n113:                                 </div>\r\n114:                                 <small class=\"config-hint\">Switch to secondary model anytime with Alt+W hotkey during\r\n115:                                     interview</small>\r\n116:                             </div>\r\n117: \r\n118:                             <div class=\"preset-info\">\r\n119:                                 <h4>Quick Switch Hotkeys</h4>\r\n120:                                 <div class=\"hotkey-list\">\r\n121:                                     <span class=\"hotkey-item\"><kbd>Alt+Q</kbd> Primary Model</span>\r\n122:                                     <span class=\"hotkey-item\"><kbd>Alt+W</kbd> Secondary Model</span>\r\n123:                                     <span class=\"hotkey-item\"><kbd>Alt+E</kbd> Auto-Select Best</span>\r\n124:                                 </div>\r\n125:                             </div>\r\n126:                         </div>\r\n127:                     </fieldset>\r\n128: \r\n129:                     <fieldset>\r\n130:                         <legend>Vision AI Configuration (Optional)</legend>\r\n131:                         <div class=\"vision-config-section\">\r\n132:                             <div class=\"vision-config-primary\">\r\n133:                                 <h4>Primary Vision Model (Default)</h4>\r\n134:                       