     // If streaming is disabled, show content immediately\n36:             if (this.config.enableMarkdown) {\n37:                 this.displayInstantMarkdown(container, content);\n38:             } else {\n39:                 this.displayInstantText(container, content);\n40:             }\n41:             container.parentElement.classList.add('complete');\n42:             if (onProgress) onProgress(); // Final callback\n43:             return;\n44:         }\n45: \n46:         // Process with markdown if enabled\n47:         if (this.config.enableMarkdown) {\n48:             await this.streamMarkdownContent(container, content, actualSpeed, onProgress);\n49:         } else {\n50:             // Fallback to original logic\n51:             if (content.includes('```')) {\n52:                 await this.streamComplexContent(container, content, actualSpeed, onProgress);\n53:             } else {\n54:                 await this.streamSimpleText(container, content, actualSpeed, onProgress);\n55:             }\n56:         }\n57: \n58:         container.parentElement.classList.add('complete');\n59:     }\n60: \n61:     // Stream simple text\n62:     async streamSimpleText(container, text, speed, onProgress = null) {\n63:         const words = text.split(' ');\n64:         \n65:         for (let i = 0; i < words.length; i++) {\n66:             const wordSpan = document.createElement('span');\n67:             wordSpan.className = 'word';\n68:             wordSpan.textContent = words[i] + (i < words.length - 1 ? ' ' : '');\n69:             \n70:             container.appendChild(wordSpan);\n71:             \n72:             setTimeout(() => {\n73:                 wordSpan.style.opacity = '1';\n74:             }, 10);\n75:             \n76:             await this.delay(speed);\n77:             \n78:             // Callback for scroll updates\n79:             if (onProgress && i % 3 === 0) {\n80:                 onProgress();\n81:             }\n82:         }\n83:         \n84:         // Final callback\n85:         if (onProgress) {\n86:             onProgress();\n87:         }\n88:     }\n89: \n90:     // Stream complex content with code\n91:     async streamComplexContent(container, content, speed, onProgress = null) {\n92:         const parts = this.parseContent(content);\n93:         \n94:         for (const part of parts) {\n95:             if (part.type === 'text') {\n96:                 await this.streamSimpleText(container, part.content, speed, onProgress);\n97:             } else if (part.type === 'code') {\n98:                 this.addCodeBlock(container, part.content, part.language);\n99:                 await this.delay(200); // Reduced delay for faster display\n100:             }\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
