emoBtn.addEventListener('click', (e) => {\n78:             e.preventDefault();\n79:             e.stopPropagation();\n80:             autofillForTesting();\n81:             fillDemoBtn.textContent = '✅ Filled!';\n82:             setTimeout(() => { fillDemoBtn.textContent = '⚡ Demo'; }, 1500);\n83:         });\n84:     }\n85: }\n86: \n87: \n88: // --- View Management ---\n89: function switchView(targetView) {\n90:     Object.values(views).forEach(view => view.classList.remove('active'));\n91:     views[targetView].classList.add('active');\n92: }\n93: \n94: function handleOnboarding() {\n95:     if (stateManager.handleOnboarding()) {\n96:         switchView('preflight');\n97:         runPreFlightChecks();\n98:     }\n99: }\n100: \n101: async function runPreFlightChecks() {\n102:     // --- 1. Microphone Check ---\n103:     // First, ensure we have microphone permissions as this is a prerequisite.\n104:     const micPermissionCheck = document.getElementById('check-mic-permission');\n105:     const micSelectionCheck = document.getElementById('check-mic-selection');\n106: \n107:     providerManager.webSocketHandler.updateCheckStatus(micPermissionCheck, 'pending', 'Requesting Microphone...');\n108:     const micPermission = await setupMicrophone();\n109:     if (micPermission) {\n110:         providerManager.webSocketHandler.updateCheckStatus(micPermissionCheck, 'success', 'Microphone Permission OK');\n111:         providerManager.webSocketHandler.updateCheckStatus(micSelectionCheck, 'success', 'Microphone Selection Ready');\n112:     } else {\n113:         providerManager.webSocketHandler.updateCheckStatus(micPermissionCheck, 'error', 'Microphone Permission Denied');\n114:         providerManager.webSocketHandler.updateCheckStatus(micSelectionCheck, 'error', 'Microphone Selection Failed');\n115:         return;\n116:     }\n117: \n118:     // --- 2. Backend Connection and Session Establishment (NEW ASYNC FLOW) ---\n119:     // We now `await` the connection. The `connect`