         this.loadInitialPrivateMode();\n34:         this.renderSessionCards();\n35:     }\n36: \n37:     // --- Theme Management ---\n38:     applyTheme(theme) {\n39:         this.currentTheme = theme;\n40:         localStorage.setItem('spectra_theme', theme);\n41:         \n42:         let effectiveTheme = theme;\n43:         if (theme === 'system') {\n44:             effectiveTheme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';\n45:         }\n46: \n47:         document.documentElement.setAttribute('data-theme', effectiveTheme);\n48: \n49:         // Update active theme toggle buttons\n50:         document.querySelectorAll('.theme-toggle-btn').forEach(btn => {\n51:             btn.classList.toggle('active', btn.getAttribute('data-theme') === theme);\n52:         });\n53:     }\n54: \n55:     // --- Private Mode (Anti-Proctoring / Screenshot Toggle) ---\n56:     async loadInitialPrivateMode() {\n57:         if (window.spectraAPI && window.spectraAPI.getPrivateMode) {\n58:             this.isPrivateMode = await window.spectraAPI.getPrivateMode();\n59:         }\n60:         const privateToggle = document.getElementById('private-mode-toggle');\n61:         if (privateToggle) {\n62:             privateToggle.checked = this.isPrivateMode;\n63:         }\n64:     }\n65: \n66:     setPrivateMode(enabled) {\n67:         this.isPrivateMode = enabled;\n68:         if (window.spectraAPI && window.spectraAPI.setPrivateMode) {\n69:             window.spectraAPI.setPrivateMode(enabled);\n70:         }\n71:         console.log(`[UI] Private mode: ${enabled ? 'ON (Hidden from capture)' : 'OFF (Visible in screenshots)'}`);\n72:     }\n73: \n74:     // --- Header Window Controls ---\n75:     bindHeaderControls() {\n76:         const closeBtn = document.getElementById('parakeet-close-btn');\n77:         if (closeBtn) {\n78:             closeBtn.addEventListener('click', () => {\n79:                 if (window.spectraAPI && window.spectraAPI.closeApp) {\n80:                     window.spectraAPI.closeApp();\n81:                 } else {\n82:                     window.close();\n83:                 }\n84:             });\n85:         }\n86: \n87:         const minimizeBtn = document.getElementById('parakeet-minimize-btn');\n88:         if (minimizeBtn) {\n89:             minimizeBtn.addEventListener('click', () => {\n90:                 if (window.spectraAPI && window.spectraAPI.minimizeApp) {\n91:                     window.spectraAPI.minimizeApp();\n92:                 }\n93:             });\n94:         }\n95: \n96:         const moveBtn = document.getElementById('parakeet-move-btn');\n97:         if (moveBtn) {\n98:             moveBtn.addEventListener('click', () => {\n99:                 if (window.spectraAPI && window.spectraAPI.openMoveOverlay) {\n100:                     window.spectraAPI.openMoveOverlay();\n101:                 }\n102:             });\n103:         }\n104:     }\n105: \n106:     // --- Settings Dropdown ---\n107:     bindSettingsDropdown() {\n108:         const menuBtn = document.getElementById('parakeet-settings-menu-btn');\n109:         const menuDropdown = document.getElementById('parakeet-dropdown-menu');\n110:         const privateToggle = document.getElementById('private-mode-toggle');\n111: \n112:         if (menuBtn && menuDropdown) {\n113:             menuBtn.addEventListener('click', (e) => {\n114:                 e.stopPropagation();\n115:                 menuDropdown.classList.toggle('active');\n116:             });\n117: \n118:             document.addEventListener('click', (e) => {\n119:                 if (!menuDropdown.contains(e.target) && e.target !== menuBtn) {\n120:                     menuDropdown.classList.remove('active');\n121:                 }\n122:             });\n123: \n124:             document.addEventListener('keydown', (e) => {\n125:                 if (e.key === 'Escape') {\n126:                     menuDropdown.classList.remove('active');\n127:                 }\n128:             });\n129:         }\n130: \n131:         // Private switch\n132:         if (privateToggle) {\n133:             privateToggle.addEventListener('change', (e) => {\n134:                 this.setPrivateMode(e.target.checked);\n135:             });\n136:         }\n137: \n138:         // Theme toggle buttons in menu\n139:         document.querySelectorAll('.theme-toggle-btn').forEach(btn => {\n140:             btn.addEventListener('click', () => {\n141:                 const targetTheme = btn.getAttribute('data-theme');\n142:                 this.applyTheme(targetTheme);\n143:             });\n144:         });\n145: \n146:         // Zoom controls\n147:         const zoomInBtn = document.getElementById('zoom-in-btn');\n148:         const zoomOutBtn = document.getElementById('zoom-out-btn');\n149:         const zoomResetBtn = document.getElementById('zoom-reset-btn');\n150: \n151:         if (zoomInBtn) {\n152:             zoomInBtn.addEventListener('click', () => {\n153:                 this.currentZoom = Math.min(1.4, this.currentZoom + 0.1);\n154:                 document.body.style.zoom = this.currentZoom;\n155:             });\n156:         }\n157:         if (zoomOutBtn) {\n158:             zoomOutBtn.addEventListener('click', () => {\n159:                 this.currentZoom = Math.max(0.7, this.currentZoom - 0.1);\n160:                 document.body.style.zoom = this.currentZoom;\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
