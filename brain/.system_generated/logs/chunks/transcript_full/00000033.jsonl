</div>\n            </div>\n\n            <!-- Real-Time Conversation Stream -->\n            <div class=\"live-stream-scroll\" id=\"conversation-stream\">\n                <div class=\"speech-bubble interviewer\">\n                    <div class=\"speech-sender-tag\">Interviewer</div>\n                    <div>Listening to your interview questions in real time...</div>\n                </div>\n            </div>\n\n            <!-- Listening Indicator -->\n            <div id=\"activity-indicator\" style=\"display: flex; align-items: center; gap: 8px; font-size: 12px; color: var(--text-muted); padding-top: 8px;\">\n                <div class=\"live-pulse-dot\" style=\"background: var(--brand-green); width: 6px; height: 6px;\"></div>\n                <span>Listening actively...</span>\n            </div>\n        </section>\n\n    </div>\n\n    <!-- Hidden audio elements and background support -->\n    <div style=\"display: none;\">\n        <span id=\"status-indicator\"></span>\n        <button id=\"proceed-to-checks\"></button>\n        <button id=\"start-interview-button\"></button>\n        <button id=\"back-to-onboarding-btn\"></button>\n        <div id=\"check-mic-permission\"></div>\n        <div id=\"check-mic-selection\"></div>\n        <div id=\"check-backend\"></div>\n        <div id=\"check-deepgram\"></div>\n        <div id=\"check-ai-provider\"></div>\n        <div id=\"check-ai-secondary-provider\"></div>\n        <div id=\"check-vision-provider\"></div>\n        <div id=\"check-vision-secondary-provider\"></div>\n        <div id=\"quick-presets-grid\"></div>\n        <input type=\"checkbox\" name=\"focus\" value=\"coding\" checked>\n        <input type=\"checkbox\" name=\"focus\" value=\"dsa\" checked>\n        <input type=\"checkbox\" name=\"focus\" value=\"system-design\">\n        <input type=\"checkbox\" name=\"focus\" value=\"behavioral\">\n    </div>\n\n    <!-- Application Logic Modules -->\n    <script type=\"module\" src=\"js/parakeet-ui.js\