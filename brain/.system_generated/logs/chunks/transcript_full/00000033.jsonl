tListener('click', () => {\n189:                 if (hubView) hubView.style.display = 'none';\n190:                 if (createView) createView.style.display = 'flex';\n191:                 this.goToStep(1);\n192:             });\n193:         }\n194: \n195:         // Cancel and Return to Hub\n196:         if (cancelCreateBtn) {\n197:             cancelCreateBtn.addEventListener('click', () => {\n198:                 if (createView) createView.style.display = 'none';\n199:                 if (hubView) hubView.style.display = 'flex';\n200:             });\n201:         }\n202: \n203:         // Session Type Selector (Interview vs Regular)\n204:         const typeInterviewBtn = document.getElementById('type-interview-btn');\n205:         const typeRegularBtn = document.getElementById('type-regular-btn');\n206:         if (typeInterviewBtn && typeRegularBtn) {\n207:             typeInterviewBtn.addEventListener('click', () => {\n208:                 typeInterviewBtn.classList.add('active');\n209:                 typeRegularBtn.classList.remove('active');\n210:                 this.sessionData.type = 'interview';\n211:             });\n212:             typeRegularBtn.addEventListener('click', () => {\n213:                 typeRegularBtn.classList.add('active');\n214:                 typeInterviewBtn.classList.remove('active');\n215:                 this.sessionData.type = 'regular';\n216:             });\n217:         }\n218: \n219:         // Inputs binding\n220:         const companyInput = document.getElementById('session-company-input');\n221:         const jobDescInput = document.getElementById('session-jobdesc-input');\n222:         if (companyInput) {\n223:             companyInput.addEventListener('input', (e) => {\n224:                 this.sessionData.company = e.target.value.trim();\n225:             });\n226:         }\n227:         if (jobDescInput) {\n228:             jobDescInput.addEventListener('input', (e) => {\n229:                 this.sessionData.jobDescription = e.target.value.trim();\n230:             });\n231:         }\n232: \n233:         // Context selectors (CV & Docs)\n234:         this.bindContextUploaders();\n235: \n236:         // Next Step (from Details to Preferences)\n237:         if (nextStepBtn) {\n238:             nextStepBtn.addEventListener('click', () => {\n239:                 this.goToStep(2);\n240:             });\n241:         }\n242: \n243:         // Back to Details\n244:         if (backStepBtn) {\n245:             backStepBtn.addEventListener('click', () => {\n246:                 this.goToStep(1);\n247:             });\n248:         }\n249: \n250:         // Launch Live Session\n251:         if (startLiveBtn) {\n252:             startLiveBtn.addEventListener('click', () => {\n253:                 this.launchSession();\n254:             });\n255:         }\n256:     }\n257: \n258:     goToStep(stepNumber) {\n259:         this.activeStep = stepNumber;\n260:         const step1Content = document.getElementById('create-step-1');\n261:         const step2Content = document.getElementById('create-step-2');\n262:         const step1Item = document.getElementById('step-item-1');\n263:         const step2Item = document.getElementById('step-item-2');\n264: \n265:         if (stepNumber === 1) {\n266:             if (step1Content) step1Content.style.display = 'flex';\n267:             if (step2Content) step2Content.style.display = 'none';\n268:             if (step1Item) step1Item.classList.add('active');\n269:             if (step2Item) step2Item.classList.remove('active');\n270:         } else {\n271:             if (step1Content) step1Content.style.display = 'none';\n272:             if (step2Content) step2Content.style.display = 'flex';\n273:             if (step1Item) step1Item.classList.remove('active');\n274:             if (step2Item) step2Item.classList.add('active');\n275:         }\n276:     }\n277: \n278:     bindContextUploaders() {\n279:         const cvSelector = document.getElementById('cv-resume-selector');\n280:         const docSelector = document.getElementById('documents-selector');\n281:         const cvFileInput = document.getElementById('cv-file-input');\n282:         const docFileInput = document.getElementById('doc-file-input');\n283:         const cvLabel = document.getElementById('cv-resume-label');\n284:         const docLabel = document.getElementById('documents-label');\n285: \n286:         if (cvSelector && cvFileInput) {\n287:             cvSelector.addEventListener('click', () => cvFileInput.click());\n288:             cvFileInput.addEventListener('change', (e) => {\n289:                 const file = e.target.files[0];\n290:                 if (file) {\n291:                     this.sessionData.resumeName = file.name;\n292:                     if (cvLabel) cvLabel.textContent = file.name;\n293:                     const reader = new FileReader();\n294:                     reader.onload = (event) => {\n295:                         this.sessionData.resumeContent = event.target.result;\n296:                         localStorage.setItem('spectra_saved_resume', event.target.result);\n297:                         localStorage.setItem('spectra_saved_resume_name', file.name);\n298:                     };\n299:                     reader.readAsText(file);\n300:                 }\n301:             });\n302:         }\n303: \n304:         if (docSelector && docFileInput) {\n305:             docSelector.addEventListener('click', () => docFileInput.click());\n306:             docFileInput.addEventListener('change', (e) => {\n307:                 const file = e.target.files[0];\n308:                 if (file) {\n309:                     this.sessionData.documentsName = file.name;\n310:                     if (docLabel) docLabel.textContent = file.name;\n311:                     const reader = new FileReader();\n312:                     reader.onload = (event) => {\n313:                         this.sessionData.documentsContent = event.target.result;\n314:                         localStorage.setItem('spectra_saved_docs', event.target.result);\n315:                         localStorage.setItem('spectra_saved_docs_name', file.name);\n316:                     };\n317:                     reader.readAsText(file);\n318:                 }\n319:             });\n320:         }\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
