ansparency not supported on this platform or no window handle\")\n33:         return False\n34:         \n35:     transparency = max(0.0, min(1.0, transparency))\n36:     manager.current_transparency = transparency\n37:     \n38:     try:\n39:         alpha = int(transparency * 255)\n40:         result = manager.SetLayeredWindowAttributes(\n41:             manager.hwnd,\n42:             0,\n43:             alpha,\n44:             manager.LWA_ALPHA\n45:         )\n46:         \n47:         if result:\n48:             print(f\"✅ Window transparency set to {transparency*100:.0f}%\")\n49:             return True\n50:         else:\n51:             print(\"❌ Failed to set window transparency\")\n52:             return False\n53:             \n54:     except Exception as e:\n55:         print(f\"❌ Error setting transparency: {e}\")\n56:         return False\n57: \n58: def get_transparency(manager) -> float:\n59:     return manager.current_transparency\n60: \nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
