am key: {e}\")\r\n36:         return False\r\n37: \r\n38: \r\n39: class DeepgramManager:\r\n40:     \"\"\"\r\n41:     Manages the connection to Deepgram for live transcription.\r\n42:     \"\"\"\r\n43:     def __init__(self, transcript_callback, user_languages=None):\r\n44:         self.transcript_callback = transcript_callback\r\n45:         self.dg_connection = None\r\n46:         self.is_connected = False\r\n47:         self.stop_event = asyncio.Event()\r\n48:         self.user_languages = user_languages or []\r\n49:         self._reconnect_attempts = 0\r\n50:         self._max_reconnect_attempts = 5\r\n51:         self._reconnect_base_delay = 1.0  # seconds\r\n52:         \r\n53:         # No buffering - process final results immediately for faster response\r\n54:         \r\n55:         # Setup Deepgram client\r\n56:         config = DeepgramClientOptions(\r\n57:             verbose=False,  # Disable verbose logging to reduce spam\r\n58:             options={\"keepalive\": \"true\"}\r\n59:         )\r\n60:         self.deepgram = DeepgramClient(settings.DEEPGRAM_API_KEY, config)\r\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
