ow.chrome && window.chrome.webview) {\n32:             console.log(\"🌐 Running in native C# WebView2 host\");\n33:             window.chrome.webview.addEventListener('message', (event) => {\n34:                 const data = typeof event.data === 'string' ? JSON.parse(event.data) : event.data;\n35:                 this.handleMessage(data);\n36:             });\n37:             this.isNativeHost = true;\n38:             this.updateCheckStatus(this.checks.backend, 'success', 'Native C# Host Connected');\n39:             return Promise.resolve();\n40:         }\n41: \n42:         return new Promise((resolve, reject) => {\n43:             this.is_intentionally_closing = false;\n44:             // Derive the host from the page origin. main.py picks a free port at\n45:             // startup and falls back off 8002 when it is busy, so a hardcoded port\n46:             // would break the socket exactly when the fallback kicks in.\n47:             const host = window.location.host || '127.0.0.1:8002';\n48:             const scheme = window.location.protocol === 'https:' ? 'wss:' : 'ws:';\n49:             let url = `${scheme}//${host}/ws`;\n50:             if (this.session_id) {\n51:                 url += `?session_id=${this.session_id}`;\n52:             }\n53: \n54:             this.updateCheckStatus(this.checks.backend, 'pending', 'Connecting...');\n55:             this.socket = new WebSocket(url);\n56:             this.stateManager.setSocket(this.socket);\n57: \n58:             // Store the promise's resolver to be called when session is confirmed.\n59:             this.resolveConnectionPromise = resolve;\n60: \n61:             // Clear any old listeners before attaching new ones\n62:             this.socket.onopen = null;\n63:             this.socket.onclose = null;\n64:             this.socket.onerror = null;\n65:             this.socket.onmessage = null;\n66:             \n67:             // Use addEventListener for all events for consistency and robustness.\n68:             this.socket.addEventListener('open', this.onOpen.bind(this));\n69:             this.socket.addEventListener('close', this.onClose.bind(this));\n70:             this.socket.addEventListener('error', (err) => {\n71:                 this.onError(err);\n72:                 reject(new Error(\"WebSocket connection failed.\"));\n73:             });\n74:             this.socket.addEventListener('message', this.onMessage.bind(this));\n75:         });\n76:     }\n77: \n78:     onOpen(event) {\n79:         console.log(\"[open] Connection established\");\n80:         // This is now handled by the ProviderManager\n81:         // this.updateCheckStatus(this.checks.backend, 'success', 'Backend Connected');\n82:         this.reconnect_attempts = 0;\n83:     }\n84: \n85:     onClose(event) {\n86:         console.log(`[close] Connection closed. Intentional: ${this.is_intentionally_closing}`);\n87:         // This is now handled by the ProviderManager\n88:         // this.updateCheckStatus(this.checks.backend, 'error', 'Disconnected');\n89:         if (!this.is_intentionally_closing) {\n90:             this.handleReconnect();\n91:         }\n92:     }\n93: \n94:     onError(error) {\n95:         console.error(`[error] WebSocket error:`, error);\n96:         // This is now handled by the ProviderManager\n97:         // this.updateCheckStatus(this.checks.backend, 'error', 'Connection Failed');\n98:     }\n99:     \n100:     onMessage(event) {\n101:         const data = JSON.parse(event.data);\n102:         devLog(\"Received from backend:\", data);\n103: \n104:         if (data.type === 'session_created') {\n105:             this.session_id = data.payload.session_id;\n106:             console.log(`🚀 New session started: ${this.session_id}`);\n107:             // Resolve the connection promise now that session is confirmed.\n108:             if (this.resolveConnectionPromise) {\n109:                 this.resolveConnectionPromise();\n110:                 this.resolveConnectionPromise = null; // Ensure it's only called once\n111:             }\n112:         } else if (data.type === 'session_resumed') {\n113:             console.log(`✅ Session resumed: ${data.payload.session_id}`);\n114:             liveInterviewUI.addMessage(\"Connection restored. Your session has been resumed.\", \"system-message\");\n115:             // Also resolve the promise on resume.\n116:             if (this.resolveConnectionPromise) {\n117:                 this.resolveConnectionPromise();\n118:                 this.resolveConnectionPromise = null;\n119:             }\n120:         }\n121:         \n122:         this.handleMessage(data);\n123:     }\n124: \n125:     handleReconnect() {\n126:         if (this.reconnect_attempts < this.max_reconnect_attempts) {\n127:             this.reconnect_attempts++;\n128:             const delay = Math.pow(2, this.reconnect_attempts) * 1000;\n129:             console.log(`Attempting to reconnect in ${delay / 1000}s... (Attempt ${this.reconnect_attempts})`);\n130:             liveInterviewUI.addMessage(`Connection lost. Reconnecting... (Attempt ${this.reconnect_attempts})`, \"system-error\", true);\n131:             \n132:             setTimeout(() => this.connect(), delay);\n133:         } else {\n134:             console.error(\"Max reconnect attempts reached.\");\n135:             liveInterviewUI.addMessage(\"Could not reconnect to the server. Please restart the interview.\", \"system-error\");\n136:         }\n137:     }\n138: \n139:     disconnect() {\n140:         this.is_intentionally_closing = true;\n141:         if (this.socket) {\n142:             this.socket.close();\n143:         }\n144:         this.session_id = null; // Clear session on intentional disconnect\n145:     }\n146: \n147:     // --- All original message handlers go here ---\n148:     handleMessage(data) {\n149:         switch (data.type) {\n150:             case 'api_key_status':\n151:                 this.handleApiKeyStatus(data.payload);\n152:           