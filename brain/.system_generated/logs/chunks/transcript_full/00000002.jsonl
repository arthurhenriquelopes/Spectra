{"step_index":213,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-08-20T23:22:20Z","content":"Created At: 2026-08-20T20:22:20-03:00\nCompleted At: 2026-08-20T20:22:21-03:00\nFile Path: `file:///c:/Users/Arthur%20Henrique/Documents/GitHub/Spectra/src/services/llm.py`\nTotal Lines: 532\nTotal Bytes: 25930\nShowing lines 1 to 532\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: import orjson\r\n2: import asyncio\r\n3: from typing import Dict, List, Optional, Tuple, Any\r\n4: from datetime import datetime\r\n5: from openai import AsyncOpenAI, APIStatusError\r\n6: from src.config.settings import settings\r\n7: from src.config.key_utils import usable_keys\r\n8: from src.prompts.interview import get_interview_answer_prompt, get_quick_response_prompt, get_brief_human_prompt\r\n9: from src.services.context import PersistentContextManager\r\n10: import threading\r\n11: \r\n12: # --- Enhanced LLMManager Class ---\r\n13: \r\n14: class LLMManager:\r\n15:     \"\"\"Enhanced LLM Manager with persistent context support and error recovery.\"\"\"\r\n16:     \r\n17:     def __init__(self, provider_name: str, base_url: str, api_key: str, model_name: str, request_params: Optional[Dict[str, Any]] = None, api_keys: Optional[List[str]] = None):\r\n18:         self.provider_name = provider_name\r\n19:         self.model_name = model_name\r\n20:         self.base_url = base_url\r\n21:         self.request_params = request_params or {}\r\n22:         self.context_manager = None  # Will be shared from MultiLLMManager\r\n23:         self.is_healthy = True\r\n24:         self.last_error = None\r\n25:         self.error_count = 0\r\n26:         self.last_success_time = datetime.now()\r\n27:         \r\n28:         # Key rotation support — drop blank/placeholder entries so a half-filled\r\n29:         # config (real \"apiKey\" + untouched \"apiKeys\" placeholders) still works.\r\n30:         self.api_keys = usable_keys(api_keys) or usable_keys([api_key]) or [\"\"]\r\n31:         if not self.api_keys[0]:\r\n32:             print(f\"⚠️ No usable API key for {provider_name} — set 'apiKey' or 'apiKeys' in ai_providers.json\")\r\n33:         self.api_key = self.api_keys[0]  # Current active key\r\n34:         self._key_index = 0\r\n35:         self._key_lock = threading.Lock()\r\n36:         self._request_count = 0\r\n37:         \r\n38:         try:\r\n39:             self.client = AsyncOpenAI(base_url=base_url, api_key=self.api_key)\r\n40:             print(f\"✅ LLMManager initialized for: {self.provider_name} - {self.model_name} ({len(self.api_keys)} keys available)\")\r\n41:         except Exception as e:\r\n42:             self.client = None\r\n43:             self.is_healthy = False\r\n44:             self.last_error = str(e)\r\n45:             print(f\"❌ CRITICAL: Failed to initialize LLMManager for {self.provider_name}: {e}\")\r\n46: \r\n47:     def _rotate_key(self):\r\n48:         \"\"\"Rotate to the next API key using round-robin.\"\"\"\r\n49:         if len(self.api_keys) <= 1:\r\n50:             return\r\n51:         with self._key_lock:\r\n52:             self._key_index = (self._key_index + 1) % len(self.api_keys)\r\n53:             self.api_key = self.api_keys[self._key_index]\r\n54:             self.client = AsyncOpenAI(base_url=self.base_url, api_key=self.api_key)\r\n55:             self._request_count += 1\r\n56:             print(f\"🔑 Key rotation [{self.provider_name}]: using key index {self._key_index}/{len(self.api_keys)}\")\r\n57: \r\n58:     def set_context_manager(self, context_manager: PersistentContextManager):\r\n59:         \"\"\"Set the shared context manager\"\"\"\r\n60:         self.context_manager = context_manager\r\n61: \r\n62:     async def health_check(self) -> bool:\r\n63:         \"\"\"Check if the provider is healthy and responsive\"\"\"\r\n64:         if not self.client:\r\n65:             return False\r\n66:             \r\n67:         try:\r\n68:             # Quick test call to verify connectivity\r\n69:             await asyncio.wait_for(self.client.models.list(), timeout=5.0)\r\n70:             self.is_healthy = True\r\n71:             self.error_count = 0\r\n72:             self.last_success_time = datetime.now()\r\n73:             return True\r\n74:         except asyncio.TimeoutError:\r\n75:             self.is_healthy = False\r\n76:             self.last_error = \"Connection timeout\"\r\n77:             self.error_count += 1\r\n78:             return False\r\n79:         except Exception as e:\r\n80:             self.is_healthy = False\r\n81:             self.last_error = str(e)\r\n82:             self.error_count += 1\r\n83:             return False\r\n84: \r\n85:     async def get_ai_answer(self, question: str, stream_callback=None) -> Tuple[str, Dict[str, Any]]:\r\n86:         \"\"\"Get AI answer with instant key rotation on any error — zero delay retries.\"\"\"\r\n87:         if not self.client:\r\n88:             return \"I'm sorry, the AI service is not available at this time.\", {\r\n89:                 \"error\": \"No client available\",\r\n90:                 \"provider\": self.provider_name,\r\n91:                 \"model\": self.model_name\r\n92:             }\r\n93:         \r\n94:         if not self.context_manager or not self.context_manager.ensure_context_available():\r\n95:             return \"I'm sorry, candidate context is not properly initialized.\", {\r\n96:                 \"error\": \"Context not available\",\r\n97:                 \"provider\": self.provider_name,\r\n98:                 \"model\": self.model_name\r\n99:             }\r\n100:         \r\n101:         # Add question to conversation history (once, before retry loop)\r\n102:         self.context_manager.add_conversation_exchange(question)\r\n103:         \r\n104:         # Generate prompt with persistent context.\r\n105:         # Check if \"brief-human\" focus area is selected for concise, humanized responses.\r\n106:         focus_areas = []\r\n107:         if self.context_manager and self.context_manager.persistent_context:\r\n108:             focus_areas = self.context_manager.persistent_context.get('focus_areas', [])\r\n109:         \r\n110:         if 'brief-human' in focus_areas:\r\n111:             prompt = get_brief_human_prompt(question, self.context_manager)\r\n112:         elif settings.GENERATE_FULL_ANSWERS:\r\n113:             prompt = get_interview_answer_prompt(question, self.context_manager)\r\n114:         else:\r\n115:             prompt = get_quick_response_prompt(question, self.context_manager)\r\n116:         \r\n117:         print(f\"🎯 Processing with {self.provider_name}-{self.model_name}: '{question[:100]}...'\")\r\n118:         \r\n119:         # Try all available keys — instant retry on any error\r\n120:         max_attempts = len(self.api_keys)\r\n121:         last_error = None\r\n122:         \r\n123:         for attempt in range(max_attempts):\r\n124:             try:\r\n125:                 # Rotate key for each attempt (first attempt uses current key)\r\n126:                 if attempt > 0:\r\n127:                     self._rotate_key()\r\n128:                     print(f\"🔄 Instant retry attempt {attempt+1}/{max_attempts} with next key for {self.provider_name}\")\r\n129:                 \r\n130:                 # Build API params\r\n131:                 api_params = {\r\n132:                     \"messages\": [{\"role\": \"user\", \"content\": prompt}],\r\n133:                     \"model\": self.model_name,\r\n134:                     \"temperature\": 0.3,\r\n135:                     \"top_p\": 0.85,\r\n136:                     \"max_tokens\": 8000\r\n137:                 }\r\n138: \r\n139:                 # Add provider-specific routing if available\r\n140:                 if self.request_params:\r\n141:                     if self.provider_name == \"OpenRouter\" and \"provider\" in self.request_params:\r\n142:                         api_params[\"extra_body\"] = self.request_params\r\n143:                     else:\r\n144:                         api_params.update(self.request_params)\r\n145: \r\n146:                 # Determine if streaming is requested\r\n147:                 use_streaming = stream_callback is not None\r\n148: \r\n149:                 if use_streaming:\r\n150:                     api_params[\"stream\"] = True\r\n151:                     full_answer = \"\"\r\n152:                     streaming_active = True\r\n153:                     try:\r\n154:                         async for chunk in await self.client.chat.completions.create(**api_params):\r\n155:                             if not streaming_active:\r\n156:                                 break\r\n157:                             \r\n158:                             if chunk.choices and chunk.choices[0].delta and chunk.choices[0].delta.content:\r\n159:                                 content_chunk = chunk.choices[0].delta.content\r\n160:                                 full_answer += content_chunk\r\n161:                                 if stream_callback:\r\n162:                                     try:\r\n163:                                         callback_result = await stream_callback(content_chunk, \"chunk\")\r\n164:                                         if callback_result is False:\r\n165:                                             streaming_active = False\r\n166:                                             break\r\n167:                                     except Exception as e:\r\n168:                                         streaming_active = False\r\n169:                                         break\r\n170:                         answer = full_answer.strip()\r\n171: \r\n172:                     except Exception as stream_err:\r\n173:                         print(f\"⚠️ Streaming failed for {self.provider_name} key #{self._key_index}: {stream_err}\")\r\n174:                         raise stream_err  # Let the outer retry loop handle it\r\n175:                 else:\r\n176:                     # Non-streaming API call\r\n177:                     chat_completion = await asyncio.wait_for(\r\n178:                         self.client.chat.completions.create(**api_params),\r\n179:                         timeout=30.0\r\n180:                     )\r\n181:                     answer = chat_completion.choices[0].message.content.strip()\r\n182:                 \r\n183:                 # Success! Add AI response and return\r\n184:                 self.context_manager.add_ai_response(answer, \"normal\")\r\n185:                 self.is_healthy = True\r\n186:                 self.error_count = 0\r\n187:                 self.last_success_time = datetime.now()\r\n188:                 \r\n189:                 return answer, {\r\n190:                     \"success\": True,\r\n191:                     \"provider\": self.provider_name,\r\n192:                     \"model\": self.model_name,\r\n193:                     \"key_rotated\": attempt > 0,\r\n194:                     \"attempt\": attempt + 1,\r\n195:                     \"response_time\": datetime.now().isoformat()\r\n196:                 }\r\n197:                 \r\n198:             except Exception as e:\r\n199:                 last_error = e\r\n200:                 err_str = str(e)[:100]\r\n201:                 print(f\"⚡ Key #{self._key_index} failed for {self.provider_name}: {err_str}\")\r\n202:                 # Continue to next key immediately — no delay\r\n203:                 continue\r\n204:         \r\n205:         # All keys exhausted\r\n206:         error_msg = f\"All {max_attempts} keys failed for {self.provider_name}. Last error: {str(last_error)[:100]}\"\r\n207:         self.is_healthy = False\r\n208:         self.last_error = str(last_error)\r\n209:         self.error_count += 1\r\n210:         print(f\"🚨 ALL KEYS EXHAUSTED: {self.provider_name}-{self.model_name}\")\r\n211:         \r\n212:         return error_msg, {\r\n213:             \"error\": \"all_keys_failed\",\r\n214:             \"attempts\": max_attempts,\r\n215:             \"provider\": self.provider_name,\r\n216:             \"model\": self.model_name\r\n217:         }\r\n218: \r\n219:     def process_candidate_response(self, response: str):\r\n220:         \"\"\"Processes the candidate's response to add to conversation context.\"\"\"\r\n221:         if settings.TRACK_CANDIDATE_RESPONSES and response.strip() and self.context_manager:\r\n222:             self.context_manager.add_conversation_exchange(None, response)\r\n223:             print(\"📝 Conversation context updated with candidate response\")\r\n224: \r\n225:     def get_status(self) -> Dict[str, Any]:\r\n226:         \"\"\"Get current status of this LLM manager\"\"\"\r\n227:         return {\r\n228:             \"provider\": self.provider_name,\r\n229:             \"model\": self.model_name,\r\n230:             \"is_healthy\": self.is_healthy,\r\n231:             \"error_count\": self.error_count,\r\n232:             \"last_error\": self.last_error,\r\n233:             \"last_success\": self.last_success_time.isoformat() if self.last_success_time else None\r\n234:         }\r\n235: \r\n236: # --- Multi-LLM Manager Class ---\r\n237: \r\n238: class MultiLLMManager:\r\n239:     \"\"\"Enhanced LLM Manager supporting multiple providers with shared context and comprehensive error handling\"\"\"\r\n240:     \r\n241:     def __init__(self):\r\n242:         self.providers: Dict[str, LLMManager] = {}\r\n243:         self.presets: Dict[str, Dict[str, str]] = {}\r\n244:         self.active_preset_key = \"primary\"\r\n245:         self.shared_context = PersistentContextManager()\r\n246:         self.fallback_order = [\"primary\", \"secondary\", \"auto\"]\r\n247:         self.auto_switch_enabled = True\r\n248:         self.health_check_interval = 300  # 5 minutes\r\n249:         self.last_health_check = None\r\n250:         \r\n251:     def load_configuration(self, primary_config: Dict[str, str], secondary_config: Optional[Dict[str, str]] = None):\r\n252:         \"\"\"Load primary and optional secondary configurations\"\"\"\r\n253:         try:\r\n254:             # Load providers from JSON using high-performance orjson\r\n255:             with open(\"ai_providers.json\", \"rb\") as f:\r\n256:                 providers_config = orjson.loads(f.read())\r\n257:             \r\n258:             # Setup primary provider\r\n259:             primary_provider_config = next((p for p in providers_config\r\n260:                                           if p[\"name\"] == primary_config[\"provider\"]), None)\r\n261:             \r\n262:             if not primary_provider_config:\r\n263:                 raise ValueError(f\"Primary provider '{primary_config['provider']}' not found in configuration\")\r\n264:             \r\n265:             # --- Primary Provider Setup ---\r\n266:             primary_model_config = self._get_model_config(primary_provider_config, primary_config[\"model\"])\r\n267:             \r\n268:             self.presets[\"primary\"] = {\r\n269:                 \"provider\": primary_config[\"provider\"],\r\n270:                 \"model\": primary_model_config[\"modelName\"],\r\n271:                 \"description\": primary_model_config.get(\"description\", f\"Primary - {primary_config['provider']} ({primary_model_config['modelName']})\"),\r\n272:                 \"priority\": 1\r\n273:             }\r\n274: \r\n275:             self.providers[\"primary\"] = LLMManager(\r\n276:                 provider_name=primary_provider_config[\"name\"],\r\n277:                 base_url=primary_provider_config[\"baseURL\"],\r\n278:                 api_key=primary_provider_config.get(\"apiKey\", \"\"),\r\n279:                 model_name=primary_model_config[\"modelName\"],\r\n280:              