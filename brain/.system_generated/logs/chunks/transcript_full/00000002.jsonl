{}\r\n299:         self._cleanup_task: Optional[asyncio.Task] = None\r\n300: \r\n301:     def create_session(self) -> InterviewSession:\r\n302:         \"\"\"Creates a new, unique interview session.\"\"\"\r\n303:         session_id = str(uuid.uuid4())\r\n304:         session = InterviewSession(session_id)\r\n305:         self.active_sessions[session_id] = session\r\n306:         print(f\"Created new session: {session_id} (total active: {len(self.active_sessions)})\")\r\n307:         return session\r\n308: \r\n309:     def get_session(self, session_id: str) -> Optional[InterviewSession]:\r\n310:         \"\"\"Retrieves an existing session by its ID.\"\"\"\r\n311:         session = self.active_sessions.get(session_id)\r\n312:         if session:\r\n313:             session._touch()\r\n314:         return session\r\n315: \r\n316:     def remove_session(self, session_id: str):\r\n317:         \"\"\"Removes a session and cleans up its resources.\"\"\"\r\n318:         if session_id in self.active_sessions:\r\n319:             del self.active_sessions[session_id]\r\n320:             print(f\"Removed session: {session_id} (remaining: {len(self.active_sessions)})\")\r\n321: \r\n322:     def start_cleanup_task(self):\r\n323:         \"\"\"Start the background cleanup task for stale sessions.\"\"\"\r\n324:         if self._cleanup_task is None or self._cleanup_task.done():\r\n325:             self._cleanup_task = asyncio.create_task(self._cleanup_loop())\r\n326:             print(\"🧹 Session cleanup task started (checks every 5 minutes)\")\r\n327: \r\n328:     async def _cleanup_loop(self):\r\n329:         \"\"\"Periodically clean up stale sessions.\"\"\"\r\n330:         while True:\r\n331:             await asyncio.sleep(300)  # Check every 5 minutes\r\n332:             await self._cleanup_stale_sessions()\r\n333: \r\n334:     async def _cleanup_stale_sessions(self):\r\n335:         \"\"\"Remove sessions that have been inactive and disconnected for too long.\"\"\"\r\n336:         now = time.time()\r\n337:         stale_ids = []\r\n338:         \r\n339:         for sid, session in self.active_sessions.items():\r\n340:             if session.websocket is None:\r\n341:                 idle_time = now - session.last_activity_time\r\n342:                 if idle_time > SESSION_TTL_SECONDS:\r\n343:                     stale_ids.append(sid)\r\n344:         \r\n345:         for sid in stale_ids:\r\n346:             session = self.active_sessions.get(sid)\r\n347:             if session:\r\n348:                 try:\r\n349:                     await session.cleanup()\r\n350:                 except Exception as e:\r\n351:                     print(f\"⚠️ Error cleaning up stale session {sid}: {e}\")\r\n352:                 del self.active_sessions[sid]\r\n353:                 print(f\"🧹 Cleaned up stale session: {sid} (remaining: {len(self.active_sessions)})\")\r\n354:         \r\n355:         if stale_ids:\r\n356:             print(f\"🧹 Cleaned up {len(stale_ids)} stale session(s)\")\r\n357: \r\n358: # Create a single, global instance of the SessionManager\r\n359: session_manager = SessionManager()\nThe above content shows the entire, complete file contents of the requested file.\n"}
