Not found'}\")\n33: \n34:     # --- Method 3: Try multiple search attempts with delay ---\n35:     if not hwnd:\n36:         print(\"⚠️ Trying multiple search attempts...\")\n37:         for attempt in ran\n<truncated 1551 bytes>\nvisible in screen recordings!\")\n71:         return False\n72: \n73: def verify_protection(hwnd) -> Optional[bool]:\n74:     \"\"\"Verify that capture protection is actually applied.\n75: \n76:     Returns True when the window's display affinity reads back as\n77:     WDA_EXCLUDEFROMCAPTURE, False when it reads back as something else, and\n78:     None when verification was not possible (API unavailable, call failed, or\n79:     an unexpected error). Diagnostic only - this never raises and the result\n80:     can safely be ignored.\n81:     \"\"\"\n82:     try:\n83:         print(f\"🔬 Verifying protection on window {hex(hwnd)}...\")\n84:         \n85:         if _HAS_GET_DISPLAY_AFFINITY:\n86:             affinity = wintypes.DWORD(0)\n87:             if _user32.GetWindowDisplayAffinity(hwnd, ctypes.byref(affinity)):\n88:                 if affinity.value == WDA_EXCLUDEFROMCAPTURE:\n89:                     print(f\"✅ CONFIRMED: display affinity is WDA_EXCLUDEFROMCAPTURE (0x{affinity.value:08X})\")\n90:                     return True\n91:                 print(f\"❌ MISMATCH: display affinity is 0x{affinity.value:08X}, expected 0x{WDA_EXCLUDEFROMCAPTURE:08X}\")\n92:                 print(\"   🚨 WARNING: Window may still be visible in screen recordings!\")\n93:                 return False\n94:             print(f\"⚠️ GetWindowDisplayAffinity failed (Error Code: {ctypes.GetLastError()}) - falling back to handle check\")\n95:         else:\n96:             print(\"⚠️ GetWindowDisplayAffinity unavailable on this system - falling back to handle check\")\n97: \n98:         is_window_valid = _user32.IsWindow(hwnd)\n99:         if is_window_valid:\n100:             print(\"✅ Window handle is valid - protection likely applied\")\n101:         else: