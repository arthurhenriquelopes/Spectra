tkeyManager.Initialize(hwnd);\n40:             RegisterGlobalHotkeys();\n41: \n42:             // Screen share monitoring\n43:             _screenShareMonitor.Start();\n44: \n45:             // Hook HwndSource to receive WM_HOTKEY messages\n46:             var source = HwndSource.FromHwnd(hwnd);\n47:             source.AddHook(WndProc);\n48: \n49:             // Connect SessionController events to UI\n50:             _sessionController.SendToUi += (type, payload) =>\n51:             {\n52:                 Dispatcher.Invoke(() =>\n53:                 {\n54:                     SendJsonToWeb(type, payload);\n55:                 });\n56:             };\n57: \n58:             // Initialize WebView2\n59:             await InitializeWebViewAsync();\n60:         }\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
