.DEV_MODE\r\n42:     }\r\n43: \r\n44: @router.get(\"/api/ai-providers\")\r\n45: async def get_ai_providers():\r\n46:     \"\"\"\r\n47:     Reads the ai_providers.json file and returns a list of providers\r\n48:     to the frontend, excluding sensitive API keys.\r\n49:     \"\"\"\r\n50:     try:\r\n51:         if not os.path.exists(\"ai_providers.json\"):\r\n52:             if os.path.exists(\"ai_providers.example.json\"):\r\n53:                 print(\"📝 ai_providers.json not found, creating from example...\")\r\n54:                 shutil.copy(\"ai_providers.example.json\", \"ai_providers.json\")\r\n55:             else:\r\n56:                 raise HTTPException(status_code=404, detail=\"ai_providers.json and example not found\")\r\n57: \r\n58:         async with aiofiles.open(\"ai_providers.json\", \"rb\") as f:\r\n59:             file_content = await f.read()\r\n60:             providers = orjson.loads(file_content)\r\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
