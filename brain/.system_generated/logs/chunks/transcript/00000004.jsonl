ont-size: 0.95rem;\n47: }\n48: \n49: /* Headings are the scan anchors used to find the right section in a\n50:    sub-second glance, so the old 0.9 / 0.85 / 0.8 ladder made the most\n51:    important landmarks the hardest to see. Hierarchy is carried by size,\n52:    weight and letter-spacing instead, none of which decay under transparency. */\n53: .markdown-h5,\n54: .markdown-h6 {\n55:     font-size: clamp(0.9rem, 2vw, 1.1rem);\n56:     font-weight: 600;\n57: }\n58: \n59: /* ==============================================\n60:    MARKDOWN LISTS - Clean Professional Bullets\n61:    ============================================== */\n62: \n63: .markdown-list {\n64:     margin: 1rem 0;\n65:     padding-left: 0;\n66:     list-style: none;\n67:     position: relative;\n68: }\n69: \n70: .markdown-bullet-list .markdown-list-item {\n71:     position: relative;\n72:     padding-left: 1.5rem;\n73:     margin-bottom: 0.5rem;\n74:     line-height: 1.6;\n75: }\n76: \n77: .markdown-bullet-list .markdown-list-item::before {\n78:     content: \"\";\n79:     position: absolute;\n80:     left: 0;\n81:     top: 0.7em;\n82:     width: 6px;\n83:     height: 6px;\n84:     background: var(--text-color);\n85:     border-radius: 0; /* Square bullets for professional look */\n86:     transform: translateY(-50%);\n87:     opacity: 0.7;\n88: }\n89: \n90: .markdown-numbered-list {\n91:     counter-reset: markdown-counter;\n92: }\n93: \n94: .markdown-numbered-list .markdown-list-item {\n95:     position: relative;\n96:     padding-left: 2rem;\n97:     margin-bottom: 0.5rem;\n98:     line-height: 1.6;\n99:     counter-increment: markdown-counter;\n100: }\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
