olls: 0,       // Count of consecutive up scrolls (indicates intent)\n28:             aiResponseStartElement: null,  // Reference to current AI response element\n29:             isLiveSpeaking: fals\n<truncated 3869 bytes>\n// Track scroll direction changes\n122:         if (direction !== this.scrollState.lastUserScrollDirection) {\n123:             this.scrollState.consecutiveUpScrolls = direction === 'up' ? 1 : 0;\n124:         } else if (direction === 'up') {\n125:             this.scrollState.consecutiveUpScrolls++;\n126:         }\n127:         \n128:         this.scrollState.lastUserScrollDirection = direction;\n129:         \n130:         // Determine if user is intentionally reading (scrolled up significantly)\n131:         const distanceFromBottom = maxScrollTop - currentPosition;\n132:         const wasInReadingMode = this.scrollState.userReadingMode;\n133:         \n134:         if (distanceFromBottom > this.scrollState.readingThreshold && this.scrollState.consecutiveUpScrolls >= 2) {\n135:             // User has scrolled up intentionally (multiple up scrolls + significant distance)\n136:             this.enterReadingMode();\n137:         } else if (this.scrollState.isNearBottom && this.scrollState.userReadingMode) {\n138:             // User has returned to bottom - exit reading mode\n139:             this.exitReadingMode();\n140:         }\n141:         \n142:     }\n143: \n144:     handleWheelEvent(e) {\n145:         // Additional intent detection: rapid up scrolls indicate reading intent\n146:         if (e.deltaY < 0) { // Scrolling up\n147:             this.scrollState.consecutiveUpScrolls++;\n148:         } else {\n149:             this.scrollState.consecutiveUpScrolls = 0;\n150:         }\n151:     }\n152: \n153:     enterReadingMode() {\n154:         if (!this.scrollState.userReadingMode) {\n155:             this.scrollState.userReadingMode = true;\n156:             this.scrollState.mode = 'user_reading';\n157:             console.log('📚 User re