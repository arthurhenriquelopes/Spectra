{"step_index":826,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-08-21T18:57:07Z","content":"Created At: 2026-08-21T15:57:07-03:00\nCompleted At: 2026-08-21T15:57:07-03:00\nFile Path: `file:///c:/Users/Arthur%20Henrique/Documents/GitHub/Spectra/web/js/config.js`\nTotal Lines: 70\nTotal Bytes: 1884\nShowing lines 1 to 70\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: // Configuration loader - fetches centralized config from backend\n2: let appConfig = {\n3:     DEV_MODE: false, // Default fallback\n4:     LOG_LEVEL: 'INFO'\n5: };\n6: \n7: // Fetch configuration from backend\n8: async function loadConfig() {\n9:     try {\n10:         const response = await fetch('/api/config');\n11:         if (response.ok) {\n12:             appConfig = await response.json();\n13:             console.log('📋 Configuration loaded:', appConfig);\n14:         } else {\n15:             console.warn('⚠️ Could not load config from backend, using defaults');\n16:         }\n17:     } catch (error) {\n18:         console.warn('⚠️ Config loading failed, using defaults:', error);\n19:     }\n20:     return appConfig;\n21: }\n22: \n23: // Utility functions for cleaner code\n24: export function isDev() {\n25:     return appConfig.DEV_MODE;\n26: }\n27: \n28: export function shouldLog(level = 'INFO') {\n29:     const levels = ['DEBUG', 'INFO', 'WARNING', 'ERROR'];\n30:     const currentLevel = levels.indexOf(appConfig.LOG_LEVEL);\n31:     const requestedLevel = levels.indexOf(level);\n32:     return requestedLevel >= currentLevel;\n33: }\n34: \n35: // Enhanced console logging that respects DEV_MODE\n36: export function devLog(...args) {\n37:     if (isDev()) {\n38:         console.log('[DEV]', ...args);\n39:     }\n40: }\n41: \n42: export function devWarn(...args) {\n43:     if (isDev()) {\n44:         console.warn('[DEV]', ...args);\n45:     }\n46: }\n47: \n48: export function devError(...args) {\n49:     if (isDev()) {\n50:         console.error('[DEV]', ...args);\n51:     }\n52: }\n53: \n54: // Initialize configuration and export it\n55: export { loadConfig, appConfig };\n56: export default appConfig;\n57: \n58: /**\n59:  * Call this AFTER loadConfig() to suppress noisy console output in production.\n60:  * console.warn and console.error are always preserved.\n61:  */\n62: export function applyConsoleGate() {\n63:     if (!isDev()) {\n64:         const noop = () => {};\n65:         console.log = noop;\n66:         console.debug = noop;\n67:         console.info = noop;\n68:         // console.warn and console.error are intentionally left active\n69:     }\n70: }\nThe above content shows the entire, complete file contents of the requested file.\n"}
