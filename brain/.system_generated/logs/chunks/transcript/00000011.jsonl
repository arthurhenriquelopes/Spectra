ager] Initialized\\n\");\n+\n+                _hotkeyManager.Initialize(hwnd);\n+                File.AppendAllText(LogPath, $\"[HotkeyManager] Initialized\\n\");\n+\n+                RegisterGlobalHotkeys();\n+                File.AppendAllText(LogPath, $\"[Hotkeys] Registered\\n\");\n+\n+                var source = HwndSource.FromHwnd(hwnd);\n+                if (source != null)\n+                {\n+                    source.AddHook(WndProc);\n+                    File.AppendAllText(LogPath, $\"[HwndSource] Hook added\\n\");\n+                }\n+\n+                _sessionController.SendToUi += (type, payload) =>\n+                {\n+                    Dispatcher.Invoke(() =>\n+                    {\n+                        SendJsonToWeb(type, payload);\n+                    });\n+                };\n+\n+                await InitializeWebViewAsync();\n+                File.AppendAllText(LogPath, $\"[MainWindow_Loaded] Complete!\\n\");\n+            }\n+            catch (Exception ex)\n+            {\n+                File.AppendAllText(LogPath, $\"[LOAD ERROR] {ex}\\n\");\n+            }\n         }\n \n         private async Task InitializeWebViewAsync()\n[diff_block_end]\n\nPlease note that the above snippet only shows the MODIFIED lines from the last change. It shows up to 3 lines of unchanged lines before and after the modified lines. The actual file contents may have many more lines not shown."}
