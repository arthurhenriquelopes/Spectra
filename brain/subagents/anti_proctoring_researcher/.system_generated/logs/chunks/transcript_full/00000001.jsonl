\"\"\"Updates the DEEPGRAM_API_KEY in the .env file.\"\"\"\r\n128:     try:\r\n129:         success = env_manager.update_key(\"DEEPGRAM_API_KEY\", request.key)\r\n130:         if success:\r\n131:             return {\"success\": True, \"message\": \"Deepgram API key saved successfully\"}\r\n132:         else:\r\n133:             raise HTTPException(status_code=500, detail=\"Failed to update .env file\")\r\n134:     except Exception as e:\r\n135:         raise HTTPException(status_code=500, detail=f\"Error saving Deepgram key: {e}\")\r\n136: \r\n137: @router.post(\"/api/verify-provider\")\r\n138: async def verify_ai_provider(request: ProviderVerifyRequest):\r\n139:     \"\"\"\r\n140:     Verifies a connection to the selected AI provider.\r\n141:     Tries all available apiKeys if the first one fails.\r\n142:     \"\"\"\r\n143:     try:\r\n144:         async with aiofiles.open(\"ai_providers.json\", \"rb\") as f:\r\n145:             file_content = await f.read()\r\n146:             providers = orjson.loads(file_content)\r\n147:         \r\n148:         provider_config = next((p for p in providers if p[\"name\"] == request.name), None)\r\n149: \r\n150:         if not provider_config:\r\n151:             raise HTTPException(status_code=404, detail=f\"Provider '{request.name}' not found.\")\r\n152: \r\n153:         # Get all usable keys (blank/placeholder entries filtered out)\r\n154:         api_keys = resolve_provider_keys(provider_config)\r\n155:         if not api_keys:\r\n156:             print(f\"⚠️ No usable API key configured for {request.name}\")\r\n157:             return {\"success\": False, \"error\": \"No API key configured for this provider.\"}\r\n158: \r\n159:         # Try each key until one works\r\n160:         for i, key in enumerate(api_keys):\r\n161:             is_valid = await verify_provider_connection(\r\n162:                 base_url=provider_config.get(\"baseURL\"),\r\n163:                 api_key=key,\r\n164:                 model_name=request.model\r\n165:             )\r\n166:             if is_valid:\r\n167:                 return {\"success\": True}\r\n168:             print(f\"⚠️ Key {i+1}/{len(api_keys)} failed for {request.name}, trying next...\")\r\n169:         \r\n170:         return {\"success\": False}\r\n171: \r\n172:     except Exception as e:\r\n173:         raise HTTPException(status_code=500, detail=f\"Failed to verify provider: {e}\")\r\n174: \r\n175: @router.post(\"/api/verify-vision-provider\")\r\n176: async def verify_vision_ai_provider(request: ProviderVerifyRequest):\r\n177:     \"\"\"\r\n178:     Verifies a connection to the selected vision AI provider.\r\n179:     Tries all available apiKeys if the first one fails.\r\n180:     \"\"\"\r\n181:     try:\r\n182:         async with aiofiles.open(\"ai_providers.json\", \"rb\") as f:\r\n183:             file_content = await f.read()\r\n184:             providers = orjson.loads(file_content)\r\n185:         \r\n186:         provider_config = next((p for p in providers if p[\"name\"] == request.name), None)\r\n187: \r\n188:         if not provider_config:\r\n189:             raise HTTPException(status_code=404, detail=f\"Provider '{request.name}' not found.\")\r\n190: \r\n191:         if not provider_config.get(\"supportsVision\", False):\r\n192:             raise HTTPException(status_code=400, detail=f\"Provider '{request.name}' does not support vision.\")\r\n193: \r\n194:         # Check if model exists in visionModels and extract model config (handle both string and object formats)\r\n195:         vision_models = provider_config.get(\"visionModels\", [])\r\n196:         model_config = None\r\n197:         \r\n198:         for vision_model in vision_models:\r\n199:             if isinstance(vision_model, str) and vision_model == request.model:\r\n200:                 model_config = {\"modelName\": vision_model}  # Normalize to dict\r\n201:                 break\r\n202:             elif isinstance(vision_model, dict) and vision_model.get(\"modelName\") == request.model:\r\n203:                 model_config = vision_model\r\n204:                 break\r\n205:         \r\n206:         if not model_config:\r\n207:             raise HTTPException(status_code=400, detail=f\"Model '{request.model}' is not a vision model for '{request.name}'.\")\r\n208: \r\n209:         # Get all usable keys (blank/placeholder entries filtered out)\r\n210:         api_keys = resolve_provider_keys(provider_config)\r\n211:         if not api_keys:\r\n212:             print(f\"⚠️ No usable vision API key configured for {request.name}\")\r\n213:             return {\"success\": False, \"error\": \"No API key configured for this provider.\"}\r\n214: \r\n215:         # Try each key until one works\r\n216:         for i, key in enumerate(api_keys):\r\n217:             is_valid = await verify_vision_provider_connection(\r\n218:                 base_url=provider_config.get(\"baseURL\"),\r\n219:                 api_key=key,\r\n220:                 model_name=request.model,\r\n221:                 request_params=model_config.get(\"requestParams\")\r\n222:             )\r\n223:             if is_valid:\r\n224:                 return {\"success\": True}\r\n225:             print(f\"⚠️ Vision key {i+1}/{len(api_keys)} failed for {request.name}, trying next...\")\r\n226:         \r\n227:         return {\"success\": False}\r\n228: \r\n229:     except Exception as e:\r\n230:         raise HTTPException(status_code=500, detail=f\"Failed to verify vision provider: {e}\")\r\n231: \r\n232: @router.get(\"/api/transparency\")\r\n233: async def get_transparency():\r\n234:     \"\"\"Get current window transparency information\"\"\"\r\n235:     return window_manager.get_transparency_info()\r\n236: \r\n237: @router.post(\"/api/transparency\")\r\n238: async def set_transparency(request: TransparencyRequest):\r\n239:     \"\"\"Set window transparency (0.0 = transparent, 1.0 = opaque)\"\"\"\r\n240:     success = window_manager.set_app_transparency(re