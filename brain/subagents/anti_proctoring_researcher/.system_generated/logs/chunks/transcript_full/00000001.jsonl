DEV_MODE\r\n42:     }\r\n43: \r\n44: @router.get(\"/api/ai-providers\")\r\n45: async def get_ai_providers():\r\n46:     \"\"\"\r\n47:     Reads the ai_providers.json file and returns a list of providers\r\n48:     to the frontend, excluding sensitive API keys.\r\n49:     \"\"\"\r\n50:     try:\r\n51:         if not os.path.exists(\"ai_providers.json\"):\r\n52:             if os.path.exists(\"ai_providers.example.json\"):\r\n53:                 print(\"📝 ai_providers.json not found, creating from example...\")\r\n54:                 shutil.copy(\"ai_providers.example.json\", \"ai_providers.json\")\r\n55:             else:\r\n56:                 raise HTTPException(status_code=404, detail=\"ai_providers.json and example not found\")\r\n57: \r\n58:         async with aiofiles.open(\"ai_providers.json\", \"rb\") as f:\r\n59:             file_content = await f.read()\r\n60:             providers = orjson.loads(file_content)\r\n61:         \r\n62:         # Sanitize the data before sending to the client\r\n63:         client_safe_providers = [\r\n64:             {\r\n65:                 \"name\": p.get(\"name\"),\r\n66:                 \"models\": p.get(\"models\", []),\r\n67:                 \"visionModels\": p.get(\"visionModels\", []),\r\n68:                 \"supportsVision\": p.get(\"supportsVision\", False),\r\n69:                 # Images this provider accepts in a single request. The\r\n70:                 # screenshot queue caps itself to this so a batch is never\r\n71:                 # assembled that the selected vision model will reject.\r\n72:                 \"maxImages\": p.get(\"maxImages\"),\r\n73:                 \"defaultPrimary\": p.get(\"defaultPrimary\", False),\r\n74:                 \"defaultSecondary\": p.get(\"defaultSecondary\", False),\r\n75:                 \"defaultVisionPrimary\": p.get(\"defaultVisionPrimary\", False),\r\n76:                 \"defaultVisionSecondary\": p.get(\"defaultVisionSecondary\", False),\r\n77:                 \"defaultModel\": p.get(\"defaultModel\"),\r\n78:                 \"defaultVisionModel\": p.get(\"defaultVisionModel\"),\r\n79:                 # Keep legacy default for backward compatibility\r\n80:                 \"default\": p.get(\"defaultPrimary\", False)\r\n81:             }\r\n82:             for p in providers\r\n83:         ]\r\n84:         return client_safe_providers\r\n85:     except FileNotFoundError:\r\n86:         raise HTTPException(status_code=404, detail=\"ai_providers.json not found\")\r\n87:     except Exception as e:\r\n88:         raise HTTPException(status_code=500, detail=f\"Error reading provider config: {e}\")\r\n89: \r\n90: @router.get(\"/api/ai-providers/full\")\r\n91: async def get_ai_providers_full():\r\n92:     \"\"\"\r\n93:     Returns the full ai_providers.json INCLUDING API keys.\r\n94:     Used for the advanced configuration UI.\r\n95:     \"\"\"\r\n96:     try:\r\n97:         if not os.path.exists(\"ai_providers.json\"):\r\n98:              if os.path.exists(\"ai_providers.example.json\"):\r\n99:                 shutil.copy(\"ai_providers.example.json\", \"ai_providers.json\")\r\n100:              else:\r\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
