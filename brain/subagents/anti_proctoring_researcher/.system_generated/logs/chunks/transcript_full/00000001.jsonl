     if (self.last_processed_command and \n112:             self.last_processed_command['id'] == command_id and \n113:             current_time - self.last_processed_command['time'] < self.command_cooldown):\n114:             print(f\"🎮 Ignoring duplicate command within cooldown: {command}\")\n115:             return False\n116:         \n117:         # Update last processed command\n118:         self.last_processed_command = {\n119:             'id': command_id,\n120:             'time': current_time,\n121:             'command': command\n122:         }\n123:             \n124:         print(f\"🎮 Processing global command: {command}\")\n125:         \n126:         # Execute the command by sending it to the browser\n127:         try:\n128:             if command == 'toggle_vision_mode':\n129:                 self._execute_browser_command('if (window.toggleVisionMode) { window.toggleVisionMode(); } else { console.warn(\"toggleVisionMode not available\"); }')\n130:             elif command == 'capture_screenshot':\n131:                 self._execute_browser_command('if (window.captureScreenshot) { window.captureScreenshot(); } else { console.warn(\"captureScreenshot not available\"); }')\n132:             elif command == 'process_screenshots':\n133:                 self._execute_browser_command('if (window.processScreenshots) { window.processScreenshots(); } else { console.warn(\"processScreenshots not available\"); }')\n134:             elif command == 'reset_screenshot_queue':\n135:                 self._execute_browser_command('if (window.resetScreenshotQueue) { window.resetScreenshotQueue(); } else { console.warn(\"resetScreenshotQueue not available\"); }')\n136:             elif command == 'switch_preset':\n137:                 preset_key = command_data.get('preset_key', 'primary')\n138:                 self._execute_browser_command(f'if (window.switchPreset) {{ window.switchPreset(\"{preset_key}\"); }} else {{ console.warn(\"switchPreset not available\"); }}')\n139:             elif command == 'set_transparency':\n140:                 transparency_level = command_data.get('level', 'opaque')\n141:                 self._execute_browser_command(f'if (window.setTransparency) {{ window.setTransparency(\"{transparency_level}\"); }} else {{ console.warn(\"setTransparency not available\"); }}')\n142:             elif command == 'toggle_mic_mute':\n143:                 self._execute_browser_command('if (window.toggleMicMute) { window.toggleMicMute(); } else { console.warn(\"toggleMicMute not available\"); }')\n144:             elif command == 'toggle_universal_mute':\n145:                 self._execute_browser_command('if (window.toggleUniversalMute) { window.toggleUniversalMute(); } else { console.warn(\"toggleUniversalMute not available\"); }')\n146:             elif command == 'switch_vision_model':\n147:                 self._execute_browser_command('if (window.switchVisionModel) { window.switchVisionModel(); } else { console.warn(\"switchVisionModel not available\"); }')\n148:             elif command == 'reset_interview':\n149:                 self._execute_browser_command('if (window.resetInterview) { window.resetInterview(); } else { console.warn(\"resetInterview not available\"); }')\n150:             elif command == 'scroll':\n151:                 direction = command_data.get('direction', 'down')\n152:                 amount = command_data.get('amount', 150)\n153:                 # Use smooth scrolling with the specified amount\n154:                 if direction == 'up':\n155:                     scroll_amount = -amount\n156:                 else:\n157:                     scroll_amount = amount\n158:                 js_code = f'document.getElementById(\"conversation-stream\").scrollBy({{ top: {scroll_amount}, left: 0, behavior: \"smooth\" }})'\n159:                 self._execute_browser_command(js_code)\n160:             elif command == 'context_aware_action':\n161:                 action = command_data.get('action', '')