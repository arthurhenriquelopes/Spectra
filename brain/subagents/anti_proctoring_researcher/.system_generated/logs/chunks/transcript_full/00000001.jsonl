int(f\"⚠️ Could not clear old command file: {e}\")\n37:         \n38:         self.running = True\n39:         self._monitor_task = asyncio.create_task(self._async_monitor_loop())\n40:         print(\"🎮 Global command monitor started\")\n41:         \n42:     async def stop_monitoring(self):\n43:         \"\"\"Stop the command monitoring\"\"\"\n44:         self.running = False\n45:         if self._monitor_task and not self._monitor_task.done():\n46:             self._monitor_task.cancel()\n47:             try:\n48:                 await self._monitor_task\n49:             except asyncio.CancelledError:\n50:                 pass\n51:         print(\"🎮 Global command monitor stopped\")\n52:     \n53:     async def _async_monitor_loop(self):\n54:         \"\"\"Async monitoring loop that checks for commands with improved performance\"\"\"\n55:         while self.running:\n56:             try:\n57:                 if os.path.exists(self.command_file):\n58:                     # Check file modification time\n59:                     file_mtime = os.path.getmtime(self.command_file)\n60:                     \n61:                     if file_mtime > self.last_command_time:\n62:                         self.last_command_time = file_mtime\n63:                         \n64:                         # Read and process the command using async file I/O\n65:                         try:\n66:                             async with aiofiles.open(self.command_file, 'rb') as f:\n67:                                 file_content = await f.read()\n68:                                 command_data = orjson.loads(file_content)\n69:                             \n70:                             # Process the command\n71:                             if self._process_command(command_data):\n72:                                 # Clean up the command file after successful processing\n73:                                 try:\n74:                                     os.remove(self.command_file)\n75: 