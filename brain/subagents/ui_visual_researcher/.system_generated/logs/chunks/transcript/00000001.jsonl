 mute state changed to: ${isMuted}`);\n38:         this.emit('microphoneMuteChange', this._isMicrophoneMuted);\n39:         this.emit('stateChange', this.getMuteStatus());\n40:     }\n41: \n42:     toggle\n<truncated 792 bytes>\n            });\n60:         }\n61:     }\n62: \n63:     toggleUniversalMute() {\n64:         this.setUniversalMute(!this._isUniversallyMuted);\n65:         return this._isUniversallyMuted;\n66:     }\n67: \n68:     // --- State Getters ---\n69:     isMicrophoneMuted() {\n70:         return this._isMicrophoneMuted;\n71:     }\n72: \n73:     isUniversallyMuted() {\n74:         return this._isUniversallyMuted;\n75:     }\n76: \n77:     // Returns true if ANY form of mute is active that would stop audio processing.\n78:     isAudioPaused() {\n79:         return this.isUniversallyMuted();\n80:     }\n81: \n82:     getMuteStatus() {\n83:         return {\n84:             microphone: this.isMicrophoneMuted(),\n85:             universal: this.isUniversallyMuted(),\n86:             isAudioPaused: this.isAudioPaused(),\n87:             description: this.getCurrentStateDescription()\n88:         };\n89:     }\n90: \n91:     getCurrentStateDescription() {\n92:         if (this.isUniversallyMuted()) {\n93:             return 'System Paused: All audio processing is stopped.';\n94:         }\n95:         if (this.isMicrophoneMuted()) {\n96:             return 'Microphone Muted: Only interviewer speech is being processed.';\n97:         }\n98:         return 'Active: All speakers are being processed.';\n99:     }\n100: }\n101: \n102: // Create a singleton instance\n103: const muteManager = new MuteManager();\n104: \n105: // --- Global Functions for Console and Module Access ---\n106: window.muteManager = muteManager;\n107: window.toggleUniversalMute = () => muteManager.toggleUniversalMute();\n108: window.enableUniversalMute = () => muteManager.setUniversalMute(true);\n109: window.disableUniversalMute = () => muteManager.setUniversalMute(false);\n110: window.getMuteStatus = () => muteManager.getMuteStatus();\n111: window.pauseInterview = window.enableUniversalMute; // Alias\n112: window.resumeInterview = window.disableUniversalMute; // Alias\n113: \n114: // For modules\n115: export default muteManager;\nThe above content shows the entire, complete file contents of the requested file.\n","truncated_fields":["content"]}
