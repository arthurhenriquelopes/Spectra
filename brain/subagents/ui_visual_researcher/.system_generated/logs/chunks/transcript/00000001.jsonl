\n34:             const option = document.createElement('option');\n35:             option.value = device.deviceId;\n36:             option.textContent = device.label || `Microphone ${micSelect.options.le\n<truncated 7002 bytes>\n() {\n190:     return muteManager.isMicrophoneMuted();\n191: }\n192: \n193: /**\n194:  * @deprecated Use muteManager.toggleMicrophoneMute() instead.\n195:  */\n196: export function toggleMicrophoneMute() {\n197:     return muteManager.toggleMicrophoneMute();\n198: }\n199: \n200: /**\n201:  * @deprecated Use muteManager.getMuteStatus() instead.\n202:  */\n203: export function getAudioProcessingMode() {\n204:     return muteManager.getMuteStatus();\n205: }\n206: \n207: /**\n208:  * Gets the screen video track for screenshot capture.\n209:  * @returns {MediaStreamTrack|null} The screen video track if available.\n210:  */\n211: export function getScreenVideoTrack() {\n212:     return screenVideoTrack;\n213: }\n214: \n215: /**\n216:  * Checks if screen sharing is available for screenshots.\n217:  * @returns {boolean} True if screen video track is available and active.\n218:  */\n219: export function isScreenSharingAvailable() {\n220:     return screenVideoTrack && screenVideoTrack.readyState === 'live';\n221: }\n222: \n223: /**\n224:  * Stops all audio streams and closes the AudioContext.\n225:  */\n226: export function stopAudioProcessing() {\n227:     console.log(\"Stopping audio processing.\");\n228:     if (micStream) {\n229:         micStream.getTracks().forEach(track => track.stop());\n230:         micStream = null;\n231:     }\n232:     if (systemStream) {\n233:         systemStream.getTracks().forEach(track => track.stop());\n234:         systemStream = null;\n235:     }\n236:     if (screenVideoTrack) {\n237:         screenVideoTrack.stop();\n238:         screenVideoTrack = null;\n239:         console.log(\"📹 Screen video track stopped\");\n240:     }\n241:     if (audioContext && audioContext.state !== 'closed') {\n242:         audioCo