{"step_index":63,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-08-21T21:53:03Z","content":"Created At: 2026-08-21T18:53:03-03:00\nCompleted At: 2026-08-21T18:53:03-03:00\nFile Path: `file:///c:/Users/Arthur%20Henrique/Documents/GitHub/Spectra/web/js/audio_handler.js`\nTotal Lines: 250\nTotal Bytes: 9398\nShowing lines 1 to 250\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: // --- audio_handler.js ---\n2: // This module handles all interactions with the Web Media APIs\n3: // for capturing and processing audio via an AudioWorklet.\n4: \n5: import { devLog, devError } from './config.js';\n6: import muteManager from './mute-manager.js';\n7: \n8: // Must match sample_rate in the Deepgram LiveOptions in services/stt_service.py.\n9: const TARGET_SAMPLE_RATE = 48000;\n10: \n11: let audioContext = null;\n12: let micStream = null;\n13: let systemStream = null;\n14: let micGainNode = null;\n15: let screenVideoTrack = null; // Store video track for screenshot reuse\n16: \n17: /**\n18:  * Requests permission to use the microphone and populates the dropdown.\n19:  * @returns {Promise<boolean>} True if permission was granted, false otherwise.\n20:  */\n21: export async function setupMicrophone() {\n22:     const micSelect = document.getElementById('mic-select');\n23:     try {\n24:         const stream = await navigator.mediaDevices.getUserMedia({ audio: true, video: false });\n25:         stream.getTracks().forEach(track => track.stop());\n26: \n27:         const devices = await navigator.mediaDevices.enumerateDevices();\n28:         const audioDevices = devices.filter(device => device.kind === 'audioinput');\n29: \n30:         if (audioDevices.length === 0) return false;\n31: \n32:         micSelect.innerHTML = '';\n33:         audioDevices.forEach(device => {\n34:             const option = document.createElement('option');\n35:             option.value = device.deviceId;\n36:             option.textContent = device.label || `Microphone ${micSelect.options.length + 1}`;\n37:             micSelect.appendChild(option);\n38:         });\n39:         \n40:         micSelect.disabled = false;\n41:         return true;\n42:     } catch (err) {\n43:         devError(\"Error setting up microphone:\", err);\n44:         return false;\n45:     }\n46: }\n47: \n48: /**\n49:  * Starts audio processing by setting up the AudioContext, loading the worklet,\n50:  * and connecting the audio streams.\n51:  * @param {string} micId - The deviceId of the selected microphone.\n52:  * @param {function} onAudioData - Callback function to handle the processed PCM audio data.\n53:  * @returns {Promise<boolean>} True if processing started successfully.\n54:  */\n55: export async function startAudioProcessing(micId, onAudioData) {\n56:     try {\n57:         // 1. Get Audio Streams\n58:         micStream = await navigator.mediaDevices.getUserMedia({ audio: { deviceId: { exact: micId } } });\n59:         systemStream = await navigator.mediaDevices.getDisplayMedia({ video: true, audio: true });\n60: \n61:         if (!micStream || !systemStream) {\n62:             console.error(\"Could not get both audio streams.\");\n63:             stopAudioProcessing();\n64:             return false;\n65:         }\n66: \n67:         // 2. Setup AudioContext and Worklet\n68:         // Pin the rate so it matches what Deepgram is told to expect. Left to\n69:         // itself the context adopts the hardware rate, and a 44.1kHz device\n70:         // then streams audio that Deepgram decodes as 48kHz (~9% fast), which\n71:         // degrades transcription in a way that looks like a Deepgram fault\n72:         // rather than a configuration mismatch.\n73:         const AudioCtx = window.AudioContext || window.webkitAudioContext;\n74:         try {\n75:             audioContext = new AudioCtx({ sampleRate: TARGET_SAMPLE_RATE });\n76:         } catch (rateErr) {\n77:             // The spec requires 8000-96000 to be supported, so this is close to\n78:             // unreachable; fall back rather than failing the whole session.\n79:             console.warn('⚠️ Could not pin AudioContext sample rate:', rateErr);\n80:             audioContext = new AudioCtx();\n81:         }\n82:         console.log(`🎵 AudioContext: ${audioContext.sampleRate}Hz`); // Keep this as it's important for debugging\n83:         if (audioContext.sampleRate !== TARGET_SAMPLE_RATE) {\n84:             console.warn(`⚠️ AudioContext is ${audioContext.sampleRate}Hz but Deepgram expects ${TARGET_SAMPLE_RATE}Hz - transcription accuracy may suffer`);\n85:         }\n86:         try {\n87:             await audioContext.audioWorklet.addModule('js/audio_processor.js');\n88:         } catch (e) {\n89:             await audioContext.audioWorklet.addModule('/js/audio_processor.js');\n90:         }\n91:         \n92:         // 3. Create a single mixed processor for better diarization\n93:         const mixedProcessor = new AudioWorkletNode(audioContext, 'mixed-processor');\n94: \n95:         // Handle mixed audio with mute-aware speaker detection\n96:         let audioProcessingCounter = 0; // For throttled logging\n97:         \n98:         mixedProcessor.port.onmessage = (event) => {\n99:             // If universally muted, drop all audio data immediately.\n100:             if (muteManager.isAudioPaused()) {\n101:                 if (audioProcessingCounter % 200 === 0) { // Log occasionally to show it's paused\n102:                     devLog(`⏸️ Audio processing paused due to universal mute.`);\n103:                 }\n104:                 audioProcessingCounter++;\n105:                 return;\n106:             }\n107: \n108:             const { audioData, micLevel, systemLevel } = event.data;\n109:             let speakerHint;\n110: \n111:             if (muteManager.isMicrophoneMuted()) {\n112:                 // When microphone is muted, all audio is from the interviewer.\n113:                 speakerHint = 'system';\n114:                 // Logging removed to reduce console noise.\n115:             } else {\n116:                 // When unmuted, distinguish based on volume.\n117:                 speakerHint = systemLevel > micLevel * 2 ? 'system' : 'microphone';\n118:             }\n119: \n120:             audioProcessingCounter++;\n121:             onAudioData(audioData, speakerHint);\n122:         };\n123: \n124:         // 4. Connect both sources to the mixed processor with mute control\n125:         const micSource = audioContext.createMediaStreamSource(micStream);\n126:         const systemSource = audioContext.createMediaStreamSource(systemStream);\n127:         \n128:         // Create gain node for microphone muting\n129:         micGainNode = audioContext.createGain();\n130:         updateMicGainNode(); // Set initial gain based on mute manager state\n131:         \n132:         // Listen for future changes\n133:         muteManager.on('microphoneMuteChange', updateMicGainNode);\n134:         \n135:         // Connect mic through gain node for mute control\n136:         micSource.connect(micGainNode);\n137:         micGainNode.connect(mixedProcessor);\n138:         \n139:         // System audio connects directly (we don't want to mute interviewer)\n140:         systemSource.connect(mixedProcessor);\n141: \n142:         // Store the video track for screenshot reuse, but remove it from the stream\n143:         const videoTracks = systemStream.getVideoTracks();\n144:         if (videoTracks.length > 0) {\n145:             screenVideoTrack = videoTracks[0];\n146:             console.log(\"📹 Screen video track stored for screenshot reuse\");\n147:         } else {\n148:             console.warn(\"⚠️ No video track found in display media stream\");\n149:         }\n150: \n151:         devLog(\"✅ Audio processing started successfully\");\n152:         return true;\n153: \n154:     } catch (err) {\n155:         console.error(\"❌ Error starting audio processing:\", err);\n156:         stopAudioProcessing();\n157:         return false;\n158:     }\n159: }\n160: \n161: /**\n162:  * Updates the microphone gain node based on the central mute manager state.\n163:  */\n164: function updateMicGainNode() {\n165:     if (!micGainNode || !audioContext) return;\n166:     \n167:     const isMuted = muteManager.isMicrophoneMuted();\n168:     const targetGain = isMuted ? 0 : 1;\n169:     \n170:     // Smooth transition to avoid audio pops\n171:     micGainNode.gain.setTargetAtTime(targetGain, audioContext.currentTime, 0.05);\n172:     devLog(`🎤 Microphone gain set to ${targetGain} based on mute manager.`);\n173: }\n174: \n175: // --- Legacy Functions (now wrappers for MuteManager) ---\n176: // These are kept for backward compatibility with other modules that might call them.\n177: \n178: /**\n179:  * @deprecated Use muteManager.setMicrophoneMute(mute) instead.\n180:  */\n181: export function setMicrophoneMute(mute) {\n182:     muteManager.setMicrophoneMute(mute);\n183:     return muteManager.isMicrophoneMuted();\n184: }\n185: \n186: /**\n187:  * @deprecated Use muteManager.isMicrophoneMuted() instead.\n188:  */\n189: export function isMicrophoneMuted() {\n190:     return muteManager.isMicrophoneMuted();\n191: }\n192: \n193: /**\n194:  * @deprecated Use muteManager.toggleMicrophoneMute() instead.\n195:  */\n196: export function toggleMicrophoneMute() {\n197:     return muteManager.toggleMicrophoneMute();\n198: }\n199: \n200: /**\n201:  * @deprecated Use muteManager.getMuteStatus() instead.\n202:  */\n203: export function getAudioProcessingMode() {\n204:     return muteManager.getMuteStatus();\n205: }\n206: \n207: /**\n208:  * Gets the screen video track for screenshot capture.\n209:  * @returns {MediaStreamTrack|null} The screen video track if available.\n210:  */\n211: export function getScreenVideoTrack() {\n212:     return screenVideoTrack;\n213: }\n214: \n215: /**\n216:  * Checks if screen sharing is available for screenshots.\n217:  * @returns {boolean} True if screen video track is available and active.\n218:  */\n219: export function isScreenSharingAvailable() {\n220:     return screenVideoTrack && screenVideoTrack.readyState === 'live';\n221: }\n222: \n223: /**\n224:  * Stops all audio streams and closes the AudioContext.\n225:  */\n226: export function stopAudioProcessing() {\n227:     console.log(\"Stopping audio processing.\");\n228:     if (micStream) {\n229:         micStream.getTracks().forEach(track => track.stop());\n230:         micStream = null;\n231:     }\n232:     if (systemStream) {\n233:         systemStream.getTracks().forEach(track => track.stop());\n234:         systemStream = null;\n235:     }\n236:     if (screenVideoTrack) {\n237:         screenVideoTrack.stop();\n238:         screenVideoTrack = null;\n239:         console.log(\"📹 Screen video track stopped\");\n240:     }\n241:     if (audioContext && audioContext.state !== 'closed') {\n242:         audioContext.close();\n243:         audioContext = null;\n244:     }\n245:     \n246:     // Reset mute state in the central manager\n247:     muteManager.setMicrophoneMute(true);\n248:     muteManager.setUniversalMute(false);\n249:     micGainNode = null;\n250: }\nThe above content shows the entire, complete file contents of the requested file.\n"}
