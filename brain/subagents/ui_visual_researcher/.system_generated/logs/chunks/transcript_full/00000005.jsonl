n;\n406: window.closeAllTestWindows = closeAllTestWindows;\n407: window.closeTestWindow = closeTestWindow;\n408: \n409: // Auto-test on load if in dev mode\n410: if (window.isDev) {\n411:     document.addEventListener('DOMContentLoaded', () => {\n412:         setTimeout(() => {\n413:             console.log('🧪 Auto-starting markdown test in dev mode...');\n414:             // Uncomment to auto-test: testSampleMarkdown();\n415:         }, 2000);\n416:     });\n417: } \nThe above content shows the entire, complete file contents of the requested file.\n"}
