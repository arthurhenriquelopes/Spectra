{"step_index":65,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-08-21T21:53:07Z","content":"Created At: 2026-08-21T18:53:07-03:00\nCompleted At: 2026-08-21T18:53:07-03:00\nFile Path: `file:///c:/Users/Arthur%20Henrique/Documents/GitHub/Spectra/web/js/audio_processor.js`\nTotal Lines: 89\nTotal Bytes: 3428\nShowing lines 1 to 89\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: // --- web/js/audio_processor.js ---\n2: \n3: // Number of samples accumulated before a message is posted.\n4: // 1024 = 8 render quanta (8 * 128) = ~21.3 ms @ 48 kHz.\n5: // Chosen as an exact multiple of the 128-sample render quantum so a batch\n6: // boundary can never fall inside a quantum. Drops the postMessage/WebSocket\n7: // message rate from ~375/s to ~47/s (8x).\n8: const BATCH_SAMPLES = 1024;\n9: \n10: /**\n11:  * Mixed audio processor that combines microphone and system audio\n12:  * while tracking volume levels for speaker detection.\n13:  */\n14: class MixedProcessor extends AudioWorkletProcessor {\n15:     constructor() {\n16:         super();\n17:         this.micInputIndex = 0;\n18:         this.systemInputIndex = 1;\n19: \n20:         // Batching state: PCM accumulates here and is posted once full.\n21:         this.batch = new Int16Array(BATCH_SAMPLES);\n22:         this.batchFill = 0;\n23:         this.micLevelSum = 0;\n24:         this.systemLevelSum = 0;\n25:     }\n26: \n27:     process(inputs, outputs, parameters) {\n28:         // We expect two inputs: [0] = microphone, [1] = system audio\n29:         const micInput = inputs[0] && inputs[0][0] ? inputs[0][0] : new Float32Array(128);\n30:         const systemInput = inputs[1] && inputs[1][0] ? inputs[1][0] : new Float32Array(128);\n31:         \n32:         const frameLength = Math.max(micInput.length, systemInput.length);\n33:         if (frameLength === 0) return true;\n34: \n35:         for (let i = 0; i < frameLength; i++) {\n36:             const micSample = i < micInput.length ? micInput[i] : 0;\n37:             const systemSample = i < systemInput.length ? systemInput[i] : 0;\n38: \n39:             // Mix the audio (simple addition with slight attenuation).\n40:             // Math.fround reproduces the float32 rounding the old code got for\n41:             // free by staging the mix in a Float32Array, so the PCM bytes on the\n42:             // wire are bit-identical to before.\n43:             const mixed = Math.fround((micSample + systemSample) * 0.7);\n44: \n45:             // Convert to 16-bit PCM directly into the batch buffer\n46:             const s = Math.max(-1, Math.min(1, mixed));\n47:             this.batch[this.batchFill++] = s < 0 ? s * 0x8000 : s * 0x7FFF;\n48: \n49:             // Track volume levels across the whole batch\n50:             this.micLevelSum += Math.abs(micSample);\n51:             this.systemLevelSum += Math.abs(systemSample);\n52: \n53:             if (this.batchFill === BATCH_SAMPLES) {\n54:                 this.flushBatch();\n55:             }\n56:         }\n57: \n58:         return true;\n59:     }\n60: \n61:     /**\n62:      * Posts the accumulated batch with batch-averaged volume levels.\n63:      * The batch buffer is replaced BEFORE postMessage transfers (detaches) it,\n64:      * so the detached ArrayBuffer is never read or written again.\n65:      */\n66:     flushBatch() {\n67:         const pcmData = this.batch;\n68:         const sampleCount = this.batchFill;\n69: \n70:         // Average the volume levels over the batch (equivalent to the mean of\n71:         // the per-render-quantum averages the old code produced).\n72:         const micLevel = this.micLevelSum / sampleCount;\n73:         const systemLevel = this.systemLevelSum / sampleCount;\n74: \n75:         this.batch = new Int16Array(BATCH_SAMPLES);\n76: