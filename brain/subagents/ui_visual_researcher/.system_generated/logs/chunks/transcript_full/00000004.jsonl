{"step_index":55,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-08-21T21:52:49Z","content":"Created At: 2026-08-21T18:52:49-03:00\nCompleted At: 2026-08-21T18:52:49-03:00\nFile Path: `file:///c:/Users/Arthur%20Henrique/Documents/GitHub/Spectra/web/js/mute-manager.js`\nTotal Lines: 115\nTotal Bytes: 3864\nShowing lines 1 to 115\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: // --- mute-manager.js ---\n2: // Centralized module for managing all mute states in the application.\n3: // This includes microphone mute, universal mute (system pause), and any future mute-related features.\n4: \n5: import { devLog } from './config.js';\n6: \n7: class MuteManager {\n8:     constructor() {\n9:         // --- State Properties ---\n10:         this._isMicrophoneMuted = true; // Traditional microphone mute (input to app)\n11:         this._isUniversallyMuted = false; // System-wide pause for all audio processing\n12: \n13:         // --- Event Handling ---\n14:         this.eventListeners = new Map();\n15: \n16:         devLog('🔇 Mute Manager initialized');\n17:     }\n18: \n19:     // --- Event Emitter ---\n20:     on(eventName, listener) {\n21:         if (!this.eventListeners.has(eventName)) {\n22:             this.eventListeners.set(eventName, []);\n23:         }\n24:         this.eventListeners.get(eventName).push(listener);\n25:     }\n26: \n27:     emit(eventName, data) {\n28:         if (this.eventListeners.has(eventName)) {\n29:             this.eventListeners.get(eventName).forEach(listener => listener(data));\n30:         }\n31:     }\n32: \n33:     // --- Microphone Mute ---\n34:     setMicrophoneMute(isMuted) {\n35:         if (this._isMicrophoneMuted === isMuted) return;\n36:         this._isMicrophoneMuted = isMuted;\n37:         devLog(`🎤 Microphone mute state changed to: ${isMuted}`);\n38:         this.emit('microphoneMuteChange', this._isMicrophoneMuted);\n39:         this.emit('stateChange', this.getMuteStatus());\n40:     }\n41: \n42:     toggleMicrophoneMute() {\n43:         this.setMicrophoneMute(!this._isMicrophoneMuted);\n44:         return this._isMicrophoneMuted;\n45:     }\n46: \n47:     // --- Universal Mute (System Pause) ---\n48:     setUniversalMute(isMuted) {\n49:         if (this._isUniversallyMuted === isMuted) return;\n50:         this._isUniversallyMuted = isMuted;\n51:         devLog(`⏸️ Universal mute state changed to: ${isMuted}`);\n52:         this.emit('universalMuteChange', this._isUniversallyMuted);\n53:         this.emit('stateChange', this.getMuteStatus());\n54: \n55:         // Notify the backend about the change\n56:         if (typeof window.sendSocketMessage === 'function') {\n57:             window.sendSocketMessage('config_update', {\n58:                 isUniversallyMuted: this._isUniversallyMuted\n59:             });\n60:         }\n61:     }\n62: \n63:     toggleUniversalMute() {\n64:         this.setUniversalMute(!this._isUniversallyMuted);\n65:         return this._isUniversallyMuted;\n66:     }\n67: \n68:     // --- State Getters ---\n69:     isMicrophoneMuted() {\n70:         return this._isMicrophoneMuted;\n71:     }\n72: \n73:     isUniversallyMuted() {\n74:         return this._isUniversallyMuted;\n75:     }\n76: \n77:     // Returns true if ANY form of mute is active that would stop audio processing.\n78:     isAudioPaused() {\n79:         return this.isUniversallyMuted();\n80:     }\n81: \n82:     getMuteStatus() {\n83:         return {\n84:             microphone: this.isMicrophoneMuted(),\n85:             universal: this.isUniversallyMuted(),\n86:             isAudioPaused: this.isAudioPaused(),\n87:             description: this.getCurrentStateDescription()\n88:         };\n89:     }\n90: \n91:     getCurrentStateDescription() {\n92:         if (this.isUniversallyMuted()) {\n93:             return 'System Paused: All audio processing is stopped.';\n94:         }\n95:         if (this.isMicrophoneMuted()) {\n96:             return 'Microphone Muted: Only interviewer speech is being processed.';\n97:         }\n98:         return 'Active: All speakers are being processed.';\n99:     }\n100: }\n101: \n102: // Create a singleton instance\n103: const muteManager = new MuteManager();\n104: \n105: // --- Global Functions for Console and Module Access ---\n106: window.muteManager = muteManager;\n107: window.toggleUniversalMute = () => muteManager.toggleUniversalMute();\n108: window.enableUniversalMute = () => muteManager.setUniversalMute(true);\n109: window.disableUniversalMute = () => muteManager.setUniversalMute(false);\n110: window.getMuteStatus = () => muteManager.getMuteStatus();\n111: window.pauseInterview = window.enableUniversalMute; // Alias\n112: window.resumeInterview = window.disableUniversalMute; // Alias\n113: \n114: // For modules\n115: export default muteManager;\nThe above content shows the entire, complete file contents of the requested file.\n"}
