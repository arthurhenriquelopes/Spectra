{"step_index":53,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-08-21T21:52:45Z","content":"Created At: 2026-08-21T18:52:45-03:00\nCompleted At: 2026-08-21T18:52:45-03:00\nFile Path: `file:///c:/Users/Arthur%20Henrique/Documents/GitHub/Spectra/web/js/live-streaming.js`\nTotal Lines: 484\nTotal Bytes: 17676\nShowing lines 1 to 484\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: // Live Interview Streaming Module\n2: // Handles text streaming, animations, and content parsing with markdown support\n3: \n4: import { MarkdownProcessor } from './markdown-processor.js';\n5: \n6: export class LiveStreaming {\n7:     constructor(config = {}) {\n8:         this.config = {\n9:             enableStreaming: true,\n10:             streamingSpeed: 15, // milliseconds between words (lower = faster)\n11:             aiStreamingSpeed: 5, // 2x faster than before\n12:             enableMarkdown: true, // Enable markdown processing\n13:             markdownSpeed: 20, // Faster speed for markdown elements (headers, lists)\n14:             ...config\n15:         };\n16:         \n17:         // Initialize markdown processor\n18:         this.markdownProcessor = new MarkdownProcessor({\n19:             preserveCodeBlocks: true,\n20:             enableNestedLists: true,\n21:             professionalStyling: true\n22:         });\n23:     }\n24: \n25:     // Update configuration\n26:     updateConfig(newConfig) {\n27:         this.config = { ...this.config, ...newConfig };\n28:     }\n29: \n30:     // Stream content with typing effect and markdown support\n31:     async streamContent(container, content, speed = null, onProgress = null) {\n32:         const actualSpeed = speed || this.config.streamingSpeed;\n33: \n34:         if (!this.config.enableStreaming) {\n35:             // If streaming is disabled, show content immediately\n36:             if (this.config.enableMarkdown) {\n37:                 this.displayInstantMarkdown(container, content);\n38:             } else {\n39:                 this.displayInstantText(container, content);\n40:             }\n41:             container.parentElement.classList.add('complete');\n42:             if (onProgress) onProgress(); // Final callback\n43:             return;\n44:         }\n45: \n46:         // Process with markdown if enabled\n47:         if (this.config.enableMarkdown) {\n48:             await this.streamMarkdownContent(container, content, actualSpeed, onProgress);\n49:         } else {\n50:             // Fallback to original logic\n51:             if (content.includes('```')) {\n52:                 await this.streamComplexContent(container, content, actualSpeed, onProgress);\n53:             } else {\n54:                 await this.streamSimpleText(container, content, actualSpeed, onProgress);\n55:             }\n56:         }\n57: \n58:         container.parentElement.classList.add('complete');\n59:     }\n60: \n61:     // Stream simple text\n62:     async streamSimpleText(container, text, speed, onProgress = null) {\n63:         const words = text.split(' ');\n64:         \n65:         for (let i = 0; i < words.length; i++) {\n66:             const wordSpan = document.createElement('span');\n67:             wordSpan.className = 'word';\n68:             wordSpan.textContent = words[i] + (i < words.length - 1 ? ' ' : '');\n69:             \n70:             container.appendChild(wordSpan);\n71:             \n72:             setTimeout(() => {\n73:                 wordSpan.style.opacity = '1';\n74:             }, 10);\n75:             \n76:             await this.delay(speed);\n77:             \n78:             // Callback for scroll updates\n79:             if (onProgress && i % 3 === 0) {\n80:                 onProgress();\n81:             }\n82:         }\n83:         \n84:         // Final callback\n85:         if (onProgress) {\n86:             onProgress();\n87:         }\n88:     }\n89: \n90:     // Stream complex content with code\n91:     async streamComplexContent(container, content, speed, onProgress = null) {\n92:         const parts = this.parseContent(content);\n93:         \n94:         for (const part of parts) {\n95:             if (part.type === 'text') {\n96:                 await this.streamSimpleText(container, part.content, speed, onProgress);\n97:             } else if (part.type === 'code') {\n98:                 this.addCodeBlock(container, part.content, part.language);\n99:                 await this.delay(200); // Reduced delay for faster display\n100:             }\n101:             if (onProgress) onProgress();\n102:         }\n103:     }\n104: \n105:     // Parse content for code blocks\n106:     parseContent(content) {\n107:         const parts = [];\n108:         const codeBlockRegex = /```(\\w+)?\\n([\\s\\S]*?)```/g;\n109:         let lastIndex = 0;\n110:         let match;\n111: \n112:         while ((match = codeBlockRegex.exec(content)) !== null) {\n113:             // Add text before code block\n114:             if (match.index > lastIndex) {\n115:                 const textPart = content.substring(lastIndex, match.index);\n116:                 if (textPart.trim()) {\n117:                     parts.push({ type: 'text', content: textPart.trim() });\n118:                 }\n119:             }\n120:             \n121:             // Add code block\n122:             parts.push({\n123:                 type: 'code',\n124:                 language: match[1] || 'javascript',\n125:                 content: match[2].trim()\n126:             });\n127:             \n128:             lastIndex = match.index + match[0].length;\n129:         }\n130:         \n131:         // Add remaining text\n132:         if (lastIndex < content.length) {\n133:             const remainingText = content.substring(lastIndex);\n134:             if (remainingText.trim()) {\n135:                 parts.push({ type: 'text', content: remainingText.trim() });\n136:             }\n137:         }\n138:         \n139:         // If no code blocks found, return as simple text\n140:         if (parts.length === 0) {\n141:             parts.push({ type: 'text', content: content });\n142:         }\n143:         \n144:         return parts;\n145:     }\n146: \n147:     // Add code block\n148:     addCodeBlock(container, code, language) {\n149:         const codeBlockDiv = document.createElement('div');\n150:         codeBlockDiv.className = 'code-block';\n151:         \n152:         const headerDiv = document.createElement('div');\n153:         headerDiv.className = 'code-header';\n154:         \n155:         // Create language tag\n156:         const languageTag = document.createElement('span');\n157:         languageTag.className = 'language-tag';\n158:         languageTag.textContent = language;\n159:         \n160:         // Create copy button with proper event handling\n161:         const copyButton = document.createElement('button');\n162:         copyButton.className = 'copy-btn';\n163:         copyButton.innerHTML = '&#128203;'; // Clipboard icon\n164:         copyButton.title = 'Copy code';\n165:         copyButton.addEventListener('click', async () => {\n166:             try {\n167:                 await navigator.clipboard.writeText(code);\n168:                 copyButton.textContent = '✅';\n169:                 copyButton.title = 'Copied!';\n170:                 setTimeout(() => {\n171:                     copyButton.innerHTML = '&#128203;';\n172:                     copyButton.title = 'Copy code';\n173:                 }, 2000);\n174:             } catch (err) {\n175:                 console.error('Failed to copy code:', err);\n176:                 copyButton.textContent = '❌';\n177:                 copyButton.title = 'Failed to copy';\n178:                 setTimeout(() => {\n179:                     copyButton.innerHTML = '&#128203;';\n180:                     copyButton.title = 'Copy code';\n181:                 }, 2000);\n182:             }\n183:         });\n184:         \n185:         headerDiv.appendChild(languageTag);\n186:         headerDiv.appendChild(copyButton);\n187:         \n188:         const preElement = document.createElement('pre');\n189:         const codeElement = document.createElement('code');\n190:         codeElement.className = `language-${language}`;\n191:         codeElement.textContent = code;\n192:         \n193:         preElement.appendChild(codeElement);\n194:         codeBlockDiv.appendChild(headerDiv);\n195:         codeBlockDiv.appendChild(preElement);\n196:         \n197:         container.appendChild(codeBlockDiv);\n198:         \n199:         // Apply syntax highlighting\n200:         if (window.Prism) {\n201:             window.Prism.highlightElement(codeElement);\n202:         }\n203:     }\n204: \n205:     // NEW: Stream markdown content with proper formatting\n206:     async streamMarkdownContent(container, content, speed, onProgress = null) {\n207:         try {\n208:             const blocks = this.markdownProcessor.parseContent(content);\n209:             \n210:             for (let i = 0; i < blocks.length; i++) {\n211:                 const block = blocks[i];\n212: \n213:                 if (block.type === 'code') {\n214:                     this.addCodeBlock(container, block.content, block.language);\n215:                     await this.delay(50);\n216:                 } else if (block.type === 'header') {\n217:                     await this.streamHeaderBlock(container, block, onProgress);\n218:                 } else if (block.type === 'list') {\n219:                     await this.streamListBlock(container, block, speed, onProgress);\n220:                 } else if (block.type === 'paragraph') {\n221:                     await this.streamParagraphBlock(container, block, speed, onProgress);\n222:                 }\n223:                 \n224:                 if (onProgress) onProgress();\n225: \n226:                 if (i < blocks.length - 1) {\n227:                     await this.delay(40);\n228:                 }\n229:             }\n230:         } catch (error) {\n231:             console.error('Markdown processing error:', error);\n232:             await this.streamSimpleText(container, content, speed, onProgress);\n233:         }\n234:     }\n235: \n236:     // Stream a header block\n237:     async streamHeaderBlock(container, block, onProgress) {\n238:         const headerElement = document.createElement(`h${block.level}`);\n239:         headerElement.className = `markdown-header markdown-h${block.level}`;\n240:         headerElement.id = block.id;\n241:         \n242:         container.appendChild(headerElement);\n243:         \n244:         await this.delay(20);\n245:         await this.streamTextIntoElement(headerElement, block.content, this.config.aiStreamingSpeed, onProgress);\n246:     }\n247: \n248:     // Stream a list block\n249:     async streamListBlock(container, block, speed, onProgress) {\n250:         const listTag = block.listType === 'numbered' ? 'ol' : 'ul';\n251:         const listElement = document.createElement(listTag);\n252:         listElement.className = `markdown-list markdown-${block.listType}-list`;\n253:         \n254:         container.appendChild(listElement);\n255:         \n256:         const listItems = [];\n257:         for (let i = 0; i < block.items.length; i++) {\n258:             const item = block.items[i];\n259:             const listItem = document.createElement('li');\n260:             \n261:             let className = 'markdown-list-item';\n262:             if (item.indent > 0) {\n263:                 className += ` indent-${Math.min(item.indent, 4)}`;\n264:             }\n265:             listItem.className = className;\n266:             \n267:             listElement.appendChild(listItem);\n268:             listItems.push({ element: listItem, content: item.content });\n269:         }\n270:         \n271:         await this.delay(20);\n272:         \n273:         for (let i = 0; i < listItems.length; i++) {\n274:             await this.streamTextIntoElement(listItems[i].element, listItems[i].content, speed, onProgress);\n275:             \n276:             if (i < listItems.length - 1) {\n277:                 await this.delay(20);\n278:             }\n279:         }\n280:     }\n281: \n282:     // Stream a paragraph block\n283:     async streamParagraphBlock(container, block, speed, onProgress) {\n284:         if (!block.content || !block.content.trim()) {\n285:             return;\n286:         }\n287:         \n288:         const paragraphElement = document.createElement('p');\n289:         paragraphElement.className = 'markdown-paragraph';\n290:         paragraphElement.id = block.id;\n291:         \n292:         container.appendChild(paragraphElement);\n293:         \n294:         await this.delay(20);\n295:         await this.streamTextIntoElement(paragraphElement, block.content, speed, onProgress);\n296:     }\n297: \n298:     // Stream text into a specific element with HTML support\n299:     async streamTextIntoElement(element, htmlContent, speed, onProgress) {\n300:         const tempDiv = document.createElement('div');\n301:         tempDiv.innerHTML = htmlContent;\n302:         \n303:         if (tempDiv.children.length > 0 && tempDiv.textContent !== htmlContent) {\n304:             await this.streamMixedContent(element, tempDiv, speed, onProgress);\n305:         } else {\n306:             const text = tempDiv.textContent || htmlContent;\n307:             await this.streamSimpleTextIntoElement(element, text, speed, onProgress);\n308:         }\n309:     }\n310: \n311:     // Stream mixed HTML and text content\n312:     async streamMixedContent(targetElement, sourceElement, speed, onProgress) {\n313:         for (const child of sourceElement.childNodes) {\n314:             if (child.nodeType === Node.TEXT_NODE) {\n315:                 const text = child.textContent; // Don't trim, preserve spaces\n316:                 if (text) {\n317:                     await this.streamSimpleTextIntoElement(targetElement, text, speed, onProgress);\n318:                 }\n319:             } else if (child.nodeType === Node.ELEMENT_NODE) {\n320:                 const formattedElement = child.cloneNode(false);\n321:                 targetElement.appendChild(formattedElement);\n322:                 \n323:                 if (child.textContent) {\n324:                     await this.streamSimpleTextIntoElement(formattedElement, child.textContent, speed, onProgress);\n325:                 }\n326:                 \n327:                 await this.delay(30);\n328:             }\n329:         }\n330:     }\n331: \n332:     // Stream simple text into an element\n333:     async streamSimpleTextIntoElement(element, text, speed, onProgress) {\n334:         const words = text.split(/(\\s+)/); // Split by spaces but keep them\n335: \n336:         for (let i = 0; i < words.length; i++) {\n337:             const part = words[i];\n338:             if (part) {\n339:                 const wordSpan = document.createElement('span');\n340:                 wordSpan.className = 'word';\n341:                 wordSpan.textContent = part;\n342:                 element.appendChild(wordSpan);\n343: \n344:                 setTimeout(() => {\n345:                     wordSpan.style.opacity = '1';\n346:                 }, 10);\n347: \n348:                 // Only delay for non-whitespace parts\n349:                 if (part.trim()) {\n350:                     await this.delay(speed);\n351:                     if (onProgress) onProgress();\n352:                 }\n353:             }\n354:         }\n355:     }\n356: \n357:     // Display markdown content instantly (for interim updates)\n358:     displayInstantMarkdown(container, content) {\n359:         try {\n360:             const blocks = this.markdownProcessor.parseContent(content);\n361:             \n362:             blocks.forEach(block => {\n363:                 if (block.type === 'code') {\n364:                     this.addCodeBlock(container, block.content, block.language);\n365:                 } else {\n366:                     const html = this.markdownProcessor.generateHTML(block);\n367:                     if (html) {\n368:                         const tempDiv = document.createElement('div');\n369:                         tempDiv.innerHTML = html;\n370:                         \n371:                         // Move all children from temp div to container\n372:                         while (tempDiv.firstChild) {\n373:                             const element = tempDiv.firstChild;\n374:                             container.appendChild(element);\n375:                             \n376:                             // Apply instant word styling to text content\n377:                             this.applyInstantWordStyling(element);\n378:                         }\n379:                     }\n380:                 }\n381:             });\n382:         } catch (error) {\n383:             console.error('Instant markdown display error:', error);\n384:             // Fallback to simple text\n385:             this.displayInstantText(container, content);\n386:         }\n387:     }\n388: \n389:     // Apply instant word styling to an element and its children\n390:     applyInstantWordStyling(element) {\n391:         if (element.nodeType === Node.TEXT_NODE) {\n392:             // Don't process text nodes directly\n393:             return;\n394:         }\n395:         \n396:         if (element.nodeType === Node.ELEMENT_NODE) {\n397:             // Check if this element has direct text content\n398:             const walker = document.createTreeWalker(\n399:                 element,\n400:                 NodeFilter.SHOW_TEXT,\n401:                 null,\n402:                 false\n403:             );\n404:             \n405:             const textNodes = [];\n406:             let node;\n407:             while (node = walker.nextNode()) {\n408:                 if (node.textContent.trim()) {\n409:                     textNodes.push(node);\n410:                 }\n411:             }\n412:             \n413:             // Replace text nodes with word spans\n414:             textNodes.forEach(textNode => {\n415:                 const text = textNode.textContent;\n416:                 const parent = textNode.parentNode;\n417:                 \n418:                 // Create word spans\n419:                 const words = text.split(' ');\n420:                 const fragment = document.createDocumentFragment();\n421:                 \n422:                 words.forEach((word, i) => {\n423:                     if (word.trim()) {\n424:                         const wordSpan = document.createElement('span');\n425:                         wordSpan.className = 'word';\n426:                         wordSpan.style.opacity = '1';\n427:                         wordSpan.textContent = word + (i < words.length - 1 ? ' ' : '');\n428:                         fragment.appendChild(wordSpan);\n429:                     }\n430:                 });\n431:                 \n432:                 parent.replaceChild(fragment, textNode);\n433:             });\n434:         }\n435:     }\n436: \n437:     // Display text instantly (for interim updates)\n438:     displayInstantText(container, text) {\n439:         const words = text.split(' ');\n440:         \n441:         for (let i = 0; i < words.length; i++) {\n442:             const wordSpan = document.createElement('span');\n443:             wordSpan.className = 'word';\n444:             wordSpan.style.opacity = '1'; // Show immediately\n445:             wordSpan.textContent = words[i] + (i < words.length - 1 ? ' ' : '');\n446:             container.appendChild(wordSpan);\n447:         }\n448:     }\n449: \n450:     // Delay utility\n451:     delay(ms) {\n452:         return new Promise(resolve => setTimeout(resolve, ms));\n453:     }\n454: \n455:     // Configuration methods\n456:     setStreamingEnabled(enabled) {\n457:         this.config.enableStreaming = enabled;\n458:     }\n459: \n460:     setStreamingSpeed(speed) {\n461:         this.config.streamingSpeed = Math.max(10, Math.min(100, speed)); // 10-100ms range\n462:     }\n463: \n464:     setAIStreamingSpeed(speed) {\n465:         this.config.aiStreamingSpeed = Math.max(5, Math.min(50, speed)); // 5-50ms range\n466:     }\n467: \n468:     setMarkdownEnabled(enabled) {\n469:         this.config.enableMarkdown = enabled;\n470:     }\n471: \n472:     setMarkdownSpeed(speed) {\n473:         this.config.markdownSpeed = Math.max(50, Math.min(500, speed)); // 50-500ms range\n474:     }\n475: \n476:     getConfig() {\n477:         return { ...this.config };\n478:     }\n479: \n480:     // Get markdown processor instance\n481:     getMarkdownProcessor() {\n482:         return this.markdownProcessor;\n483:     }\n484: } \nThe above content shows the entire, complete file contents of the requested file.\n"}
