tHTML(block) {\n544:         if (block.listType === 'task') {\n545:             return this.generateTaskListHTML(block);\n546:         }\n547:         \n548:         const tag = block.listType === 'numbered' ? 'ol' : 'ul';\n549:         const className = `markdown-list markdown-${block.listType}-list`;\n550:         \n551:         let html = `<${tag} class=\"${className}\">`;\n552:         \n553:         block.items.forEach(item => {\n554:             const indentClass = item.indent > 0 ? ` indent-${Math.min(item.indent, this.config.maxNestingLevel)}` : '';\n555:             html += `<li class=\"markdown-list-item${indentClass}\">${item.content}</li>`;\n556:         });\n557:         \n558:         html += `</${tag}>`;\n559:         return html;\n560:     }\n561: \n562:     generateTaskListHTML(block) {\n563:         const className = 'markdown-list markdown-task-list';\n564:         \n565:         let html = `<ul class=\"${className}\">`;\n566:         \n567:         block.items.forEach(item => {\n568:             const indentClass = item.indent > 0 ? ` indent-${Math.min(item.indent, this.config.maxNestingLevel)}` : '';\n569:             const checkedAttr = item.checked ? ' checked' : '';\n570:             const checkedClass = item.checked ? ' task-checked' : ' task-unchecked';\n571:             \n572:             html += `<li class=\"markdown-task-item${indentClass}${checkedClass}\">`;\n573:             html += `<input type=\"checkbox\" class=\"task-checkbox\" disabled${checkedAttr}>`;\n574:             html += `<span class=\"task-content\">${item.content}</span>`;\n575:             html += `</li>`;\n576:         });\n577:         \n578:         html += `</ul>`;\n579:         return html;\n580:     }\n581: \n582:     generateTableHTML(block) {\n583:         if (!block.headers || block.headers.length === 0) {\n584:             return '';\n585:         }\n586:         \n587:         const className = 'markdown-table';\n588:         let html = `<div class=\"table-wrapper\"><table class=\"${className}\">`;\n589:         \n590:         // Generate table header\n591:         html += '<thead><tr>';\n592:         block.headers.forEach((header, index) => {\n593:             const alignment = block.alignments[index] || 'left';\n594:             const alignClass = alignment !== 'left' ? ` text-${alignment}` : '';\n595:             html += `<th class=\"table-header${alignClass}\">${header}</th>`;\n596:         });\n597:         html += '</tr></thead>';\n598:         \n599:         // Generate table body\n600:         if (block.rows && block.rows.length > 0) {\n601:             html += '<tbody>';\n602:             block.rows.forEach(row => {\n603:                 html += '<tr>';\n604:                 row.forEach((cell, index) => {\n605:                     const alignment = block.alignments[index] || 'left';\n606:                     const alignClass = alignment !== 'left' ? ` text-${alignment}` : '';\n607:                     html += `<td class=\"table-cell${alignClass}\">${cell}</td>`;\n608:                 });\n609:                 html += '</tr>';\n610:             });\n611:             html += '</tbody>';\n612:         }\n613:         \n614:         html += '</table></div>';\n615:         return html;\n616:     }\n617: \n618:     generateBlockquoteHTML(block) {\n619:         const className = 'markdown-blockquote';\n620:         return `<blockquote class=\"${className}\">${block.content}</blockquote>`;\n621:     }\n622: \n623:     generateHorizontalRuleHTML(block) {\n624:         const className = 'markdown-hr';\n625:         return `<hr class=\"${className}\" />`;\n626:     }\n627: \n628:     generateParagraphHTML(block) {\n629:         if (!block.content || !block.content.trim()) {\n630:             return '';\n631:         }\n632:         return `<p class=\"markdown-paragraph\">${block.content}</p>`;\n633:     }\n634: \n635:     generateCodeHTML(block) {\n636:         // This will be handled by the existing code block system\n637