sDev()) {\n44:         console.warn('[DEV]', ...args);\n45:     }\n46: }\n47: \n48: export function devError(...args) {\n49:     if (isDev()) {\n50:         console.error('[DEV]', ...args);\n51:     }\n52: }\n53: \n54: // Initialize configuration and export it\n55: export { loadConfig, appConfig };\n56: export default appConfig;\n57: \n58: /**\n59:  * Call this AFTER loadConfig() to suppress noisy console output in production.\n60:  * console.warn and console.error are always preserved.\n61:  */\n62: export function applyConsoleGate() {\n63:     if (!isDev()) {\n64:         const noop = () => {};\n65:         console.log = noop;\n66:         console.debug = noop;\n67:         console.info = noop;\n68:         // console.warn and console.error are intentionally left active\n69:     }\n70: }\nThe above content shows the entire, complete file contents of the requested file.\n"}
