rtsWith('|') && trimmedLine.endsWith('|')) {\n165:                 if (currentBlock || currentList || currentBlockquote) {\n166:                     this.endCurrentBlocks(blocks, { currentBlock, currentList, currentBlockquote });\n167:                     currentBlock = currentList = currentBlockquote = null;\n168:                 }\n169:                 \n170:                 // Check if this is a table separator\n171:                 const isSeparator = this.patterns.tableSeparator.test(trimmedLine);\n172:                 \n173:                 if (!currentTable) {\n174:                     currentTable = {\n175:                         type: 'table',\n176:                         headers: [],\n177:                         rows: [],\n178:                         alignments: [],\n179:                         id: `table-${this.elementCounter++}`\n180:                     };\n181:                 }\n182:                 \n183:                 if (isSeparator) {\n184:                     // Parse alignment from separator\n185:                     const cells = trimmedLine.split('|').slice(1, -1);\n186:                     currentTable.alignments = cells.map(cell => {\n187:                         const trimmed = cell.trim();\n188:                         if (trimmed.startsWith(':') && trimmed.endsWith(':')) return 'center';\n189:                         if (trimmed.endsWith(':')) return 'right';\n190:                         return 'left';\n191:                     });\n192:                 } else {\n193:                     // Parse table row\n194:                     const cells = trimmedLine.split('|').slice(1, -1).map(cell => cell.trim());\n195:                     \n196:                     if (currentTable.headers.length === 0 && currentTable.rows.length === 0) {\n197:                         currentTable.headers = cells;\n198:                     } else {\n199:                         currentTable.rows.push(cells);\n200:                     }\n201:             