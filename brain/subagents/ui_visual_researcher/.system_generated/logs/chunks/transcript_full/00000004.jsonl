ng if this is inside bold tags\n415:             if (processedText.includes(`<strong class=\"markdown-bold\">${content}</strong>`)) {\n416:                 return match;\n417:             }\n418:             return `<em class=\"markdown-italic\">${content}</em>`;\n419:         });\n420:         \n421:         // 6. Strikethrough\n422:         processedText = processedText.replace(this.patterns.strikethrough, (match, content) => {\n423:             return `<del class=\"markdown-strikethrough\">${content}</del>`;\n424:         });\n425:         \n426:         // 7. Restore inline code\n427:         codeSegments.forEach(segment => {\n428:             processedText = processedText.replace(segment.id, () => segment.html);\n429:         });\n430:         \n431:         return processedText;\n432:     }\n433: \n434:     /**\n435:      * Restore code blocks in final content\n436:      */\n437:     restoreCodeBlocks(blocks, codeBlocks) {\n438:         const codeBlockMap = {};\n439:         codeBlocks.forEach(block => {\n440:             codeBlockMap[block.id] = block;\n441:         });\n442:         \n443:         const finalBlocks = [];\n444:         \n445:         blocks.forEach(block => {\n446:             if (block.type === 'paragraph' && block.content && block.content.includes('__CODE_BLOCK_')) {\n447:                 // Split paragraph by code block placeholders\n448:                 const parts = block.content.split(/(__CODE_BLOCK_\\d+__)/);\n449:                 \n450:                 parts.forEach(part => {\n451:                     if (part.match(/^__CODE_BLOCK_\\d+__$/)) {\n452:                         const codeBlock = codeBlockMap[part];\n453:                         if (codeBlock) {\n454:                             finalBlocks.push(codeBlock);\n455:                         }\n456:                     } else if (part.trim()) {\n457:                         finalBlocks.push({\n458:                             type: 'paragraph',\n459:                             content: part.trim(),\n460:                             id: `paragraph-${this.elementCounter++}`\n461:                         });\n462:                     }\n463:                 });\n464:             } else if (block.type === 'table' && block.headers) {\n465:                 // Process table headers and cells for code blocks\n466:                 const processedHeaders = block.headers.map(header => {\n467:                     if (header && header.includes('__CODE_BLOCK_')) {\n468:                         // For table cells, we'll inline the code\n469:                         return header.replace(/(__CODE_BLOCK_\\d+__)/g, (match) => {\n470:                             const codeBlock = codeBlockMap[match];\n471:                             return codeBlock ? `<code>${this.escapeHtml(codeBlock.content)}</code>` : match;\n472:                         });\n473:                     }\n474:                     return header;\n475:                 });\n476:                 \n477:                 const processedRows = block.rows.map(row => \n478:                     row.map(cell => {\n479:                         if (cell && cell.includes('__CODE_BLOCK_')) {\n480:                             return cell.replace(/(__CODE_BLOCK_\\d+__)/g, (match) => {\n481:                                 const codeBlock = codeBlockMap[match];\n482:                                 return codeBlock ? `<code>${this.escapeHtml(codeBlock.content)}</code>` : match;\n483:                             });\n484:                         }\n485:                         return cell;\n486:                     })\n487:                 );\n488:                 \n489:                 finalBlocks.push({\n490:                     ...block,\n491:                     headers: processedHeaders,\n492:                     rows: processedRows\n493:                 });\n494:             } else if (block.content && block.content.includes('__CODE_BLOCK_')) {\n495:                 // Process other block types that m