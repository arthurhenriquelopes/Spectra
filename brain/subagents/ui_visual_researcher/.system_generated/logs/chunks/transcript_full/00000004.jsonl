{"step_index":51,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-08-21T21:52:42Z","content":"Created At: 2026-08-21T18:52:42-03:00\nCompleted At: 2026-08-21T18:52:42-03:00\nFile Path: `file:///c:/Users/Arthur%20Henrique/Documents/GitHub/Spectra/web/js/live-controls.js`\nTotal Lines: 249\nTotal Bytes: 8988\nShowing lines 1 to 249\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: // Live Interview Controls Module\n2: // Handles global controls, transparency, window management, and presets\n3: \n4: export class LiveControls {\n5:     constructor() {\n6:         this.transparencyConfig = {\n7:             bgTransparency: 0.80, // Background transparency (0-1) - 80% opacity\n8:             contentTransparency: 0.20, // Content transparency (0-1) - 80% opacity\n9:             codeTransparency: 0.50 // Code block transparency (0-1) - 50% opacity for readability\n10:         };\n11:         \n12:         this.setupGlobalFunctions();\n13:     }\n14: \n15:     // Transparency configuration methods\n16:     setBackgroundTransparency(transparency) {\n17:         this.transparencyConfig.bgTransparency = Math.max(0, Math.min(1, transparency));\n18:         this.updateCSSTransparency();\n19:     }\n20: \n21:     setContentTransparency(transparency) {\n22:         this.transparencyConfig.contentTransparency = Math.max(0, Math.min(1, transparency));\n23:         this.updateCSSTransparency();\n24:     }\n25: \n26:     setCodeTransparency(transparency) {\n27:         this.transparencyConfig.codeTransparency = Math.max(0, Math.min(1, transparency));\n28:         this.updateCSSTransparency();\n29:     }\n30: \n31:     // Update CSS transparency variables\n32:     updateCSSTransparency() {\n33:         const root = document.documentElement;\n34:         root.style.setProperty('--bg-transparency', this.transparencyConfig.bgTransparency);\n35:         root.style.setProperty('--content-transparency', this.transparencyConfig.contentTransparency);\n36:         root.style.setProperty('--code-transparency', this.transparencyConfig.codeTransparency);\n37:     }\n38: \n39:     // Windows-level transparency controls\n40:     async setWindowTransparency(transparency) {\n41:         try {\n42:             if (window.chrome && window.chrome.webview) {\n43:                 window.chrome.webview.postMessage({\n44:                     type: 'set_transparency',\n45:                     payload: { transparency: transparency }\n46:                 });\n47:                 return true;\n48:             }\n49: \n50:             const response = await fetch('/api/transparency', {\n51:                 method: 'POST',\n52:                 headers: { 'Content-Type': 'application/json' },\n53:                 body: JSON.stringify({ transparency: transparency })\n54:             });\n55:             const result = await response.json();\n56:             return result.success;\n57:         } catch (error) {\n58:             console.error('❌ Error setting window transparency:', error);\n59:             return false;\n60:         }\n61:     }\n62: \n63:     async setWindowTransparencyPercent(percent) {\n64:         try {\n65:             if (window.chrome && window.chrome.webview) {\n66:                 window.chrome.webview.postMessage({\n67:                     type: 'set_transparency',\n68:                     payload: { percent: percent }\n69:                 });\n70:                 return true;\n71:             }\n72: \n73:             const response = await fetch('/api/transparency/percent', {\n74:                 method: 'POST',\n75:                 headers: { 'Content-Type': 'application/json' },\n76:                 body: JSON.stringify({ percent: percent })\n77:             });\n78:             const result = await response.json();\n79:             return result.success;\n80:         } catch (error) {\n81:             console.error('❌ Error setting window transparency:', error);\n82:             return false;\n83:         }\n84:     }\n85: \n86:     // Always-on-top controls\n87:     async setAlwaysOnTop(onTop = true) {\n88:         try {\n89:             const response = await fetch('/api/window/always-on-top', {\n90:                 method: 'POST',\n91:                 headers: { 'Content-Type': 'application/json' },\n92:                 body: JSON.stringify({ on_top: onTop })\n93:             });\n94:             const result = await response.json();\n95:             if (result.success) {\n96:                 console.log(`📌 ${result.message}`);\n97:                 return true;\n98:             }\n99:             return false;\n100:         } catch (error) {\n101:             console.error('❌ Error setting always on top:', error);\n102:             return false;\n103:         }\n104:     }\n105: \n106:     // Window transparency presets\n107:     async setInterviewMode() {\n108:         try {\n109:             const response = await fetch('/api/transparency/presets/transparent', {\n110:                 method: 'POST'\n111:             });\n112:             const result = await response.json();\n113:             if (result.success) {\n114:                 console.log('🎯 Interview mode activated - window is now 40% opaque');\n115:                 return true;\n116:             }\n117:             return false;\n118:         } catch (error) {\n119:             console.error('❌ Error setting interview mode:', error);\n120:             return false;\n121:         }\n122:     }\n123: \n124:     async setSemiTransparentMode() {\n125:         try {\n126:             const response = await fetch('/api/transparency/presets/semi-transparent', {\n127:                 method: 'POST'\n128:             });\n129:             const result = await response.json();\n130:             if (result.success) {\n131:                 console.log('🌫️ Semi-transparent mode activated - window is now 70% opaque');\n132:                 return true;\n133:             }\n134:             return false;\n135:         } catch (error) {\n136:             console.error('❌ Error setting semi-transparent mode:', error);\n137:             return false;\n138:         }\n139:     }\n140: \n141:     async setOpaqueMode() {\n142:         try {\n143:             const response = await fetch('/api/transparency/presets/opaque', {\n144:                 method: 'POST'\n145:             });\n146:             const result = await response.json();\n147:             if (result.success) {\n148:                 console.log('🎨 Opaque mode activated - window is now 100% opaque');\n149:                 return true;\n150:             }\n151:             return false;\n152:         } catch (error) {\n153:             console.error('❌ Error setting opaque mode:', error);\n154:             return false;\n155:         }\n156:     }\n157: \n158:     async getTransparencyInfo() {\n159:         try {\n160:             const response = await fetch('/api/transparency');\n161:             const info = await response.json();\n162:             console.log('🪟 Window Transparency Info:', info);\n163:             return info;\n164:         } catch (error) {\n165:             console.error('❌ Error getting transparency info:', error);\n166:             return null;\n167:         }\n168:     }\n169: \n170:     // CSS Transparency presets\n171:     setMinimalMode() {\n172:         this.setBackgroundTransparency(0.95);\n173:         this.setContentTransparency(0.05);\n174:         this.setCodeTransparency(0.25);\n175:         console.log('👤 Minimal mode activated');\n176:     }\n177: \n178:     setGhostMode() {\n179:         this.setBackgroundTransparency(0.98);\n180:         this.setContentTransparency(0.02);\n181:         this.setCodeTransparency(0.15);\n182:         console.log('👻 Ghost mode activated - maximum transparency');\n183:     }\n184: \n185:     setStealthMode() {\n186:         this.setBackgroundTransparency(0.90);\n187:         this.setContentTransparency(0.10);\n188:         this.setCodeTransparency(0.35);\n189:         console.log('🥷 Stealth mode activated');\n190:     }\n191: \n192:     setDefaultTransparency() {\n193:         this.setBackgroundTransparency(0.80);\n194:         this.setContentTransparency(0.20);\n195:         this.setCodeTransparency(0.50);\n196:         console.log('🎨 Default transparency restored (80% opacity)');\n197:     }\n198: \n199:     // Setup global window functions\n200:     setupGlobalFunctions() {\n201:         // Basic transparency controls\n202:         window.setBackgroundTransparency = (transparency) => {\n203:             this.setBackgroundTransparency(transparency);\n204:             console.log(`🌙 Background transparency set to ${transparency}`);\n205:         };\n206: \n207:         window.setContentTransparency = (transparency) => {\n208:             this.setContentTransparency(transparency);\n209:             console.log(`🖼️ Content transparency set to ${transparency}`);\n210:         };\n211: \n212:         window.setCodeTransparency = (transparency) => {\n213:             this.setCodeTransparency(transparency);\n214:             console.log(`💻 Code transparency set to ${transparency}`);\n215:         };\n216: \n217:         // CSS Transparency presets\n218:         window.setMinimalMode = () => this.setMinimalMode();\n219:         window.setGhostMode = () => this.setGhostMode();\n220:         window.setStealthMode = () => this.setStealthMode();\n221:         window.setDefaultTransparency = () => this.setDefaultTransparency();\n222: \n223:         // Windows-level transparency\n224:         window.setWindowTransparency = (transparency) => this.setWindowTransparency(transparency);\n225:         window.setWindowTransparencyPercent = (percent) => this.setWindowTransparencyPercent(percent);\n226: \n227:         // Window transparency presets\n228:         window.setInterviewMode = () => this.setInterviewMode();\n229:         window.setSemiTransparentMode = () => this.setSemiTransparentMode();\n230:         window.setOpaqueMode = () => this.setOpaqueMode();\n231:         window.getTransparencyInfo = () => this.getTransparencyInfo();\n232: \n233:         // Always-on-top controls\n234:         window.setAlwaysOnTop = (onTop = true) => this.setAlwaysOnTop(onTop);\n235:         window.enableAlwaysOnTop = () => this.setAlwaysOnTop(true);\n236:         window.disableAlwaysOnTop = () => this.setAlwaysOnTop(false);\n237:     }\n238: \n239:     // Initialize transparency settings\n240:     initialize() {\n241:         this.updateCSSTransparency();\n242:         console.log('🎛️ Live controls initialized');\n243:     }\n244: \n245:     // Get current configuration\n246:     getConfig() {\n247:         return { ...this.transparencyConfig };\n248:     }\n249: } \nThe above content shows the entire, complete file contents of the requested file.\n"}
