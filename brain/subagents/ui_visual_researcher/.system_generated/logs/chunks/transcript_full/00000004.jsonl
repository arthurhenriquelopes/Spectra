      currentList.items.push({\n285:                     content: content,\n286:                     indent: Math.floor(indent / 2),\n287:                     id: `item-${this.elementCounter++}`\n288:                 });\n289:                 continue;\n290:             }\n291:             \n292:             // Check for numbered lists\n293:             const numberedMatch = line.match(/^(\\s*)(\\d+\\.)\\s+(.+)$/);\n294:             if (numberedMatch) {\n295:                 const indent = numberedMatch[1].length;\n296:                 const content = numberedMatch[3];\n297:                 \n298:                 if (currentBlock || currentTable || currentBlockquote) {\n299:                     this.endCurrentBlocks(blocks, { currentBlock, currentTable, currentBlockquote });\n300:                     currentBlock = currentTable = currentBlockquote = null;\n301:                 }\n302:                 \n303:                 if (!currentList || currentList.listType !== 'numbered') {\n304:                     if (currentList) blocks.push(currentList);\n305:                     currentList = {\n306:                         type: 'list',\n307:                         listType: 'numbered',\n308:                         items: [],\n309:                         id: `list-${this.elementCounter++}`\n310:                     };\n311:                 }\n312:                 \n313:                 currentList.items.push({\n314:                     content: content,\n315:                     indent: Math.floor(indent / 2),\n316:                     id: `item-${this.elementCounter++}`\n317:                 });\n318:                 continue;\n319:             }\n320:             \n321:             // Regular text - add to current paragraph or create new one\n322:             if (currentList || currentTable || currentBlockquote) {\n323:                 this.endCurrentBlocks(blocks, { currentList, currentTable, currentBlockquote });\n324:                 currentList = currentTable =