 {\n166:                     if (this.onboardingForm.visionModelSelect && !this.onboardingForm.visionModelSelect.disabled) {\n167:                         const defaultModel = primaryVisionProvider.defaultVisionModel || primaryVisionProvider.visionModels[0];\n168:                         if (defaultModel) {\n169:                             // Handle both string and object models for default selection\n170:                             const modelName = this._getModelName(defaultModel);\n171:                             if (modelName) {\n172:                                 this.onboardingForm.visionModelSelect.value = modelName;\n173:                             }\n174:                         }\n175:                     }\n176:                 }, 250);\n177:             }\n178: \n179:             // Set secondary vision provider\n180:             const secondaryVisionProvider = this.aiProviders.find(p => p.defaultVisionSecondary);\n181:             if (secondaryVisionProvider && this.onboardingForm.visionSecondaryProviderSelect) {\n182:                 this.onboardingForm.visionSecondaryProviderSelect.value = secondaryVisionProvider.name;\n183:                 this.onboardingForm.visionSecondaryProviderSelect.dispatchEvent(new Event('change'));\n184: \n185:                 setTimeout(() => {\n186:                     if (this.onboardingForm.visionSecondaryModelSelect && !this.onboardingForm.visionSecondaryModelSelect.disabled) {\n187:                         const defaultModel = secondaryVisionProvider.defaultVisionModel || secondaryVisionProvider.visionModels[0];\n188:                         if (defaultModel) {\n189:                             // Handle both string and object models for default selection\n190:                             const modelName = this._getModelName(defaultModel);\n191:                             if (modelName) {\n192:                                 this.onboardingForm.visionSecondaryModelSelect.value = modelName;\n193:                             }\n194:                         }\n195:                     }\n196:                 }, 300);\n197:             }\n198: \n199:         } catch (error) {\n200:             console.error(\"Error setting default AI provider:\", error);\n201:         }\n202:     }\n203: \n204:     /**\n205:      * Helper function to get the model name from either a string or object model\n206:      * Used for matching default models and setting dropdown values\n207:      *\n208:      * @param {string|object} model - Model (string or object with modelName)\n209:      * @returns {string} - The model name/identifier\n210:      */\n211:     _getModelName(model) {\n212:         if (typeof model === 'string') {\n213:             return model;\n214:         } else if (typeof model === 'object' && model.modelName) {\n215:             return model.modelName;\n216:         }\n217:         return null;\n218:     }\n219: \n220:     /**\n221:      * Smart helper function to populate model dropdowns\n222:      * Handles both string models and complex object models with routing\n223:      *\n224:      * @param {Array} models - Array of models (strings or objects)\n225:      * @param {HTMLSelectElement} selectElement - The dropdown element to populate\n226:      * @param {string} defaultOptionText - Text for the default option\n227:      */\n228:     _populateModelDropdown(models, selectElement, defaultOptionText) {\n229:         if (!selectElement || !models) return;\n230: \n231:         // Clear existing options and add default\n232:         selectElement.innerHTML = `<option value=\"\">${defaultOptionText}</option>`;\n233:         selectElement.disabled = true;\n234: \n235:         if (models.length > 0) {\n236:             // A provider may list the same model twice, once as a routed object\n237:             // and once as a bare string (OpenRouter does). The backend resolves\n238:             // a name to the first entry that matches, so a second option with\n239:             // the same value is unreachable: it silently applies the first\n240:             // entry's routing. Keep the first occurrence so the dropdown agrees\n241:             // with what the backend will actually use.\n242:             const seen = new Set();\n243:             models.forEach(model => {\n244:                 const modelValue = typeof model === 'string' ? model : model?.modelName;\n245:                 if (modelValue) {\n246:                     if (seen.has(modelValue)) return;\n247:                     seen.add(modelValue);\n248:                 }\n249: \n250:                 const option = document.createElement('option');\n251: \n252:                 // Handle both string models and object models with routing\n253:                 if (typeof model === 'string') {\n254:                     // Simple string model - use as both value and display text\n255:                     option.value = model;\n256:                     option.textContent = model;\n257:                 } else if (typeof model === 'object' && model.modelName) {\n258:                     // Complex object model with routing - use modelName as value and description as display\n259:                     option.value = model.modelName;\n260:                     option.textContent = model.description || model.modelName;\n261:                 } else {\n262:                     // Fallback for unexpected model format\n263:                     console.warn('Unexpected model format:', model);\n264:                     return; // Skip this model\n265:                 }\n266:                 \n267:                 selectElement.appendChild(option);\n268:             });\n269:             selectElement.disabled = false;\n270:         }\n271:     }\n272: \n273:     updateModelDropdown() {\n274:         const providerName = this.onboardingForm.providerSelect?.value;\n275:         const provider = this.aiProviders.find(p => p.name === providerName);\n276:         \n277:         // Use the smart helper function to populate the dropdown\n278:         this._populateModelDropdown(\n279:             provider?.models || [],\n280:             this.onboardingForm.modelSelect,\n281:             'Select Model'\n282:         );\n283:     }\n284: \n285:     updateSecondaryModelDropdown() {\n286:         const providerName = this.onboardingForm.secondaryProviderSelect?.value;\n287:         const provider = this.aiProviders.find(p => p.name === providerName);\n288:         \n289:         // Use the smart helper function to populate the dropdown\n290:         this._populateModelDropdown(\n291:             provider?.models || [],\n292:             this.onboardingForm.secondaryModelSelect,\n293:             'Select Secondary Model'\n294:         );\n295:     }\n296: \n297:     updateVisionModelDropdown() {\n298:         const providerName = this.onboardingForm.visionProviderSelect?.value;\n299:         const provider = this.aiProviders.find(p => p.name === providerName);\n300:         \n301:         // Use the smart helper function to populate the dropdown\n302:         this._populateModelDropdown(\n303:             provider?.visionModels || [],\n304:             this.onboardingForm.visionModelSelect,\n305:             'Select Vision Model'\n306:         );\n307:     }\n308: \n309:     updateSecondaryVisionModelDropdown() {\n310:         const providerName = this.onboardingForm.visionSecondaryProviderSelect?.value;\n311:         const provider = this.aiProviders.find(p => p.name === providerName);\n312:         \n313:         // Use the smart helper function to populate the dropdown\n314:         this._populateModelDropdown(\n315:             provider?.visionModels || [],\n316:             this.onboardingForm.visionSecondaryModelSelect,\n317:             'Select Secondary Vision Model'\n318:         );\n319:     }\n320: \n321:     async runPreFlightChecks() {\n322:         const state = this.stateManager.getState();\n323: \n324:         // Show/hide secondary checks based on selection\n325:         if (state.selectedSecondaryProvider.name && state.selectedSecondaryProvider.model) {\n326:             this.checks.aiSecondaryProvider.style.display = 'flex';\n327:             devLog('Secondary provider selected, will verify during preflight');\n328:         } else {\n329:             this.checks.aiSecondaryProvider.style.display = 'none';\n330:             devLog('No secondary provider selected, skipping verification');\n331:         }\n332: \n333:         if (state.selectedVisionProvider.name && state.selectedVisionProvider.model) {\n334:             this.checks.visionProvider.style.display = 'flex';\n335:             devLog('Primary vision provider selected, will verify during preflight');\n336:         } else {\n337:             this.checks.visionProvider.style.display = 'none';\n338:             devLog('No primary vision provider selected, skipping verification');\n339:         }\n340: \n341:         if (state.selectedSecondaryVisionProvider.name && state.selectedSecondaryVisionProvider.model) {\n342:             this.checks.visionSecondaryProvider.style.display = 'flex';\n343:             devLog('Secondary vision provider selected, will verify during preflight');\n344:         } else {\n345:             this.checks.visionSecondaryProvider.style.display = 'none';\n346:             devLog('No secondary vision provider selected, skipping verification');\n347:         }\n348: \n349:         // This is a new, separate step to verify the Deepgram key.\n350:         this.verifyDeepgram();\n351:         \n352:         await this.verifyAiProviders();\n353:     }\n354: \n355:     verifyDeepgram() {\n356:         devLog(\"➡️ [Pre-Flight] Requesting Deepgram API verification...\");\n357:         this.webSocketHandler.sendMessage('verify_deepgram', {});\n358:     }\n359: \n360:     async verifyAiProviders() {\n361:         const state = this.stateManager.getState();\n362: \n363:         // Verify primary provider (required)\n364:         await this.verifyProvider(state.selectedProvider, this.checks.aiProvider, 'Primary');\n365:         \n366:         // Verify secondary provider if selected (optional)\n367:         if (state.selectedSecondaryProvider.name && state.selectedSecondaryProvider.model) {\n368:             await this.verifyProvider(state.selectedSecondaryProvider, this.checks.aiSecondaryProvider, 'Secondary');\n369:         }\n370:         \n371:         // Verify vision provider if selected (optional)\n372:         if (state.selectedVisionProvider.name && state.selectedVisionProvider.model) {\n373:             await this.verifyVisionProvider(state.selectedVisionProvider, this.checks.visionProvider, 'Primary Vision');\n374:         }\n375:         \n376:         // Verify secondary vision provider if selected (optional)\n377:         if (state.selectedSecondaryVisionProvider.name && state.selectedSecondaryVisionProvider.model) {\n378:             await this.verifyVisionProvider(state.selectedSecondaryVisionProvider, this.checks.visionSecondaryProvider, 'Secondary Vision');\n379:         }\n380:         \n381:         // This was the missing piece. After all provider checks are complete,\n382:         // we must check if all systems are green to enable the start button.\n383:         this.webSocketHandler.checkAllSystemsGo();\n384:     }\n385: \n386:     async verifyProvider(providerConfig, checkElement, providerType) {\n387:         const { name, model } = providerConfig;\n388:         devLog(`➡️ [Pre-Flight] Verifying ${providerType} provider: ${name} (${model})`);\n389:         this.webSocketHandler.updateCheckStatus(checkElement, 'pending', `Checking ${providerType} ${name}...`);\n390:         \n391:         try {\n392:             const response = await fetch('/api/verify-provider', {\n393:                 method: 'POST',\n394:                 headers: { 'Content-Type': 'application/json' },\n395:                 body: JSON.stringify({ name, model }),\n396:             });\n397:             \n398:             const result = await response.json();\n399:             \n400:             if (result.success) {\n401:                 this.webSocketHandler.updateCheckStatus(checkElement, 'success', `${providerType} ${name} (${model}) OK`);\n402:                 devLog(`✅ [FRONTEND] Received and processed successful verification for ${providerType} provider: ${name}`);\n403:             } else {\n404:                 this.webSocketHandler.updateCheckStatus(checkElement, 'error', `${providerType} ${name} Connection Failed`);\n405:                 devLog(`❌ [FRONTEND] Received and processed failed verification for ${providerType} provider: ${name}`);\n406:             }\n407:         } catch (error) {\n408:             this.webSocketHandler.updateCheckStatus(checkElement, 'error', `${providerType} Provider Check Failed`);\n409:             console.error(`❌ ${providerType} provider check error:`, error);\n410:         }\n411:     }\n412: \n413:     handleApiKeyStatus({ service, valid }) {\n414:         devLog(`⬅️ [ProviderManager] Handling 'api_key_status' for ${service}. Valid: ${valid}`);\n415:         \n416:         if (service === 'deepgram') {\n417:             const checkElement = this.checks.deepgram;\n418:             const serviceName = \"Deepgram\";\n419:             if (valid) {\n420:                 this.webSocketHandler.updateCheckStatus(checkElement, 'success', `${serviceName} API OK`);\n421:             } else {\n422:                 this.webSocketHandler.updateCheckStatus(checkElement, 'error', `${serviceName} API Key Invalid`);\n423:             }\n424:             // Crucially, check all systems *after* the status has been updated.\n425:             this.webSocketHandler.checkAllSystemsGo();\n426:         }\n427:     }\n428: \n429:     async verifyVisionProvider(providerConfig, checkElement, providerType) {\n430:         const { name, model } = providerConfig;\n431:         devLog(`➡️ [Pre-Flight] Verifying ${providerType} provider: ${name} (${model})`);\n432:         this.webSocketHandler.updateCheckStatus(checkElement, 'pending', `Checking ${providerType} ${name}...`);\n433:         \n434:         try {\n435:             const response = await fetch('/api/verify-vision-provider', {\n436:                 method: 'POST',\n437:                 headers: { 'Content-Type': 'application/json' },\n438:                 body: JSON.stringify({ name, model }),\n439:             });\n440:             \n441:             const result = await response.json();\n442:             \n443:             if (result.success) {\n444:                 this.webSocketHandler.updateCheckStatus(checkElement, 'success', `${providerType} ${name} (${model}) OK`);\n445:                 devLog(`✅ [FRONTEND] Received and processed successful verification for ${providerType} vision provider: ${name}`);\n446:             } else {\n447:                 this.webSocketHandler.updateCheckStatus(checkElement, 'error', `${providerType} ${name} Connection Failed`);\n448:                 devLog(`❌ [FRONTEND] Received and processed failed verification for ${providerType} vision provider: ${name}`);\n449:             }\n450:         } catch (error) {\n451:             this.webSocketHandler.updateCheckStatus(checkElement, 'error', `${providerType} Provider Check Failed`);\n452:             console.error(`❌ ${providerType} provider check error:`, error);\n453:         }\n454:     }\n455: \n456:     checkAllSystemsGo() {\n457:         // Check all required systems\n458:         const requiredChecks = [\n459:             this.checks.micPermission,\n460:             this.checks.micSelection,\n461:             this.checks.backend,\n462:             this.checks.deepgram,\n463:             this.checks.aiProvider\n464:         ];\n465: \n466:         // Add optional checks that are visible (selected by user)\n467:         const optionalChecks = [\n468:             this.checks.aiSecondaryProvider,\n469:             this.checks.visionProvider,\n470:             this.checks.visionSecondaryProvider\n471:         ];\n472: \n473:         // Filter optional checks to only include visible ones\n474:         const visibleOptionalChecks = optionalChecks.filter(check =>\n475:             check && check.style.display !== 'none'\n476:         );\n477: \n478:         const allChecks = [...requiredChecks, ...visibleOptionalChecks];\n479: \n480:         // Check if all systems are green\n481:         const allSystemsGo = allChecks.every(check => {\n482:             if (!check) return false;\n483:             const indicator = check.querySelector('.indicator');\n484:             return indicator && indicator.textContent === '🟢';\n485:         });\n486: \n487:         // Enable/disable start button\n488:         const startButton = document.getElementById('start-interview-button');\n489:         if (startButton) {\n490:             startButton.disabled = !allSystemsGo;\n491:             devLog(`[checkAllSystemsGo] Start button ${allSystemsGo ? 'ENABLED' : 'DISABLED'}`);\n492:             \n493:             if (allSystemsGo) {\n494:                 devLog('🚀 All systems are GO! Interview can start.');\n495:             } else {\n496:                 // Log which checks are failing for debugging\n497:                 const failingChecks = allChecks.filter(check => {\n498:                     if (!check) return true;\n499:                     const indicator = check.querySelector('.indicator');\n500:                     return !indicator || indicator.textContent !== '🟢';\n501:                 }).map(check => check ? check.id : 'null');\n502:                 devLog(`❌ Systems not ready. Failing checks: ${failingChecks.join(', ')}`);\n503:             }\n504:         }\n505: \n506:         return allSystemsGo;\n507:     }\n508: }\nThe above content shows the entire, complete file contents of the requested file.\n"}
