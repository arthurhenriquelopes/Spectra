.appState.socket.readyState === WebSocket.OPEN) {\n578:             this.appState.socket.send(JSON.stringify({ \n579:                 type: 'get_system_status', \n580:                 payload: {} \n581:             }));\n582:         }\n583:     }\n584: \n585:     // Comprehensive state clearing for interview end\n586:     clearInterviewState() {\n587:         console.log('🧹 Clearing interview state...');\n588:         \n589:         // Reset vision mode completely\n590:         this.appState.visionMode = {\n591:             isActive: false,\n592:             screenshotQueue: [],\n593:             maxScreenshots: 4,\n594:             currentVisionProvider: 'primary',\n595:             lastSwitchTime: 0,\n596:             switchCooldown: 1000\n597:         };\n598: \n599:         // Clear preset and system status\n600:         this.appState.currentPreset = null;\n601:         this.appState.systemStatus = null;\n602: \n603:         // Reset timers and debouncing\n604:         this.lastVisionToggleTime = 0;\n605:         this.lastScreenshotTime = 0;\n606: \n607:         // Clear screenshot service\n608:         if (window.screenshotService) {\n609:             screenshotService.clearQueue();\n610:             screenshotService.showVisionMode(false);\n611:         }\n612: \n613:         // Reset mute manager\n614:         if (window.muteManager) {\n615:             muteManager.setMicrophoneMute(false);\n616:             muteManager.setUniversalMute(false);\n617:         }\n618: \n619:         // Clear any pending vision analysis\n620:         if (window.visionAnalysisResolver) {\n621:             window.visionAnalysisResolver = null;\n622:         }\n623: \n624:         console.log('✅ Interview state cleared successfully');\n625:         return true;\n626:     }\n627: \n628:     // Reset to initial state (for complete restart)\n629:     resetToInitialState() {\n630:         console.log('🔄 Resetting to initial state...');\n631:         \n632:         // Clear interview state first\n633:         this.clearInterviewState();\n634: \n635:         // Clear socket reference (but don't close it here - let WebSocketHandler handle that)\n636:         this.appState.socket = null;\n637: \n638:         // Keep onboarding data and provider selections intact\n639:         // This allows user to restart interview without re-entering data\n640:         \n641:         console.log('✅ Reset to initial state complete');\n642:         return true;\n643:     }\n644: } \nThe above content shows the entire, complete file contents of the requested file.\n"}
