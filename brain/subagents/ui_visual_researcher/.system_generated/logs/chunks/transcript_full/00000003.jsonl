{"step_index":44,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-08-21T21:52:12Z","content":"Created At: 2026-08-21T18:52:12-03:00\nCompleted At: 2026-08-21T18:52:12-03:00\nFile Path: `file:///c:/Users/Arthur%20Henrique/Documents/GitHub/Spectra/web/js/streaming-markdown-parser.js`\nTotal Lines: 369\nTotal Bytes: 15222\nShowing lines 1 to 369\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: // Real-Time Streaming Markdown Parser\n2: // Integrates with existing MarkdownProcessor for incremental rendering\n3: \n4: import { MarkdownProcessor } from './markdown-processor.js';\n5: \n6: export class StreamingMarkdownParser {\n7:     constructor() {\n8:         // Use the existing comprehensive markdown processor\n9:         this.markdownProcessor = new MarkdownProcessor();\n10:         this.reset();\n11:         \n12:         // Simple patterns for detecting completable elements during streaming\n13:         this.patterns = {\n14:             // When to trigger re-processing\n15:             headerComplete: /^#{1,6}\\s+.*\\n/,\n16:             codeBlockBoundary: /^```/,\n17:             listItem: /^(\\s*)([-*+]|\\d+\\.)\\s+/,\n18:             paragraphBreak: /\\n\\s*\\n/,\n19:             inlineComplete: /(\\*\\*[^*]+\\*\\*|`[^`]+`|\\[[^\\]]+\\]\\([^)]+\\))/\n20:         };\n21:         \n22:         // Thinking content filter regex\n23:         this.thinkingRegex = /<think\\s*>[\\s\\S]*?<\\/think\\s*>/gi;\n24:     }\n25: \n26:     reset() {\n27:         // Clear all state for new response\n28:         this.buffer = '';\n29:         this.lastProcessedContent = '';\n30:         this.processedLength = 0;\n31:         this.lastRenderedHTML = '';\n32:         // Raw (unescaped) code-block bodies, keyed by block id, so the copy\n33:         // button can read them from JS instead of being inlined into markup.\n34:         this.codeBlockSources = new Map();\n35:     }\n36: \n37:     /**\n38:      * Process a new chunk and return updated HTML\n39:      * @param {string} chunk - New text chunk\n40:      * @returns {string} - Complete HTML content\n41:      */\n42:     processChunk(chunk) {\n43:         this.buffer += chunk;\n44:         \n45:         // Determine if we should re-process based on content changes\n46:         const shouldProcess = this.shouldReprocess();\n47:         \n48:         if (shouldProcess) {\n49:             return this.processBuffer();\n50:         } else {\n51:             // Return last rendered content + new raw content\n52:             return this.getIncrementalHTML();\n53:         }\n54:     }\n55: \n56:     /**\n57:      * Determine if we should reprocess the entire buffer\n58:      */\n59:     shouldReprocess() {\n60:         const newContent = this.buffer.slice(this.processedLength);\n61:         \n62:         // Reprocess if we detect completed markdown elements\n63:         if (\n64:             this.patterns.headerComplete.test(newContent) ||         // Complete header\n65:             this.patterns.codeBlockBoundary.test(newContent) ||      // Code block boundary\n66:             this.patterns.paragraphBreak.test(newContent) ||         // Paragraph break\n67:             this.patterns.inlineComplete.test(newContent) ||         // Complete inline formatting\n68:             newContent.includes('\\n- ') ||                          // List item\n69:             newContent.includes('\\n* ') ||                          // List item\n70:             newContent.includes('\\n1. ') ||                         // Numbered list\n71:             newContent.includes('**') ||                            // Bold formatting\n72:             newContent.includes('`') ||                             // Code formatting\n73:             newContent.includes('[') ||                             // Link start\n74:             newContent.includes('](')                               // Link completion\n75:         ) {\n76:             return true;\n77:         }\n78:         \n79:         // Also reprocess every 3-4 chunks to catch edge cases\n80:         return (this.buffer.length - this.processedLength) > 150;\n81:     }\n82: \n83:     /**\n84:      * Process the buffer using the existing MarkdownProcessor\n85:      */\n86:     processBuffer() {\n87:         try {\n88:             // Find the last complete section (avoid processing incomplete elements)\n89:             const processableContent = this.getProcessableContent();\n90:             \n91:             if (processableContent === this.lastProcessedContent) {\n92:                 // No new processable content, return incremental\n93:                 return this.getIncrementalHTML();\n94:             }\n95:             \n96:             // Process with existing markdown processor\n97:             const blocks = this.markdownProcessor.parseContent(processableContent);\n98:             let renderedHTML = '';\n99:             \n100:             // Generate HTML for each block\n101:             blocks.forEach(block => {\n102:                 const blockHTML = this.markdownProcessor.generateHTML(block);\n103:                 if (blockHTML !== null) {\n104:                     // Use generated HTML from markdown processor\n105:                     renderedHTML += blockHTML;\n106:                 } else if (block.type === 'code') {\n107:                     // Handle code blocks that return null\n108:                     renderedHTML += this.generateCodeBlockHTML(block);\n109:                 }\n110:             });\n111:             \n112:             // Update state\n113:             this.lastProcessedContent = processableContent;\n114:             this.processedLength = processableContent.length;\n115:             this.lastRenderedHTML = renderedHTML;\n116:             \n117:             return this.getIncrementalHTML();\n118:             \n119:         } catch (error) {\n120:             console.warn('🔍 Markdown processing error:', error);\n121:             // Fallback to simple HTML escaping\n122:             return this.getSimpleFallback();\n123:         }\n124:     }\n125: \n126:     /**\n127:      * Get content that's safe to process (avoid incomplete elements)\n128:      */\n129:     getProcessableContent() {\n130:         let content = this.buffer;\n131:         \n132:         // Don't process if we're potentially in the middle of a code block\n133:         const codeBlockMatches = content.match(/```/g);\n134:         if (codeBlockMatches && codeBlockMatches.length % 2 === 1) {\n135:             // Odd number of ``` means we're inside a code block\n136:             const lastCodeBlock = content.lastIndexOf('```');\n137:             content = content.substring(0, lastCodeBlock);\n138:         }\n139:         \n140:         // Don't process incomplete inline formatting\n141:         const lastAsterisk = content.lastIndexOf('**');\n142:         const lastBacktick = content.lastIndexOf('`');\n143:         const lastBracket = content.lastIndexOf('[');\n144:         \n145:         // If there's an opening marker without a close, truncate\n146:         if (lastAsterisk > -1 && !content.slice(lastAsterisk + 2).includes('**')) {\n147:             content = content.substring(0, lastAsterisk);\n148:         }\n149:         \n150:         if (lastBacktick > -1 && !content.slice(lastBacktick + 1).includes('`')) {\n151:             content = content.substring(0, lastBacktick);\n152:         }\n153:         \n154:         if (lastBracket > -1 && !content.slice(lastBracket).includes('](')) {\n155:             content = content.substring(0, lastBracket);\n156:         }\n157:         \n158:         // Filter thinking content AFTER determining safe content boundaries\n159:         content = this.filterThinkingContent(content);\n160:         \n161:         return content;\n162:     }\n163: \n164:     /**\n165:      * Get incremental HTML (rendered + pending)\n166:      */\n167:     getIncrementalHTML() {\n168:         const pendingContent = this.buffer.slice(this.processedLength);\n169:         \n170:         if (pendingContent.trim()) {\n171:             // Filter thinking content from pending content\n172:             const filteredPending = this.filterThinkingContent(pendingContent);\n173:             if (filteredPending.trim()) {\n174:                 const escapedPending = this.escapeHtml(filteredPending);\n175:                 return this.lastRenderedHTML + `<span class=\"pending-text\" style=\"margin:0;padding:0;\">${escapedPending}</span>`;\n176:             }\n177:         }\n178:         \n179:         return this.lastRenderedHTML;\n180:     }\n181: \n182:     /**\n183:      * Simple fallback when processing fails\n184:      */\n185:     getSimpleFallback() {\n186:         const filteredBuffer = this.filterThinkingContent(this.buffer);\n187:         return `<p class=\"markdown-paragraph\" style=\"margin:0;padding:0;\">${this.escapeHtml(filteredBuffer)}</p>`;\n188:     }\n189: \n190:     /**\n191:      * Generate HTML for code blocks (when MarkdownProcessor returns null)\n192:      */\n193:     generateCodeBlockHTML(block) {\n194:         const language = block.language || 'javascript';\n195:         const content = this.escapeHtml(block.content);\n196:         const blockId = `code-block-${Date.now()}-${Math.random().toString(36).substr(2, 9)}`;\n197:         \n198:         // Keep the raw body in JS rather than inlining it into an onclick handler.\n199:         this.codeBlockSources.set(blockId, block.content);\n200: \n201:         // Generate code block with proper padding and spacing\n202:         const html = `<div class=\"code-block-container\" data-block-id=\"${blockId}\" style=\"margin:0.75rem 0!important;padding:0!important;max-width:100%!important;overflow-x:hidden!important;word-wrap:break-word!important;border-radius:6px!important;\"><div class=\"code-block-header\" style=\"padding:0.4rem 1.25rem!important;\"><span class=\"code-language\">${language}</span><button class=\"copy-button\" type=\"button\" title=\"Copy code\">📋</button></div><pre class=\"code-block language-${language}\" style=\"padding:1rem 1.25rem!important;margin:0!important;\"><code class=\"language-${language}\">${content}</code></pre></div>`;\n203: \n204:         // Schedule syntax highlighting and copy-button wiring for this block\n205:         setTimeout(() => {\n206:             this.applySyntaxHighlighting(blockId);\n207:             this.attachCopyHandler(blockId);\n208:         }, 10);\n209: \n210:         return html;\n211:     }\n212: \n213:     /**\n214:      * Wire the copy button for a rendered code block.\n215:      *\n216:      * The handler closes over the raw source instead of being written into an\n217:      * onclick attribute: the previous inline form interpolated model-generated\n218:      * code into a JS template literal inside HTML, so any code containing a\n219:      * backtick or ${...} broke the button and could execute arbitrary script.\n220:      */\n221:     attachCopyHandler(blockId) {\n222:         try {\n223:             const blockElement = document.querySelector(`[data-block-id=\"${blockId}\"]`);\n224:             if (!blockElement) return;\n225: \n226:             const button = blockElement.querySelector('.copy-button');\n227:             if (!button || button.dataset.copyBound === 'true') return;\n228: \n229:             const source = this.codeBlockSources.get(blockId) || '';\n230:             button.dataset.copyBound = 'true';\n231:             button.addEventListener('click', async () => {\n232:                 try {\n233:                     await navigator.clipboard.writeText(source);\n234:                     button.textContent = '✅';\n235:                 } catch (err) {\n236:                     console.warn('🔍 Copy failed:', err);\n237:                     button.textContent = '❌';\n238:                 }\n239:                 setTimeout(() => { button.textContent = '📋'; }, 2000);\n240:             });\n241:         } catch (error) {\n242:             console.warn('🔍 Copy button wiring error:', error);\n243:         }\n244:     }\n245:     \n246:     /**\n247:      * Apply Prism.js syntax highlighting to a specific code block\n248:      */\n249:     applySyntaxHighlighting(blockId) {\n250:         try {\n251:             const blockElement = document.querySelector(`[data-block-id=\"${blockId}\"]`);\n252:             if (blockElement && window.Prism) {\n253:                 const codeElement = blockElement.querySelector('code');\n254:                 if (codeElement) {\n255:                     window.Prism.highlightElement(codeElement);\n256:                     console.log('🎨 Applied syntax highlighting to code block');\n257:                 }\n258:             }\n259:         } catch (error) {\n260:             console.warn('🔍 Syntax highlighting error:', error);\n261:         }\n262:     }\n263:     \n264:     /**\n265:      * Apply syntax highlighting to all code blocks in streaming content\n266:      */\n267:     highlightAllCodeBlocks() {\n268:         try {\n269:             if (window.Prism) {\n270:                 const codeBlocks = document.querySelectorAll('.code-block-container code[class*=\"language-\"]');\n271:                 codeBlocks.forEach(codeElement => {\n272:                     window.Prism.highlightElement(codeElement);\n273:                 });\n274:                 if (codeBlocks.length > 0) {\n275:                     console.log(`🎨 Applied syntax highlighting to ${codeBlocks.length} code blocks`);\n276:                 }\n277:             }\n278:         } catch (error) {\n279:             console.warn('🔍 Syntax highlighting error:', error);\n280:         }\n281:     }\n282: \n283:     /**\n284:      * Get the final rendered content (for when streaming completes)\n285:      */\n286:     finalize() {\n287:         // Apply final thinking content filter to buffer\n288:         this.buffer = this.filterThinkingContent(this.buffer);\n289:         \n290:         // Process the entire buffer one final time\n291:         try {\n292:             const blocks = this.markdownProcessor.parseContent(this.buffer);\n293:             let finalHTML = '';\n294:             \n295:             // Generate HTML for each block using the full markdown processor\n296:             blocks.forEach(block => {\n297:                 const blockHTML = this.markdownProcessor.generateHTML(block);\n298:                 if (blockHTML !== null) {\n299:                     // Use generated HTML from markdown processor\n300:                     finalHTML += blockHTML;\n301:                 } else if (block.type === 'code') {\n302:                     // Handle code blocks that return null\n303:                     finalHTML += this.generateCodeBlockHTML(block);\n304:                 }\n305:             });\n306:             \n307:             // Apply syntax highlighting to all code blocks after finalization\n308:             setTimeout(() => this.highlightAllCodeBlocks(), 50);\n309:             \n310:             return finalHTML;\n311:             \n312:         } catch (error) {\n313:             console.warn('🔍 Final markdown processing error:', error);\n314:             // Fallback to simple processing\n315:             return `<p class=\"markdown-paragraph\">${this.escapeHtml(this.buffer)}</p>`;\n316:         }\n317:     }\n318: \n319:     /**\n320:      * Filter thinking content from text\n321:      * @param {string} content - Text content to filter\n322:      * @returns {string} - Filtered content without thinking tags\n323:      */\n324:     filterThinkingContent(content) {\n325:         if (!content || typeof content !== 'string') {\n326:             return content;\n327:         }\n328:         \n329:         const originalLength = content.length;\n330:         \n331:         // Remove content between <think> and </think> tags (case insensitive, multiline)\n332:         // But preserve surrounding whitespace structure\n333:         let filteredContent = content.replace(this.thinkingRegex, (match, offset, string) => {\n334:             // Check if the thinking block is on its own line(s)\n335:             const beforeMatch = string.substring(0, offset);\n336:             const afterMatch = string.substring(offset + match.length);\n337:             \n338:             const beforeEndsWithNewline = beforeMatch.endsWith('\\n') || beforeMatch.endsWith('\\n\\n');\n339:             const afterStartsWithNewline = afterMatch.startsWith('\\n') || afterMatch.startsWith('\\n\\n');\n340:             \n341:             // If the thinking block is on its own line, preserve one newline\n342:             if (beforeEndsWithNewline && afterStartsWithNewline) {\n343:                 return '\\n';\n344:             }\n345:             // If it's inline, just remove it\n346:             return '';\n347:         });\n348:         \n349:         // Only clean up excessive newlines (3 or more consecutive), preserve normal paragraph breaks\n350:         filteredContent = filteredContent.replace(/\\n{3,}/g, '\\n\\n');\n351:         \n352:         // Log if thinking content was filtered (only for significant changes to avoid spam)\n353:         if (originalLength !== filteredContent.length && originalLength - filteredContent.length > 10) {\n354:             console.log(`🧠 StreamingParser filtered thinking content: ${originalLength} → ${filteredContent.length} chars`);\n355:         }\n356:         \n357:         return filteredContent;\n358:     }\n359: \n360:     escapeHtml(text) {\n361:         if (!text) return '';\n362:         return text\n363:             .replace(/&/g, '&amp;')\n364:             .replace(/</g, '&lt;')\n365:             .replace(/>/g, '&gt;')\n366:             .replace(/\"/g, '&quot;')\n367:             .replace(/'/g, '&#039;');\n368:     }\n369: } \nThe above content shows the entire, complete file contents of the requested file.\n"}
