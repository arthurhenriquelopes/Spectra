!this.appState.visionMode.isActive) {\n489:             console.warn('⚠️ Screenshot queue can only be reset in vision mode - use Alt+V to enter vision mode first');\n490:             if (window.presetManager) {\n491:                 presetManager.showErrorNotification('Enter vision mode first (Alt+V) before resetting screenshot queue');\n492:             } else {\n493:                 alert('Enter vision mode first (Alt+V) before resetting screenshot queue');\n494:             }\n495:             return false;\n496:         }\n497:         \n498:         console.log('🗑️ Resetting screenshot queue via global hotkey');\n499:         screenshotService.clearQueue();\n500:         return true;\n501:     }\n502: \n503:     // Audio Toggle Functions\n504:     toggleMicMute() {\n505:         console.log('🎮 toggleMicMute called (could be from global hotkey)');\n506:         \n507:         if (!this.isLiveInterviewActive()) {\n508:             console.warn('⚠️ Microphone mute only available during live interview');\n509:             if (window.presetManager) {\n510:                 presetManager.showErrorNotification('Start the interview first before using microphone controls');\n511:             } else {\n512:                 alert('Please start the interview before using microphone controls');\n513:             }\n514:             return false;\n515:         }\n516:         \n517:         if (window.muteManager) {\n518:             const currentStatus = muteManager.getMuteStatus();\n519:             const newMicStatus = !currentStatus.microphone;\n520:             muteManager.setMicrophoneMute(newMicStatus);\n521:             \n522:             const status = newMicStatus ? 'muted' : 'unmuted';\n523:             console.log(`🎤 Microphone ${status} via global hotkey`);\n524:             \n525:             if (window.presetManager) {\n526:                 presetManager.showSwitchNotification({\n527:                     message: `Microphone ${status}`,\n528:                   