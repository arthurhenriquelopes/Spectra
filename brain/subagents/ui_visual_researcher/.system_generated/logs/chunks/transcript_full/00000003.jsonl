}\n197: \n198:     handleApiKeyStatus(payload) {\n199:         // This is the crucial fix: Delegate the UI update to the ProviderManager,\n200:         // which now has a direct, guaranteed reference.\n201:         if (this.providerManager) {\n202:             this.providerManager.handleApiKeyStatus(payload);\n203:         } else {\n204:             console.error(\"Fatal Error: ProviderManager not injected into WebSocketHandler.\");\n205:         }\n206:     }\n207: \n208:     handleTranscriptUpdate(payload) {\n209:         // With diarization disabled, all speech comes from speaker 0 and should be labeled as Interviewer\n210:         // With diarization enabled, speaker 0 = candidate, speaker 1+ = interviewer(s)\n211:         const speakerId = payload.speaker !== undefined ? payload.speaker : 0;\n212:         \n213:         // Since diarization is disabled, all speech (speaker 0) should be treated as interviewer\n214:         if (payload.is_final) {\n215:             liveInterviewUI.addInterviewerQuestion(payload.transcript, false);\n216:         } else {\n217:             liveInterviewUI.addInterviewerQuestion(payload.transcript, true);\n218:         }\n219:     }\n220:     \n221:     handleAiProcessingStarted(payload) {\n222:         liveInterviewUI.startStreamingAIResponse(payload);\n223:     }\n224: \n225:     handleAiAnswerChunk(payload) {\n226:         liveInterviewUI.appendStreamingChunk(payload.chunk);\n227:     }\n228: \n229:     handleAiAnswerComplete(payload) {\n230:         liveInterviewUI.finalizeStreamingResponse(payload);\n231:     }\n232: \n233:     handlePresetInitialized(payload) {\n234:         this.stateManager.updateState({\n235:             currentPreset: payload.current_preset,\n236:             availablePresets: payload.available_presets\n237:         });\n238:         if (window.presetManager) {\n239:             presetManager.updatePresetDisplay(payload.current_preset);\n240:             presetManager.updateHealthStatus(payload.health_stat