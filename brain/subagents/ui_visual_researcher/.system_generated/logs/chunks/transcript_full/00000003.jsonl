             console.error('Failed to load advanced config data:', error);\n40:         }\n41:     }\n42: \n43:     setupEventListeners() {\n44:         if (this.elements.saveDeepgramBtn) {\n45:             this.elements.saveDeepgramBtn.addEventListener('click', () => this.saveDeepgramKey());\n46:         }\n47: \n48:         if (this.elements.saveProvidersBtn) {\n49:             this.elements.saveProvidersBtn.addEventListener('click', () => this.saveProviders());\n50:         }\n51:     }\n52: \n53:     renderProviders() {\n54:         if (!this.elements.providersList) return;\n55: \n56:         this.elements.providersList.innerHTML = '';\n57: \n58:         this.providers.forEach((provider, pIndex) => {\n59:             const tr = document.createElement('tr');\n60: \n61:             // Name Cell\n62:             const nameTd = document.createElement('td');\n63:             nameTd.innerHTML = `<strong>${provider.name}</strong><br><small>${provider.baseURL}</small>`;\n64:             tr.appendChild(nameTd);\n65: \n66:             // Keys Cell\n67:             const keysTd = document.createElement('td');\n68:             const keyListDiv = document.createElement('div');\n69:             keyListDiv.className = 'key-list';\n70: \n71:             const apiKeys = provider.apiKeys || [provider.apiKey || ''];\n72: \n73:             apiKeys.forEach((key, kIndex) => {\n74:                 const group = document.createElement('div');\n75:                 group.className = 'key-input-group';\n76: \n77:                 const input = document.createElement('input');\n78:                 input.type = 'password';\n79:                 input.value = key;\n80:                 input.placeholder = `API Key ${kIndex + 1}`;\n81:                 input.addEventListener('input', (e) => {\n82:                     if (provider.apiKeys) {\n83:                         provider.apiKeys[kIndex] = e.target.value;\n84:                     } else {\n85:                         provider.apiKey = e.target.value;\n86:                     }\n87:                 });\n88: \n89:                 group.appendChild(input);\n90: \n91:                 if (apiKeys.length > 1 || provider.apiKeys) {\n92:                     const removeBtn = document.createElement('button');\n93:                     removeBtn.className = 'remove-key-btn';\n94:                     removeBtn.textContent = '×';\n95:                     removeBtn.title = 'Remove key';\n96:                     removeBtn.onclick = () => {\n97:                         if (provider.apiKeys) {\n98:                             provider.apiKeys.splice(kIndex, 1);\n99:                         } else {\n100:                             provider.apiKeys = []; // Convert to array if removing the last single key\n101:                         }\n102:                         this.renderProviders();\n103:                     };\n104:                     group.appendChild(removeBtn);\n105:                 }\n106: \n107:                 keyListDiv.appendChild(group);\n108:             });\n109: \n110:             const addKeyBtn = document.createElement('button');\n111:             addKeyBtn.className = 'add-key-btn';\n112:             addKeyBtn.textContent = '+';\n113:             addKeyBtn.title = 'Add API key for rotation';\n114:             addKeyBtn.onclick = () => {\n115:                 if (!provider.apiKeys) {\n116:                     provider.apiKeys = [provider.apiKey || ''];\n117:                     delete provider.apiKey;\n118:                 }\n119:                 provider.apiKeys.push('');\n120:                 this.renderProviders();\n121:             };\n122: \n123:             keysTd.appendChild(keyListDiv);\n124:             keysTd.appendChild(addKeyBtn);\n125:             tr.appendChild(keysTd);\n126: \n127:             // Actions Cell\n128:             const actionsTd = document.createElement('td');\n129:             const testBtn = document.createElement('button');\n130:             testBtn.className = 'save-small';\n131:             testBtn.textContent = 'Test Connection';\n132:             testBtn.onclick = () => this.testProviderConnection(provider, testBtn);\n133:             actionsTd.appendChild(testBtn);\n134:             tr.appendChild(actionsTd);\n135: \n136:             this.elements.providersList.appendChild(tr);\n137:         });\n138:     }\n139: \n140:     async testProviderConnection(provider, btn) {\n141:         const originalText = btn.textContent;\n142:         btn.textContent = 'Testing...';\n143:         btn.disabled = true;\n144: \n145:         try {\n146:             // Use the first key for test\n147:             const testKey = provider.apiKeys ? provider.apiKeys[0] : provider.apiKey;\n148:             const testModel = provider.defaultModel || (provider.models[0]?.modelName || provider.models[0]);\n149: \n150:             if (!testKey) {\n151:                 alert('Please enter an API key first');\n152:                 btn.textContent = originalText;\n153:                 btn.disabled = false;\n154:                 return;\n155:             }\n156: \n157:             const response = await fetch('/api/verify-provider', {\n158:                 method: 'POST',\n159:                 headers: { 'Content-Type': 'application/json' },\n160:                 body: JSON.stringify({\n161:                     name: provider.name,\n162:                     model: testModel\n163:                 }),\n164:             });\n165: \n166:             const result = await response.json();\n167: \n168:             if (result.success) {\n169:                 btn.textContent = '✅ Success';\n170:                 btn.style.borderColor = 'var(--accent-success)';\n171:             } else {\n172:                 btn.textContent = '❌ Failed';\n173:                 btn.style.borderColor = 'var(--accent-warning)';\n174:             }\n175: \n176:             setTimeout(() => {\n177:                 btn.textContent = originalText;\n178:                 btn.disabled = false;\n179:                 btn.style.borderColor = '';\n180:             }, 3000);\n181: \n182:         } catch (error) {\n183:             console.error('Test failed:', error);\n184:             btn.textContent = 'Error';\n185:             setTimeout(() => {\n186:                 btn.textContent = originalText;\n187:                 btn.disabled = false;\n188:             }, 3000);\n189:         }\n190:     }\n191: \n192:     async saveDeepgramKey() {\n193:         const key = this.elements.deepgramKey.value;\n194:         const btn = this.elements.saveDeepgramBtn;\n195:         const originalText = btn.textContent;\n196: \n197:         btn.textContent = 'Saving...';\n198:         btn.disabled = true;\n199: \n200:         try {\n201:             const resp = await fetch('/api/save-deepgram-key', {\n202:                 method: 'POST',\n203:                 headers: { 'Content-Type': 'application/json' },\n204:                 body: JSON.stringify({ key })\n205:             });\n206: \n207:             if (resp.ok) {\n208:                 btn.textContent = '✅ Saved';\n209:                 devLog('Deepgram key saved successfully');\n210:             } else {\n211:                 btn.textContent = '❌ Failed';\n212:             }\n213: \n214:             setTimeout(() => {\n215:                 btn.textContent = originalText;\n216:                 btn.disabled = false;\n217:             }, 2000);\n218:         } catch (error) {\n219:             console.error('Save failed:', error);\n220:             btn.textContent = 'Error';\n221:             btn.disabled = false;\n222:         }\n223:     }\n224: \n225:     async saveProviders() {\n226:         const btn = this.elements.saveProvidersBtn;\n227:         const originalText = btn.textContent;\n228: \n229:         btn.textContent = 'Saving Configuration...';\n230:         btn.disabled = true;\n231: \n232:         try {\n233:             const resp = await fetch('/api/save-ai-providers', {\n234:                 method: 'P