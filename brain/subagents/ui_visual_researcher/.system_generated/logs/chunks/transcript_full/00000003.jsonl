{"step_index":46,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-08-21T21:52:15Z","content":"Created At: 2026-08-21T18:52:15-03:00\nCompleted At: 2026-08-21T18:52:15-03:00\nFile Path: `file:///c:/Users/Arthur%20Henrique/Documents/GitHub/Spectra/web/js/websocket-handler.js`\nTotal Lines: 400\nTotal Bytes: 16077\nShowing lines 1 to 400\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: import { devLog } from './config.js';\n2: import liveInterviewUI from './live-interview.js';\n3: \n4: export class WebSocketHandler {\n5:     constructor(stateManager) {\n6:         this.stateManager = stateManager;\n7:         this.socket = null;\n8:         this.providerManager = null; // Direct reference to the ProviderManager\n9:         this.session_id = null;\n10:         this.reconnect_attempts = 0;\n11:         this.max_reconnect_attempts = 5;\n12:         this.is_intentionally_closing = false;\n13:         this.checks = {};\n14:         this.initializeCheckElements();\n15:     }\n16: \n17:     initializeCheckElements() {\n18:         this.checks = {\n19:             micPermission: document.getElementById('check-mic-permission'),\n20:             micSelection: document.getElementById('check-mic-selection'),\n21:             backend: document.getElementById('check-backend'),\n22:             deepgram: document.getElementById('check-deepgram'),\n23:             aiProvider: document.getElementById('check-ai-provider'),\n24:             aiSecondaryProvider: document.getElementById('check-ai-secondary-provider'),\n25:             visionProvider: document.getElementById('check-vision-provider'),\n26:             visionSecondaryProvider: document.getElementById('check-vision-secondary-provider'),\n27:         };\n28:     }\n29: \n30:     connect() {\n31:         if (window.chrome && window.chrome.webview) {\n32:             console.log(\"🌐 Running in native C# WebView2 host\");\n33:             window.chrome.webview.addEventListener('message', (event) => {\n34:                 const data = typeof event.data === 'string' ? JSON.parse(event.data) : event.data;\n35:                 this.handleMessage(data);\n36:             });\n37:             this.isNativeHost = true;\n38:             this.updateCheckStatus(this.checks.backend, 'success', 'Native C# Host Connected');\n39:             return Promise.resolve();\n40:         }\n41: \n42:         return new Promise((resolve, reject) => {\n43:             this.is_intentionally_closing = false;\n44:             // Derive the host from the page origin. main.py picks a free port at\n45:             // startup and falls back off 8002 when it is busy, so a hardcoded port\n46:             // would break the socket exactly when the fallback kicks in.\n47:             const host = window.location.host || '127.0.0.1:8002';\n48:             const scheme = window.location.protocol === 'https:' ? 'wss:' : 'ws:';\n49:             let url = `${scheme}//${host}/ws`;\n50:             if (this.session_id) {\n51:                 url += `?session_id=${this.session_id}`;\n52:             }\n53: \n54:             this.updateCheckStatus(this.checks.backend, 'pending', 'Connecting...');\n55:             this.socket = new WebSocket(url);\n56:             this.stateManager.setSocket(this.socket);\n57: \n58:             // Store the promise's resolver to be called when session is confirmed.\n59:             this.resolveConnectionPromise = resolve;\n60: \n61:             // Clear any old listeners before attaching new ones\n62:             this.socket.onopen = null;\n63:             this.socket.onclose = null;\n64:             this.socket.onerror = null;\n65:             this.socket.onmessage = null;\n66:             \n67:             // Use addEventListener for all events for consistency and robustness.\n68:             this.socket.addEventListener('open', this.onOpen.bind(this));\n69:             this.socket.addEventListener('close', this.onClose.bind(this));\n70:             this.socket.addEventListener('error', (err) => {\n71:                 this.onError(err);\n72:                 reject(new Error(\"WebSocket connection failed.\"));\n73:             });\n74:             this.socket.addEventListener('message', this.onMessage.bind(this));\n75:         });\n76:     }\n77: \n78:     onOpen(event) {\n79:         console.log(\"[open] Connection established\");\n80:         // This is now handled by the ProviderManager\n81:         // this.updateCheckStatus(this.checks.backend, 'success', 'Backend Connected');\n82:         this.reconnect_attempts = 0;\n83:     }\n84: \n85:     onClose(event) {\n86:         console.log(`[close] Connection closed. Intentional: ${this.is_intentionally_closing}`);\n87:         // This is now handled by the ProviderManager\n88:         // this.updateCheckStatus(this.checks.backend, 'error', 'Disconnected');\n89:         if (!this.is_intentionally_closing) {\n90:             this.handleReconnect();\n91:         }\n92:     }\n93: \n94:     onError(error) {\n95:         console.error(`[error] WebSocket error:`, error);\n96:         // This is now handled by the ProviderManager\n97:         // this.updateCheckStatus(this.checks.backend, 'error', 'Connection Failed');\n98:     }\n99:     \n100:     onMessage(event) {\n101:         const data = JSON.parse(event.data);\n102:         devLog(\"Received from backend:\", data);\n103: \n104:         if (data.type === 'session_created') {\n105:             this.session_id = data.payload.session_id;\n106:             console.log(`🚀 New session started: ${this.session_id}`);\n107:             // Resolve the connection promise now that session is confirmed.\n108:             if (this.resolveConnectionPromise) {\n109:                 this.resolveConnectionPromise();\n110:                 this.resolveConnectionPromise