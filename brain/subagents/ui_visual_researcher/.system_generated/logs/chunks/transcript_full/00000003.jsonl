        // Plain text file\n205:                     const text = await file.text();\n206:                     resumeTextarea.value = text;\n207:                     statusSpan.textContent = `✅ ${file.name} loaded`;\n208:                     statusSpan.className = 'upload-status success';\n209:                 } else if (file.name.endsWith('.pdf')) {\n210:                     // PDF - extract text using basic approach\n211:                     const arrayBuffer = await file.arrayBuffer();\n212:                     const text = this._extractTextFromPDF(arrayBuffer);\n213:                     if (text && text.trim().length > 50) {\n214:                         resumeTextarea.value = text.trim();\n215:                         statusSpan.textContent = `✅ ${file.name} parsed`;\n216:                         statusSpan.className = 'upload-status success';\n217:                     } else {\n218:                         statusSpan.textContent = '⚠️ Could not parse PDF. Please paste text manually.';\n219:                         statusSpan.className = 'upload-status error';\n220:                     }\n221:                 }\n222:             } catch (err) {\n223:                 console.error('Resume upload error:', err);\n224:                 statusSpan.textContent = '❌ Error reading file';\n225:                 statusSpan.className = 'upload-status error';\n226:             }\n227:         });\n228:     }\n229:     \n230:     _extractTextFromPDF(arrayBuffer) {\n231:         // Lightweight PDF text extraction without external libraries.\n232:         // Works for most text-based PDFs (not scanned images).\n233:         try {\n234:             const bytes = new Uint8Array(arrayBuffer);\n235:             const text = new TextDecoder('utf-8', { fatal: false }).decode(bytes);\n236:             \n237:             // Extract text between BT...ET blocks (PDF text objects)\n238:             const textBlocks = [];\n239:             const btEtRegex = /BT\\s([\\s\\S]*?)\\s*ET/g;\n240:             let match;\n241:             \n242:             while ((match = btEtRegex.exec(text)) !== null) {\n243:                 const block = match[1];\n244:                 // Extract text from Tj and TJ operators\n245:                 const tjRegex = /\\(([^)]*?)\\)\\s*Tj/g;\n246:                 let tjMatch;\n247:                 while ((tjMatch = tjRegex.exec(block)) !== null) {\n248:                     textBlocks.push(tjMatch[1]);\n249:                 }\n250:                 // Extract from TJ arrays\n251:                 const tjArrayRegex = /\\[([^\\]]*)\\]\\s*TJ/g;\n252:                 let tjArrMatch;\n253:                 while ((tjArrMatch = tjArrayRegex.exec(block)) !== null) {\n254:                     const arrContent = tjArrMatch[1];\n255:                     const strRegex = /\\(([^)]*?)\\)/g;\n256:                     let strMatch;\n257:                     while ((strMatch = strRegex.exec(arrContent)) !== null) {\n258:                         textBlocks.push(strMatch[1]);\n259:                     }\n260:                 }\n261:             }\n262:             \n263:             // Decode PDF escape sequences\n264:             let result = textBlocks.join(' ')\n265:                 .replace(/\\\\n/g, '\\n')\n266:                 .replace(/\\\\r/g, '')\n267:                 .replace(/\\\\t/g, ' ')\n268:                 .replace(/\\\\\\(/g, '(')\n269:                 .replace(/\\\\\\)/g, ')')\n270:                 .replace(/\\\\{2}/g, '\\\\')\n271:                 .replace(/\\s{3,}/g, '\\n\\n')\n272:                 .replace(/  +/g, ' ');\n273:             \n274:             return result;\n275:         } catch (e) {\n276:             console.error('PDF extraction error:', e);\n277:             return '';\n278:         }\n279:     }\n280: \n281:     isLiveInterviewActive() {\n282:         const currentView = document.querySelector('.view.active');\n283:         return currentView && currentView.id === 'live-view';\n284:     }\n285: \n286:    