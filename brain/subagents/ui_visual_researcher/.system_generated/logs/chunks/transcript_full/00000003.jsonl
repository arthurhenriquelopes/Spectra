or(payload) {\n288:         console.error(\"WebSocket error:\", payload);\n289:         if (window.presetManager) {\n290:             presetManager.showErrorNotification(payload.message);\n291:         }\n292:     }\n293: \n294:     sendMessage(type, payload) {\n295:         if (window.chrome && window.chrome.webview) {\n296:             window.chrome.webview.postMessage({ type, payload });\n297:             return;\n298:         }\n299: \n300:         if (this.socket && this.socket.readyState === WebSocket.OPEN) {\n301:             this.socket.send(JSON.stringify({ type, payload }));\n302:         } else {\n303:             console.error(`Cannot send message ${type}: WebSocket not connected.`);\n304:         }\n305:     }\n306: \n307:     sendAudioChunk(chunk, is_muted) {\n308:         this.sendMessage('audio_chunk', {\n309:             audio_b64: this.bytesToBase64(chunk),\n310:             is_muted: is_muted\n311:         });\n312:     }\n313: \n314:     /**\n315:      * Base64-encode a PCM buffer for transport.\n316:      *\n317:      * Sending the raw bytes as a JSON array of integers cost roughly 4 bytes of\n318:      * text per byte of audio; base64 costs 1.33. Encoded in slices because\n319:      * String.fromCharCode.apply exceeds the argument limit on large buffers.\n320:      */\n321:     bytesToBase64(buffer) {\n322:         const bytes = new Uint8Array(buffer);\n323:         const SLICE = 0x8000;\n324:         let binary = '';\n325:         for (let i = 0; i < bytes.length; i += SLICE) {\n326:             binary += String.fromCharCode.apply(null, bytes.subarray(i, i + SLICE));\n327:         }\n328:         return btoa(binary);\n329:     }\n330: \n331:     startInterview() {\n332:         const state = this.stateManager.getState();\n333:         const initialMuteStatus = window.muteManager?.getMuteStatus() || { microphone: false, universal: false };\n334:         \n335:         const interviewPayload = {\n336:             aiProvider: {\n337:             