     \n943:             // Clear and update instantly using streaming module\n944:             contentDiv.innerHTML = '';\n945:             this.streaming.displayInstantText(contentDiv, content);\n946:         }\n947:     }\n948: \n949:     // Finalize candidate message (for final results)\n950:     finalizeCandidateMessage(content) {\n951:         if (this.currentCandidateElement) {\n952:             // Remove interim class to show typing animation for final result\n953:             this.currentCandidateElement.classList.remove('interim');\n954:             \n955:             const contentDiv = this.currentCandidateElement.querySelector('.streaming-text');\n956:             contentDiv.innerHTML = '';\n957:             \n958:             // Use streaming module for final content\n959:             this.streaming.streamContent(contentDiv, content, this.streaming.config.streamingSpeed).then(() => {\n960:                 if (this.currentCandidateElement) {\n961:                     this.currentCandidateElement.classList.add('complete');\n962:                 }\n963:             });\n964:             \n965:             // Clear the reference since this is final\n966:             this.currentCandidateElement = null;\n967:             \n968:             // Reset auto-scroll for new response\n969:             this.autoScrollEnabled = true;\n970:         }\n971:     }\n972: \n973:     // --- New Smart Scrolling System ---\n974: \n975:     setScrollMode(mode, targetElement = null) {\n976:         this.scrollState.mode = mode;\n977: \n978:         switch (mode) {\n979:             case 'live_bottom':\n980:                 this.scrollToBottom();\n981:                 break;\n982:             case 'ai_start':\n983:                 if (targetElement) {\n984:                     this.scrollState.aiResponseStartElement = targetElement;\n985:                     this.scrollToAiResponseStart();\n986:                 }\n987:                 break;\n988:             case 'user_reading':\n989:                 // In this mode, we don't trigger any automatic scrolling\n990:                 // but we mark that new content is pending\n991:                 this.scrollState.newContentPending = true;\n992:                 this.showResumeScrollButton();\n993:                 break;\n994:             case 'ai_streaming':\n995:                 // ai_streaming mode doesn't auto-scroll - lets user stay where they are\n996:                 // Just store the element reference for potential future use\n997:                 if (targetElement) {\n998:                     this.scrollState.aiResponseStartElement = targetElement;\n999:                 }\n1000:                 break;\n1001:             case 'ai_static':\n1002:                 // ai_static mode doesn't auto-scroll - AI response completed, maintain position\n1003:                 break;\n1004:         }\n1005:     }\n1006: \n1007:     scrollToBottom() {\n1008:         if (this.scrollState.userReadingMode) {\n1009:             // Don't interrupt user reading - just mark that new content is available\n1010:             this.scrollState.newContentPending = true;\n1011:             this.showResumeScrollButton();\n1012:             return;\n1013:         }\n1014:         if (this.conversationStream) {\n1015:             this.conversationStream.scrollTop = this.conversationStream.scrollHeight;\n1016:         }\n1017:     }\n1018: \n1019:     scrollToAiResponseStart() {\n1020:         if (this.scrollState.userReadingMode) {\n1021:             // Don't interrupt user reading - just mark that new content is available\n1022:             this.scrollState.newContentPending = true;\n1023:             this.showResumeScrollButton();\n1024:             return;\n1025:         }\n1026:         if (this.scrollState.aiResponseStartElement) {\n1027:             // A behavior passed to scrollIntoView wins over the CSS\n1028:             // scroll-behavior property, so the reduced-motion media query in\n1029:             // main.css cannot suppress this one. Check it here instead. This\n1030:             // fires on every AI response and animates the whole conversation\n1031:             // pane, making it the largest single movement in the overlay.\n1032:             const reduceMotion = window.matchMedia\n1033:                 && window.matchMedia('(prefers-reduced-motion: reduce)').matches;\n1034:             this.scrollState.aiResponseStartElement.scrollIntoView({\n1035:                 behavior: reduceMotion ? 'auto' : 'smooth',\n1036:                 block: 'start'\n1037:             });\n1038:         }\n1039:     }\n1040: \n1041:     // Start real-time streaming AI response\n1042:     startStreamingAIResponse(metadata = {}) {\n1043:         console.log('🚀 Starting real-time AI streaming with markdown parsing...');\n1044:         \n1045:         // If there's an existing streaming element, finalize it first\n1046:         if (this.currentStreamingElement) {\n1047:             console.log('📝 Finalizing previous response before starting new one');\n1048:             this.finalizeStreamingResponse({ forceFinalize: true });\n1049:         }\n1050:         \n1051:         // Reset markdown parser for new response\n1052:         this.markdownParser.reset();\n1053:         \n1054:         // Create NEW AI response element for each response\n1055:         this.currentStreamingElement = this.createMessageElement('', 'ai-response');\n1056:         this.conversationStream.appendChild(this.currentStreamingElement);\n1057:         \n1058:         // Get content div for streaming\n1059:         this.currentStreamingContent = this.currentStreamingElement.querySelector('.streaming-text');\n1060:         \n1061:         // Add streaming indicator (no cursor to avoid blinking issues)\n1062:         this.currentStreamingContent.innerHTML = '<span class=\"streaming-indicator\">🤖 Thinking...</span>';\n1063:         \n1064:         // Set scroll mode for real-time streaming\n1065:         this.setScrollMode('ai_streaming', this.currentStreamingElement);\n1066:         \n1067:         // Hide activity indicator\n1068:         this.hideActivity();\n1069:         this.updateEmptyState();\n1070:         \n1071:         console.log('✅ Real-time streaming with markdown parsing prepared for new response');\n1072:     }\n1073: \n1074:     // Append streaming chunk with real-time markdown processing\n1075:     appendStreamingChunk(chunk) {\n1076:         if (!this.currentStreamingElement || !this.currentStreamingContent) {\n1077:             console.warn('⚠️ No active streaming element for chunk');\n1078:             return;\n1079:         }\n1080:         \n1081:         // Remove streaming indicator on first chunk\n1082:         const indicator = this.currentStreamingContent.querySelector('.streaming-indicator');\n1083:         if (indicator) {\n1084:             indicator.remove();\n1085:         }\n1086:         \n1087:         // Process chunk through real-time markdown parser first (don't filter individual chunks)\n1088:         // The markdown parser will handle the thinking content filtering at the buffer level\n1089:         const renderedHTML = this.markdownParser.processChunk(chunk);\n1090:         \n1091:         // Update content with rendered HTML\n1092:         this.currentStreamingContent.innerHTML = renderedHTML;\n1093:         \n1094:         // Auto-scroll if user is near bottom\n1095:         if (this.isUserNearBottom()) {\n1096:             this.scrollToBottom();\n1097:         }\n1098:     }\n1099: \n1100:     // Finalize streaming response\n1101:     finalizeStreamingResponse(metadata = {}) {\n1102:         console.log('✅ Finalizing real-time streaming...');\n1103:         \n1104:         if (this.currentStreamingElement) {\n1105:             // Mark as complete (this will re-enable text selection via CSS)\n1106:             this.currentStreamingElement.classList.add('complete');\n1107:             \n1108:             // Only process content if not