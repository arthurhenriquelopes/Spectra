{"step_index":34,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-08-21T21:51:54Z","content":"Created At: 2026-08-21T18:51:54-03:00\nCompleted At: 2026-08-21T18:51:55-03:00\nFile Path: `file:///c:/Users/Arthur%20Henrique/Documents/GitHub/Spectra/web/js/screenshot-service.js`\nTotal Lines: 784\nTotal Bytes: 30947\nShowing lines 1 to 784\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: // Screenshot Service for Vision AI Processing\n2: // Handles screen capture, queue management, and vision model integration\n3: \n4: // Longest edge a capture is allowed to keep, in pixels. Chosen so that 1080p\n5: // and 1440p displays are never touched and only larger or multi-monitor\n6: // captures are scaled down. Raise it if you work on a 4K display and find\n7: // small text being missed; lower it to shrink payloads further.\n8: const MAX_CAPTURE_EDGE_PX = 2560;\n9: \n10: // Screenshots queued when the provider does not declare its own limit.\n11: const DEFAULT_MAX_SCREENSHOTS = 4;\n12: \n13: class ScreenshotService {\n14:     constructor() {\n15:         this.screenshotQueue = [];\n16:         this.maxScreenshots = DEFAULT_MAX_SCREENSHOTS;\n17:         this.isCapturing = false;\n18:         this.visionConfig = null;\n19:         this.programmingLanguages = [];\n20:         \n21:         this.setupUI();\n22:         this.setupStyles();\n23:         console.log('📸 ScreenshotService initialized');\n24:     }\n25:     \n26:     setupUI() {\n27:         // Create screenshot queue UI element\n28:         const queueContainer = document.createElement('div');\n29:         queueContainer.id = 'screenshot-queue';\n30:         queueContainer.className = 'screenshot-queue hidden';\n31:         queueContainer.innerHTML = `\n32:             <div class=\"queue-header\">\n33:                 <span class=\"queue-title\">📸 Screenshots Queue</span>\n34:                 <div class=\"queue-controls\">\n35:                     <button id=\"clear-queue-btn\" class=\"queue-btn clear\">Clear All</button>\n36:                     <button id=\"process-queue-btn\" class=\"queue-btn process\" disabled>Process (0)</button>\n37:                 </div>\n38:             </div>\n39:             <div class=\"queue-grid\" id=\"queue-grid\">\n40:                 <!-- Screenshots will be added here -->\n41:             </div>\n42:         `;\n43:         \n44:         // Store reference for later insertion\n45:         this.queueElement = queueContainer;\n46:         \n47:         // Setup event listeners\n48:         this.setupQueueEventListeners();\n49:     }\n50:     \n51:     setupQueueEventListeners() {\n52:         // Will be set up after DOM insertion\n53:     }\n54:     \n55:     insertQueueUI() {\n56:         const liveView = document.getElementById('live-view');\n57:         if (liveView && this.queueElement && !document.getElementById('screenshot-queue')) {\n58:             const interviewContent = liveView.querySelector('.interview-content');\n59:             if (interviewContent) {\n60:                 interviewContent.appendChild(this.queueElement);\n61:                 \n62:                 // Setup event listeners now that elements are in DOM\n63:                 document.getElementById('clear-queue-btn')?.addEventListener('click', () => {\n64:                     this.clearQueue();\n65:                 });\n66:                 \n67:                 document.getElementById('process-queue-btn')?.addEventListener('click', () => {\n68:                     this.processQueue();\n69:                 });\n70:                 \n71:                 console.log('✅ Screenshot queue UI added to live view');\n72:             }\n73:         }\n74:     }\n75:     \n76:     setupStyles() {\n77:         if (!document.getElementById('screenshot-service-styles')) {\n78:             const style = document.createElement('style');\n79:             style.id = 'screenshot-service-styles';\n80:             style.textContent = `\n81:                 .screenshot-queue {\n82:                     position: absolute;\n83:                     top: 10px;\n84:                     right: 10px;\n85:                     width: 320px;\n86:                     background: rgba(0, 0, 0, 0.95);\n87:                     border: 1px solid #333;\n88:                     border-radius: 8px;\n89:                     backdrop-filter: blur(15px);\n90:                     z-index: 1000;\n91:                     box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);\n92:                     transition: all 0.3s ease;\n93:                 }\n94:                 \n95:                 .screenshot-queue.hidden {\n96:                     opacity: 0;\n97:                     pointer-events: none;\n98:                     transform: translateY(-10px);\n99:                 }\n100:                 \n101:                 .queue-header {\n102:                     display: flex;\n103:                     justify-content: space-between;\n104:                     align-items: center;\n105:                     padding: 12px;\n106:                     border-bottom: 1px solid rgba(255, 255, 255, 0.1);\n107:                 }\n108:                 \n109:                 .queue-title {\n110:                     font-size: 12px;\n111:                     font-weight: 600;\n112:                     color: #ffffff;\n113:                 }\n114:                 \n115:                 .queue-controls {\n116:                     display: flex;\n117:                     gap: 6px;\n118:                 }\n119:                 \n120:                 .queue-btn {\n121:                     padding: 4px 8px;\n122:                     font-size: 10px;\n123:                     border: 1px solid #333;\n124:                     border-radius: 4px;\n125:                     background: rgba(255, 255, 255, 0.1);\n126:                     color: #ffffff;\n127:                     cursor: pointer;\n128:                     transition: all 0.2s ease;\n129:                 }\n130:                 \n131:                 .queue-btn:hover:not(:disabled) {\n132:                     background: rgba(255, 255, 255, 0.2);\n133:                     border-color: #555;\n134:                 }\n135:                 \n136:                 .queue-btn:disabled {\n137:                     opacity: 0.5;\n138:                     cursor: not-allowed;\n139:                 }\n140:                 \n141:                 .queue-btn.clear {\n142:                     border-color: #f56565;\n143:                     color: #f56565;\n144:                 }\n145:                 \n146:                 .queue-btn.clear:hover:not(:disabled) {\n147:                     background: rgba(245, 101, 101, 0.2);\n148:                 }\n149:                 \n150:                 .queue-btn.process {\n151:                     border-color: #48bb78;\n152:                     color: #48bb78;\n153:                 }\n154:                 \n155:                 .queue-btn.process:hover:not(:disabled) {\n156:                     background: rgba(72, 187, 120, 0.2);\n157:                 }\n158:                 \n159:                 .queue-grid {\n160:                     display: grid;\n161:                     grid-template-columns: 1fr 1fr;\n162:                     gap: 8px;\n163:                     padding: 12px;\n164:                     max-height: 240px;\n165:                     overflow-y: auto;\n166:                 }\n167:                 \n168:                 .screenshot-item {\n169:                     position: relative;\n170:                     border-radius: 4px;\n171:                     overflow: hidden;\n172:                     border: 1px solid rgba(255, 255, 255, 0.2);\n173:                     background: rgba(255, 255, 255, 0.05);\n174:                 }\n175:                 \n176:                 .screenshot-image {\n177:                     width: 100%;\n178:                     height: 80px;\n179:                     object-fit: cover;\n180:                     display: block;\n181:                 }\n182:                 \n183:                 .screenshot-info {\n184:                     padding: 6px;\n185:                     font-size: 9px;\n186:                     color: #a0aec0;\n187:                     text-align: center;\n188:                 }\n189:                 \n190:                 .screenshot-remove {\n191:                     position: absolute;\n192:                     top: 4px;\n193:                     right: 4px;\n194:                     width: 16px;\n195:                     height: 16px;\n196:                     background: rgba(245, 101, 101, 0.9);\n197:                     border: none;\n198:                     border-radius: 50%;\n199:                     color: white;\n200:                     font-size: 10px;\n201:                     cursor: pointer;\n202:                     display: flex;\n203:                     align-items: center;\n204:                     justify-content: center;\n205:                     transition: all 0.2s ease;\n206:                 }\n207:                 \n208:                 .screenshot-remove:hover {\n209:                     background: #f56565;\n210:                     transform: scale(1.1);\n211:                 }\n212:                 \n213:                 .vision-mode-indicator {\n214:                     position: fixed;\n215:                     top: 50%;\n216:                     left: 50%;\n217:                     transform: translate(-50%, -50%);\n218:                     background: rgba(0, 0, 0, 0.9);\n219:                     color: white;\n220:                     padding: 20px 30px;\n221:                     border-radius: 8px;\n222:                     border: 2px solid #6366f1;\n223:                     backdrop-filter: blur(15px);\n224:                     z-index: 10000;\n225:                     text-align: center;\n226:                     animation: fadeInScale 0.3s ease-out;\n227:                 }\n228:                 \n229:                 .vision-mode-content h3 {\n230:                     margin: 0 0 10px 0;\n231:                     color: #6366f1;\n232:                     font-size: 18px;\n233:                 }\n234:                 \n235:                 .vision-mode-content p {\n236:                     margin: 0 0 15px 0;\n237:                     color: #a0aec0;\n238:                     font-size: 14px;\n239:                 }\n240:                 \n241:                 .vision-hotkeys {\n242:                     display: flex;\n243:                     gap: 15px;\n244:                     justify-content: center;\n245:                 }\n246:                 \n247:                 .vision-hotkey {\n248:                     display: flex;\n249:                     flex-direction: column;\n250:                     align-items: center;\n251:                     gap: 5px;\n252:                 }\n253:                 \n254:                 .vision-hotkey kbd {\n255:                     background: #6366f1;\n256:                     color: white;\n257:                     padding: 4px 8px;\n258:                     border-radius: 4px;\n259:                     font-size: 11px;\n260:                     font-weight: 600;\n261:                 }\n262:                 \n263:                 .vision-hotkey span {\n264:                     font-size: 10px;\n265:                     color: #718096;\n266:                 }\n267:                 \n268:                 @keyframes fadeInScale {\n269:                     from {\n270:                         opacity: 0;\n271:                         transform: translate(-50%, -50%) scale(0.9);\n272:                     }\n273:                     to {\n274:                         opacity: 1;\n275:                         transform: translate(-50%, -50%) scale(1);\n276:                     }\n277:                 }\n278:                 \n279:                 .capture-notification {\n280:                     position: fixed;\n281:                     top: 20px;\n282:                     right: 20px;\n283:                     background: rgba(0, 0, 0, 0.9);\n284:                     color: white;\n285:                     padding: 12px 20px;\n286:                     border-radius: 6px;\n287:                     border-left: 4px solid #48bb78;\n288:                     z-index: 10000;\n289:                     animation: slideInRight 0.3s ease-out;\n290:                     /* Matches the preset and transparency toasts, which are both\n291:                        already click-through. Without this the toast swallows\n292:                        clicks in the top-right corner for its full 3s lifetime. */\n293:                     pointer-events: none;\n294:                 }\n295: \n296:                 /* showNotification() is called with 'error' for Permission Denied,\n297:                    Capture Timeout, Capture Failed, Queue Full, No Vision Model,\n298:                    Analysis Failed and Processing Error, and 'warning' for Queue\n299:                    Cleared, but every one of them inherited the success green. */\n300:                 .capture-notification.error {\n301:                     border-left-color: #f56565;\n302:                 }\n303: \n304:                 .capture-notification.warning {\n305:                     border-left-color: #ecc94b;\n306:                 }\n307: \n308:                 .capture-notification.info {\n309:                     border-left-color: #6366f1;\n310:                 }\n311:                 \n312:                 @keyframes slideInRight {\n313:                     from {\n314:                         transform: translateX(100%);\n315:                         opacity: 0;\n316:                     }\n317:                     to {\n318:                         transform: translateX(0);\n319:                         opacity: 1;\n320:                     }\n321:                 }\n322:             `;\n323:             document.head.appendChild(style);\n324:         }\n325:     }\n326:     \n327:     // Configuration methods\n328:     /**\n329:      * @param {number} [maxImages] Images this vision model accepts in one\n330:      *   request. Providers differ: Cerebras gemma-4-31b rejects a third image\n331:      *   with HTTP 413, while Gemini handles four. Without this the queue would\n332:      *   happily fill to 4 and then fail the whole batch at Alt+P.\n333:      */\n334:     setVisionConfig(visionProvider, visionModel, maxImages) {\n335:         this.visionConfig = {\n336:             provider: visionProvider,\n337:             model: visionModel\n338:         };\n339: \n340:         const cap = Number(maxImages) > 0 ? Math.floor(Number(maxImages)) : DEFAULT_MAX_SCREENSHOTS;\n341:         if (cap !== this.maxScreenshots) {\n342:             this.maxScreenshots = cap;\n343:             console.log(`🔧 Screenshot queue cap set to ${cap} for ${visionProvider} ${visionModel}`);\n344:             // Drop anything already queued beyond the new cap so Alt+P cannot\n345:             // send a batch this model will reject.\n346:             if (this.screenshotQueue.length > cap) {\n347:                 const dropped = this.screenshotQueue.length - cap;\n348:                 this.screenshotQueue = this.screenshotQueue.slice(0, cap);\n349:                 this.showNotification('📸 Queue Trimmed',\n350:                     `${visionModel} accepts ${cap} image${cap === 1 ? '' : 's'} per request - removed ${dropped}`, 'warning');\n351:             }\n352:             this.updateQueueUI();\n353:         }\n354: \n355:         console.log('🔧 Vision config set:', this.visionConfig);\n356:     }\n357:     \n358:     setProgrammingLanguages(languages) {\n359:         this.programmingLanguages = languages;\n360:         console.log('💻 Programming languages set:', this.programmingLanguages);\n361:     }\n362:     \n363:     // Screenshot capture methods\n364:     async captureScreenshot() {\n365:         if (this.isCapturing) {\n366:             console.log('⚠️ Screenshot capture already in progress');\n367:             return false;\n368:         }\n369:         \n370:         if (this.screenshotQueue.length >= this.maxScreenshots) {\n371:             this.showNotification('❌ Queue Full', 'Remove some screenshots before taking more', 'error');\n372:             return false;\n373:         }\n374:         \n375:         this.isCapturing = true;\n376:         \n377:         try {\n378:             // Try to use existing screen video track first\n379:             let videoTrack = null;\n380:             \n381:             // Import audio handler to get existing screen track\n382:             if (window.getScreenVideoTrack && window.isScreenSharingAvailable) {\n383:                 if (window.isScreenSharingAvailable()) {\n384:                     videoTrack = window.getScreenVideoTrack();\n385:                     console.log('📹 Using existing screen video track for screenshot');\n386:                 } else {\n387:                     console.warn('⚠️ Screen sharing not available, requesting new permission');\n388:                 }\n389:             }\n390:             \n391:             // Fallback to requesting new permission if no existing track\n392:             if (!videoTrack) {\n393:                 if (!navigator.mediaDevices || !navigator.mediaDevices.getDisplayMedia) {\n394:                     throw new Error('Screen capture not supported in this browser');\n395:                 }\n396:                 \n397:                 const stream = await navigator.mediaDevices.getDisplayMedia({\n398:                     video: {\n399:                         mediaSource: 'screen',\n400:                         width: { max: 1920 },\n401:                         height: { max: 1080 }\n402:                     }\n403:                 });\n404:                 \n405:                 videoTrack = stream.getVideoTracks()[0];\n406:                 if (!videoTrack) {\n407:                     throw new Error('No video track available from screen capture');\n408:                 }\n409:                 \n410:                 console.log('📹 Created new screen capture stream for screenshot');\n411:             }\n412:             \n413:             // Create video element to capture frame\n414:             const video = document.createElement('video');\n415:             video.srcObject = new MediaStream([videoTrack]);\n416:             video.play();\n417:             \n418:             // Wait for video to load\n419:             await new Promise((resolve, reject) => {\n420:                 video.onloadedmetadata = resolve;\n421:                 video.onerror = reject;\n422:                 // Add timeout to prevent hanging\n423:                 setTimeout(() => reject(new Error('Video load timeout')), 5000);\n424:             });\n425:             \n426:             // Create canvas and capture frame.\n427:             //\n428:             // The primary path reuses the display track opened by audio_handler,\n429:             // which is requested without size constraints, so videoWidth is the\n430:             // full native resolution. Capping the long edge bounds the payload on\n431:             // very large or multi-monitor captures, where four queued screenshots\n432:             // could otherwise approach a provider's request size limit.\n433:             //\n434:             // Verified on a 4512x3424 diagram: both Cerebras gemma-4-31b and\n435:             // Gemini 3.6 Flash extracted exactly the same text before and after\n436:             // downscaling, and Cerebras got 32% faster. Displays at or below the\n437:             // cap are untouched, so most users see no change at all.\n438:             const scale = Math.min(1, MAX_CAPTURE_EDGE_PX / Math.max(video.videoWidth, video.videoHeight));\n439:             const canvas = document.createElement('canvas');\n440:             canvas.width = Math.round(video.videoWidth * scale);\n441:             canvas.height = Math.round(video.videoHeight * scale);\n442: \n443:             const ctx = canvas.getContext('2d');\n444:             if (scale < 1) {\n445:                 ctx.imageSmoothingEnabled = true;\n446:                 ctx.imageSmoothingQuality = 'high';\n447:                 console.log(`📐 Capture scaled ${video.videoWidth}x${video.videoHeight} -> ${canvas.width}x${canvas.height}`);\n448:             }\n449:             ctx.drawImage(video, 0, 0, canvas.width, canvas.height);\n450:             \n451:             // Convert to blob\n452:             const blob = await new Promise(resolve => {\n453:                 canvas.toBlob(resolve, 'image/jpeg', 0.8);\n454:             });\n455:             \n456:             // Only stop the track if we created a new one (not reusing existing)\n457:             if (!window.getScreenVideoTrack || videoTrack !== window.getScreenVideoTrack()) {\n458:                 videoTrack.stop();\n459:                 console.log('📹 Stopped temporary screen capture track');\n460:             }\n461:             \n462:             // Clean up video element\n463:             video.srcObject = null;\n464:             \n465:             // Add to queue\n466:             const screenshot = {\n467:                 id: Date.now(),\n468:                 blob: blob,\n469:                 dataUrl: canvas.toDataURL('image/jpeg', 0.8),\n470:                 timestamp: new Date(),\n471:                 size: blob.size\n472:             };\n473:             \n474:             this.addToQueue(screenshot);\n475:             this.showNotification('📸 Screenshot Captured (Global)', `Added to queue (${this.screenshotQueue.length}/${this.maxScreenshots}) - Alt+P to process`, 'success');\n476:             \n477:             return true;\n478:             \n479:         } catch (error) {\n480:             console.error('❌ Screenshot capture failed:', error);\n481:             \n482:             if (error.name === 'NotAllowedError') {\n483:                 this.showNotification('❌ Permission Denied', 'Screen capture permission was denied', 'error');\n484:             } else if (error.message.includes('timeout')) {\n485:                 this.showNotification('❌ Capture Timeout', 'Screenshot capture took too long', 'error');\n486:             } else {\n487:                 this.showNotification('❌ Capture Failed', error.message, 'error');\n488:             }\n489:             \n490:             return false;\n491:         } finally {\n492:             this.isCapturing = false;\n493:         }\n494:     }\n495:     \n496:     // Queue management methods\n497:     addToQueue(screenshot) {\n498:         this.screenshotQueue.push(screenshot);\n499:         this.updateQueueUI();\n500:         console.log('📸 Screenshot added to queue:', screenshot.id);\n501:     }\n502:     \n503:     removeFromQueue(screenshotId) {\n504:         this.screenshotQueue = this.screenshotQueue.filter(s => s.id !== screenshotId);\n505:         this.updateQueueUI();\n506:         console.log('🗑️ Screenshot removed from queue:', screenshotId);\n507:     }\n508:     \n509:     clearQueue() {\n510:         this.screenshotQueue = [];\n511:         this.updateQueueUI();\n512:         this.showNotification('🗑️ Queue Cleared', 'All screenshots removed', 'warning');\n513:         console.log('🗑️ Screenshot queue cleared');\n514:     }\n515:     \n516:     updateQueueUI() {\n517:         const queueGrid = document.getElementById('queue-grid');\n518:         const processBtn = document.getElementById('process-queue-btn');\n519:         const queueTitle = document.querySelector('.queue-title');\n520:         \n521:         if (!queueGrid || !processBtn) return;\n522:         \n523:         // Update title to show current vision model\n524:         if (queueTitle && this.visionConfig) {\n525:             const currentProvider = window.appState?.visionMode?.currentVisionProvider || 'primary';\n526:             const providerType = currentProvider === 'primary' ? '1°' : '2°';\n527:             queueTitle.textContent = `📸 Vision Queue (${providerType} ${this.visionConfig.model})`;\n528:         }\n529:         \n530:         // Update process button\n531:         processBtn.textContent = `Process (${this.screenshotQueue.length})`;\n532:         processBtn.disabled = this.screenshotQueue.length === 0 || !this.visionConfig;\n533:         \n534:         // Update grid\n535:         queueGrid.innerHTML = '';\n536:         \n537:         this.screenshotQueue.forEach(screenshot => {\n538:             const item = document.createElement('div');\n539:             item.className = 'screenshot-item';\n540:             item.innerHTML = `\n541:                 <img src=\"${screenshot.dataUrl}\" alt=\"Screenshot\" class=\"screenshot-image\">\n542:                 <button class=\"screenshot-remove\" type=\"button\" title=\"Remove screenshot\">×</button>\n543:                 <div class=\"screenshot-info\">\n544:                     ${new Date(screenshot.timestamp).toLocaleTimeString()}\n545:                     <br>${this.formatFileSize(screenshot.size)}\n546:                 </div>\n547:             `;\n548:             // Bind in JS rather than via an onclick attribute: keeps the numeric\n549:             // id (removeFromQueue compares with !==, so a string would silently\n550:             // never match) and drops the hidden dependency on a global.\n551:             const removeBtn = item.querySelector('.screenshot-remove');\n552:             if (removeBtn) {\n553:                 removeBtn.addEventListener('click', () => this.removeFromQueue(screenshot.id));\n554:             }\n555:             queueGrid.appendChild(item);\n556:         });\n557:     }\n558:     \n559:     formatFileSize(bytes) {\n560:         if (bytes < 1024) return bytes + 'B';\n561:         if (bytes < 1024 * 1024) return Math.round(bytes / 1024) + 'KB';\n562:         return Math.round(bytes / (1024 * 1024)) + 'MB';\n563:     }\n564:     \n565:     // Vision processing methods\n566:     async processQueue() {\n567:         if (this.screenshotQueue.length === 0) {\n568:             this.showNotification('❌ No Screenshots', 'Take some screenshots first', 'error');\n569:             return;\n570:         }\n571:         \n572:         if (!this.visionConfig) {\n573:             this.showNotification('❌ No Vision Model', 'Configure a vision model in settings', 'error');\n574:             return;\n575:         }\n576:         \n577:         const processBtn = document.getElementById('process-queue-btn');\n578:         if (processBtn) {\n579:             processBtn.disabled = true;\n580:             processBtn.textContent = 'Processing...';\n581:         }\n582:         \n583:         try {\n584:             const screenshots = this.screenshotQueue.map(s => s.dataUrl);\n585:             \n586:             console.log('🔄 Processing comprehensive multi-screenshot analysis...');\n587:             console.log(`📸 Analyzing ${screenshots.length} screenshots together as one complete problem`);\n588:             console.log('🧠 Generating two distinct solution approaches with full implementations');\n589:             \n590:             // Send to vision processing service\n591:             const result = await this.sendToVisionAI(screenshots);\n592:             \n593:             if (result.success) {\n594:                 // Note: Vision analysis display is handled by main.js WebSocket message handler\n595:                 // to avoid duplicate display. We just handle UI feedback here.\n596:                 \n597:                 // Clear queue after successful processing\n598:                 this.clearQueue();\n599:                 this.showNotification('✅ Comprehensive Analysis Complete', \n600:                     `${screenshots.length} screenshots analyzed with 2 solution approaches`, 'success');\n601:             } else {\n602:                 this.showNotification('❌ Analysis Failed', result.error || 'Vision AI processing failed', 'error');\n603:             }\n604:             \n605:         } catch (error) {\n606:             console.error('❌ Vision processing error:', error);\n607:             this.showNotification('❌ Processing Error', error.message, 'error');\n608:         } finally {\n609:             if (processBtn) {\n610:                 processBtn.disabled = false;\n611:                 processBtn.textContent = `Process (${this.screenshotQueue.length})`;\n612:             }\n613:         }\n614:     }\n615:     \n616:     async sendToVisionAI(screenshots) {\n617:         try {\n618:             console.log(`🔍 Sending ${screenshots.length} screenshots for comprehensive analysis`);\n619:             console.log('📝 Enhanced prompt for multi-screenshot analysis');\n620:             \n621:             const payload = {\n622:                 screenshots: screenshots,\n623:                 visionConfig: this.visionConfig,\n624:                 languages: this.programmingLanguages\n625:             };\n626:             \n627:             // Send via WebSocket if available\n628:             if (window.sendSocketMessage) {\n629:                 // Show processing status in conversation\n630:                 if (window.webSocketHandler && window.webSocketHandler.showVisionProcessingStatus) {\n631:                     window.webSocketHandler.showVisionProcessingStatus(\n632:                         screenshots.length,\n633:                         this.visionConfig.provider,\n634:                         this.visionConfig.model\n635:                     );\n636:                 }\n637:                 \n638:                 window.sendSocketMessage('vision_analysis', payload);\n639:                 \n640:                 // Return a promise that resolves when we get the response\n641:                 return new Promise((resolve, reject) => {\n642:                     const timeout = setTimeout(() => {\n643:                         // Hide processing status on timeout\n644:                         if (window.webSocketHandler && window.webSocketHandler.hideVisionProcessingStatus) {\n645:                             window.webSocketHandler.hideVisionProcessingStatus();\n646:                         }\n647:                         reject(new Error('Vision analysis timeout (45s)'));\n648:                     }, 45000); // Reduced to 45 seconds to match backend optimization\n649:                     \n650:                     // This would be handled by the WebSocket message handler\n651:                     window.visionAnalysisResolver = (result) => {\n652:                         clearTimeout(timeout);\n653:                         console.log(`✅ Vision analysis resolver called with result:`, result.success ? 'SUCCESS' : 'FAILED');\n654:                         resolve(result);\n655:                     };\n656:                 });\n657:             } else {\n658:                 throw new Error('WebSocket not available - please ensure interview is active');\n659:             }\n660:             \n661:         } catch (error) {\n662:             console.error('❌ Vision AI request failed:', error);\n663:             return {\n664:                 success: false,\n665:                 error: error.message\n666:             };\n667:         }\n668:     }\n669:     \n670:     // UI methods\n671:     showVisionMode(isActive) {\n672:         if (isActive) {\n673:             this.insertQueueUI();\n674:             const queueElement = document.getElementById('screenshot-queue');\n675:             if (queueElement) {\n676:                 queueElement.classList.remove('hidden');\n677:             }\n678:             \n679:             this.showVisionModeIndicator();\n680:         } else {\n681:             const queueElement = document.getElementById('screenshot-queue');\n682:             if (queueElement) {\n683:                 queueElement.classList.add('hidden');\n684:             }\n685:             \n686:             this.hideVisionModeIndicator();\n687:         }\n688:     }\n689:     \n690:     showVisionModeIndicator() {\n691:         // Remove existing indicator\n692:         this.hideVisionModeIndicator();\n693:         \n694:         const indicator = document.createElement('div');\n695:         indicator.id = 'vision-mode-indicator';\n696:         indicator.className = 'vision-mode-indicator';\n697:         indicator.innerHTML = `\n698:             <div class=\"vision-mode-content\">\n699:                 <h3>👁️ Vision Mode Active (Global)</h3>\n700:                 <p>Ready to capture and analyze screenshots anywhere!</p>\n701:                 <div class=\"vision-hotkeys\">\n702:                     <div class=\"vision-hotkey\">\n703:                         <kbd>Alt+S</kbd>\n704:                         <span>Capture</span>\n705:                     </div>\n706:                     <div class=\"vision-hotkey\">\n707:                         <kbd>Alt+P</kbd>\n708:                         <span>Process</span>\n709:                     </div>\n710:                     <div class=\"vision-hotkey\">\n711:                         <kbd>Alt+T</kbd>\n712:                         <span>Switch Model</span>\n713:                     </div>\n714:                     <div class=\"vision-hotkey\">\n715:                         <kbd>Alt+V</kbd>\n716:                         <span>Exit Vision</span>\n717:                     </div>\n718:                 </div>\n719:                 <p style=\"font-size: 11px; opacity: 0.8; margin-top: 10px;\">\n720:                     🌍 Works globally - no need to focus this app!\n721:                 </p>\n722:             </div>\n723:         `;\n724:         \n725:         document.body.appendChild(indicator);\n726:         \n727:         // Auto-hide after 4 seconds (bit longer for global message)\n728:         setTimeout(() => {\n729:             this.hideVisionModeIndicator();\n730:         }, 4000);\n731:     }\n732:     \n733:     hideVisionModeIndicator() {\n734:         const indicator = document.getElementById('vision-mode-indicator');\n735:         if (indicator) {\n736:             indicator.remove();\n737:         }\n738:     }\n739:     \n740:     showNotification(title, message, type = 'info') {\n741:         // Remove existing notification\n742:         const existing = document.getElementById('capture-notification');\n743:         if (existing) existing.remove();\n744:         \n745:         const notification = document.createElement('div');\n746:         notification.id = 'capture-notification';\n747:         notification.className = `capture-notification ${type}`;\n748:         notification.innerHTML = `\n749:             <div style=\"font-weight: 600; margin-bottom: 4px;\">${title}</div>\n750:             <div style=\"font-size: 12px; opacity: 0.8;\">${message}</div>\n751:         `;\n752:         \n753:         document.body.appendChild(notification);\n754:         \n755:         // Auto-hide after 3 seconds\n756:         setTimeout(() => {\n757:             if (notification.parentNode) {\n758:                 notification.remove();\n759:             }\n760:         }, 3000);\n761:     }\n762:     \n763:     // Public API methods\n764:     getQueueStatus() {\n765:         return {\n766:             count: this.screenshotQueue.length,\n767:             maxCount: this.maxScreenshots,\n768:             totalSize: this.screenshotQueue.reduce((sum, s) => sum + s.size, 0),\n769:             isConfigured: !!this.visionConfig\n770:         };\n771:     }\n772:     \n773:     isReady() {\n774:         return !!this.visionConfig && this.programmingLanguages.length > 0;\n775:     }\n776: }\n777: \n778: // Create global instance\n779: const screenshotService = new ScreenshotService();\n780: \n781: // Make it globally accessible\n782: window.screenshotService = screenshotService;\n783: \n784: export default screenshotService; \nThe above content shows the entire, complete file contents of the requested file.\n"}
