       this.currentStreamingElement = null;\n1147:         this.currentStreamingContent = null;\n1148:     }\n1149: \n1150:     // Add response metadata (preset info, errors, etc.)\n1151:     addResponseMetadata(element, metadata) {\n1152:         if (!element) return;\n1153:         \n1154:         let metaHTML = '';\n1155:         \n1156:         // Always show model info in minimalistic way\n1157:         if (metadata.preset && metadata.preset.model) {\n1158:             const modelName = metadata.preset.model.length > 25 ? \n1159:                 metadata.preset.model.substring(0, 25) + '...' : \n1160:                 metadata.preset.model;\n1161:             metaHTML += `<div class=\"response-meta model-info\">\n1162:                 🧠 ${modelName}\n1163:             </div>`;\n1164:         }\n1165:         \n1166:         // Show fallback info if used\n1167:         if (metadata.fallback && metadata.fallback.fallback_used) {\n1168:             metaHTML += `<div class=\"response-meta fallback-info\">\n1169:                 🔄 Backup used\n1170:             </div>`;\n1171:         }\n1172:         \n1173:         // Show error info if present\n1174:         if (metadata.error) {\n1175:             metaHTML += `<div class=\"response-meta error-info\">\n1176:                 ⚠️ Error\n1177:             </div>`;\n1178:         }\n1179:         \n1180:         if (metaHTML) {\n1181:             element.insertAdjacentHTML('beforeend', metaHTML);\n1182:             console.log('📡 Metadata added:', metadata.preset?.model || 'Unknown model');\n1183:         }\n1184:     }\n1185: \n1186:     // Filter thinking content helper\n1187:     filterThinkingContent(content) {\n1188:         if (!content || typeof content !== 'string') {\n1189:             return content;\n1190:         }\n1191:         \n1192:         // Check if thinking filter is enabled (default to true)\n1193:         if (this.thinkingFilterEnabled === false) {\n1194:             return content;\n1195:         }\n1196:         \n1197:         // Remove content between <think> and </think> tags (case insensitive, multiline)\n1198:         const thinkingRegex = /<think\\s*>[\\s\\S]*?<\\/think\\s*>/gi;\n1199:         const originalLength = content.length;\n1200:         \n1201:         // Remove thinking content but preserve surrounding whitespace structure\n1202:         let filteredContent = content.replace(thinkingRegex, (match, offset, string) => {\n1203:             // Check if the thinking block is on its own line(s)\n1204:             const beforeMatch = string.substring(0, offset);\n1205:             const afterMatch = string.substring(offset + match.length);\n1206:             \n1207:             const beforeEndsWithNewline = beforeMatch.endsWith('\\n') || beforeMatch.endsWith('\\n\\n');\n1208:             const afterStartsWithNewline = afterMatch.startsWith('\\n') || afterMatch.startsWith('\\n\\n');\n1209:             \n1210:             // If the thinking block is on its own line, preserve one newline\n1211:             if (beforeEndsWithNewline && afterStartsWithNewline) {\n1212:                 return '\\n';\n1213:             }\n1214:             // If it's inline, just remove it\n1215:             return '';\n1216:         });\n1217:         \n1218:         // Only clean up excessive newlines (3 or more consecutive), preserve normal paragraph breaks\n1219:         filteredContent = filteredContent.replace(/\\n{3,}/g, '\\n\\n');\n1220:         \n1221:         // Log if thinking content was filtered\n1222:         if (originalLength !== filteredContent.length) {\n1223:             console.log(`🧠 Filtered thinking content: ${originalLength} → ${filteredContent.length} chars`);\n1224:         }\n1225:         \n1226:         return filteredContent;\n1227:     }\n1228: \n1229:     // Clear conversation\n1230:     clearConversation() {\n1231:         if (this.conversationStream) {\n1232:             this.conversationStream.innerHTML = '';\n1233:         }\n1234:         \n1235:         // Clear all references to prevent multiple elements\n1236:         this.currentInterviewerElement = null;\n1237:         this.currentCandidateElement = null;\n1238:         this.currentAIElement = null;\n1239:         this.currentStreamingElement = null;\n1240:         this.currentStreamingContent = null;\n1241:         this.isStreaming = false;\n1242:         \n1243:         // Reset markdown parser\n1244:         this.markdownParser.reset();\n1245:         \n1246:         this.updateEmptyState();\n1247:         console.log('🧹 Conversation cleared and all references reset');\n1248:     }\n1249: \n1250:     // Update empty state class\n1251:     updateEmptyState() {\n1252:         if (!this.conversationStream) return;\n1253:         \n1254:         const messageCount = this.conversationStream.querySelectorAll('.message').length;\n1255:         if (messageCount === 0) {\n1256:             this.conversationStream.classList.add('no-messages');\n1257:         } else {\n1258:             this.conversationStream.classList.remove('no-messages');\n1259:         }\n1260:     }\n1261: \n1262:     // Toggle microphone mute via the UI button\n1263:     toggleMute() {\n1264:         // The hotkey manager and mute manager now handle the logic.\n1265:         // This just needs to trigger the toggle.\n1266:         muteManager.toggleMicrophoneMute();\n1267:     }\n1268: \n1269:     // Central handler for all mute state changes\n1270:     handleMuteStateChange(status) {\n1271:         this.updateMuteButton(status.microphone);\n1272:         this.showActivity(); // Re-evaluates the activity indicator text\n1273:     }\n1274: \n1275:     // Update mute button appearance\n1276:     updateMuteButton(isMuted) {\n1277:         if (this.muteButton) {\n1278:             if (isMuted) {\n1279:                 this.muteButton.classList.add('muted');\n1280:                 this.muteButton.title = 'Unmute microphone input to app (Alt+M)';\n1281:             } else {\n1282:                 this.muteButton.classList.remove('muted');\n1283:                 this.muteButton.title = 'Mute microphone input to app (Alt+M)';\n1284:             }\n1285:         }\n1286:     }\n1287: \n1288:     // End interview\n1289:     endInterview() {\n1290:         if (typeof window.endInterview === 'function') {\n1291:             window.endInterview();\n1292:         }\n1293:     }\n1294: \n1295:     // Reset interview\n1296:     resetInterview() {\n1297:         if (typeof window.resetInterview === 'function') {\n1298:             window.resetInterview();\n1299:         }\n1300:     }\n1301: \n1302:     // Initialize\n1303:     initialize() {\n1304:         this.clearConversation();\n1305:         this.showActivity('Listening...');\n1306:         this.controls.initialize(); // Initialize controls module\n1307:         this.updateEmptyState();\n1308:         \n1309:         // Set initial UI state from the mute manager\n1310:         const initialStatus = muteManager.getMuteStatus();\n1311:         this.updateMuteButton(initialStatus.microphone);\n1312:         console.log(`🎤 UI initialized with microphone ${initialStatus.microphone ? 'muted' : 'unmuted'}`);\n1313:         \n1314:         // Reset scroll state\n1315:         this.scrollState = {\n1316:             mode: 'live_bottom',\n1317:             userReadingMode: false,\n1318:             lastUserScrollTime: 0,\n1319:             lastUserScrollDirection: 'down',\n1320:             consecutiveUpScrolls: 0,\n1321:             aiResponseStartElement: null,\n1322:             isLiveSpeaking: false,\n1323:             lastScrollPosition: 0,\n1324:             isNearBottom: true,\n1325:             bottomThreshold: 100,\n1326:             readingThreshold: 200,\n1327:             newContentPending: false,\n1328:             resumeScrollButton: this.scrollState?.resumeScrollButton || null, // Preserve button reference\n1329:         };\n1330:         \n1331:         console.log('🎬 Live interview UI initialized');\n1332:     }\n1333: \n1334:     // Get current configuration\n1335:     getConfig() {\n1336:         return {\n1337:             streaming: this.streaming.getConfig(),\n1338:             transparency: this.controls.getConfig()\n1339:         };\n1340:     }\n1341: \n1342:     isUserNearBottom() {\n1343:         if (this.conversationStream) {\n1344:             const { scrollTop, scrollHeight, clientHeight } = this.conversationStream;\n1345:             const maxScrollTop = scrollHeight - clientHeight;\n1346:             return scrollTop >= maxScrollTop - this.scrollState.bottomThreshold;\n1347:         }\n1348:         return false;\n1349:     }\n1350: \n1351:     // --- Transparency Control Methods ---\n1352:     // Add transparency methods to LiveInterviewUI for hotkey integration\n1353:     \n1354:     async setTransparency(level) {\n1355:         console.log(`🪟 Setting transparency level: ${level}`);\n1356:         \n1357:         // Handle both numeric (1,2,3) and string (\"transparent\",\"semi\",\"opaque\") levels\n1358:         // for compatibility with both hotkey systems and direct calls\n1359:         let targetMode;\n1360:         \n1361:         if (typeof level === 'number') {\n1362:             // Numeric levels from original hotkey system (Alt+1, Alt+2, Alt+3)\n1363:             switch(level) {\n1364:                 case 1:\n1365:                     targetMode = 'transparent';\n1366:                     break;\n1367:                 case 2:\n1368:                     targetMode = 'semi';\n1369:                     break;\n1370:                 case 3:\n1371:                     targetMode = 'opaque';\n1372:                     break;\n1373:                 default:\n1374:                     console.warn(`⚠️ Unknown numeric transparency level: ${level}`);\n1375:                     return false;\n1376:             }\n1377:         } else if (typeof level === 'string') {\n1378:             // String levels from global hotkey system\n1379:             targetMode = level.toLowerCase();\n1380:         } else {\n1381:             console.warn(`⚠️ Invalid transparency level type: ${typeof level}`);\n1382:             return false;\n1383:         }\n1384:         \n1385:         // Execute the appropriate transparency preset\n1386:         switch(targetMode) {\n1387:             case 'transparent':\n1388:                 console.log('🪟 Setting transparent mode (40% opacity)');\n1389:                 return await this.controls.setInterviewMode();\n1390:             case 'semi':\n1391:             case 'semi-transparent':\n1392:                 console.log('🪟 Setting semi-transparent mode (70% opacity)');\n1393:                 return await this.controls.setSemiTransparentMode();\n1394:             case 'opaque':\n1395:                 console.log('🪟 Setting opaque mode (100% opacity)');\n1396:                 return await this.controls.setOpaqueMode();\n1397:             default:\n1398:                 console.warn(`⚠️ Unknown transparency mode: ${targetMode}`);\n1399:                 return false;\n1400:         }\n1401:     }\n1402: \n1403:     // Expose other transparency methods for consistency\n1404:     async setWindowTransparency(transparency) {\n1405:         return await this.controls.setWindowTransparency(transparency);\n1406:     }\n1407: \n1408:     async setWindowTransparencyPercent(percent) {\n1409:         return await this.controls.setWindowTransparencyPercent(percent);\n1410:     }\n1411: \n1412:     async setInterviewMode() {\n1413:         return await this.controls.setInterviewMode();\n1414:     }\n1415: \n1416:     async setSemiTransparentMode() {\n1417:         return await this.controls.setSemiTransparentMode();\n1418:     }\n1419: \n1420:     async setOpaqueMode() {\n1421:         return await this.controls.setOpaqueMode();\n1422:     }\n1423: }\n1424: \n1425: // Create global instance\n1426: window.liveInterviewUI = new LiveInterviewUI();\n1427: \n1428: // Add global configuration functions for easy control\n1429: window.setInterviewStreaming = (enabled) => {\n1430:     window.liveInterviewUI.streaming.setStreamingEnabled(enabled);\n1431:     console.log(`🎬 Streaming ${enabled ? 'enabled' : 'disabled'}`);\n1432: };\n1433: \n1434: window.setInterviewSpeed = (speed) => {\n1435:     window.liveInterviewUI.streaming.setStreamingSpeed(speed);\n1436:     console.log(`⚡ Interviewer streaming speed set to ${speed}ms`);\n1437: };\n1438: \n1439: window.setAISpeed = (speed) => {\n1440:     window.liveInterviewUI.streaming.setAIStreamingSpeed(speed);\n1441:     console.log(`🤖 AI streaming speed set to ${speed}ms`);\n1442: };\n1443: \n1444: window.setMarkdownEnabled = (enabled) => {\n1445:     window.liveInterviewUI.streaming.setMarkdownEnabled(enabled);\n1446:     console.log(`📝 Markdown processing ${enabled ? 'enabled' : 'disabled'}`);\n1447: };\n1448: \n1449: window.setMarkdownSpeed = (speed) => {\n1450:     window.liveInterviewUI.streaming.setMarkdownSpeed(speed);\n1451:     console.log(`📝 Markdown element speed set to ${speed}ms`);\n1452: };\n1453: \n1454: // Process All Speakers Configuration\n1455: window.setProcessAllSpeakers = (enabled) => {\n1456:     // This function will be fully implemented in main.js where the socket is managed\n1457:     if (typeof window.sendSocketMessage === 'function') {\n1458:         window.sendSocketMessage('config_update', {\n1459:             processAllSpeakers: enabled\n1460:         });\n1461:         console.log(`🎯 Process All Speakers config sent: ${enabled}`);\n1462:     } else {\n1463:         console.warn('sendSocketMessage not defined yet. Make sure it is globally available.');\n1464:     }\n1465: };\n1466: \n1467: window.enableAllSpeakers = () => {\n1468:     window.setProcessAllSpeakers(true);\n1469:     console.log('🎯 All speakers mode activated - AI will respond to everyone');\n1470: };\n1471: \n1472: window.disableAllSpeakers = () => {\n1473:     window.setProcessAllSpeakers(false);\n1474:     console.log('🎯 Interviewer-only mode activated - AI will only respond to interviewer');\n1475: };\n1476: \n1477: // Smart scroll controls\n1478: window.setScrollMode = (mode) => {\n1479:     if (window.liveInterviewUI) {\n1480:         window.liveInterviewUI.setScrollMode(mode);\n1481:     }\n1482: };\n1483: \n1484: window.getScrollState = () => {\n1485:     if (window.liveInterviewUI) {\n1486:         return window.liveInterviewUI.scrollState;\n1487:     }\n1488:     return null;\n1489: };\n1490: \n1491: // Enhanced scroll control functions\n1492: window.enterReadingMode = () => {\n1493:     if (window.liveInterviewUI) {\n1494:         window.liveInterviewUI.enterReadingMode();\n1495:         console.log('📚 Manually entered reading mode');\n1496:     }\n1497: };\n1498: \n1499: window.exitReadingMode = () => {\n1500:     if (window.liveInterviewUI) {\n1501:         window.liveInterviewUI.exitReadingMode();\n1502:         console.log('📜 Manually exited reading mode');\n1503:     }\n1504: };\n1505: \n1506: window.resumeAutoScroll = () => {\n1507:     if (window.liveInterviewUI) {\n1508:         window.liveInterviewUI.resumeAutoScroll();\n1509:     }\n1510: };\n1511: \n1512: window.isInReadingMode = () => {\n1513:     if (window.liveInterviewUI) {\n1514:         return window.liveInterviewUI.scrollState.userReadingMode;\n1515:     }\n1516:     return false;\n1517: };\n1518: \n1519: // Quick presets\n1520: window.setFastStreaming = () => {\n1521:     window.setInterviewSpeed(15);\n1522:     window.setAISpeed(8);\n1523:     console.log('🚀 Fast streaming mode activated');\n1524: };\n1525: \n1526: window.setSlowStreaming = () => {\n1527:     window.setInterviewSpeed(50);\n1528:     window.setAISpeed(30);\n1529:     console.log('🐌 Slow streaming mode activated');\n1530: };\n1531: \n1532: window.setInstantMode = () => {\n1533:     window.setInterviewStreaming(false);\n1534:     console.log('⚡ Instant mode activated - no streaming animations');\n1535: };\n1536: \n1537: // Markdown-specific presets\n1538: window.setFastMarkdown = () => {\n1539:     window.setMarkdownEnabled(true);\n1540:     window.setMarkdownSpeed(50);\n1541:     window.setInterviewSpeed(8);\n1542:     window.setAISpeed(3);\n1543:     console.log('📝 Fast markdown mode activated');\n1544: };\n1545: \n1546: window.setSlowMarkdown = () => {\n1547:     window.setMarkdownEnabled(true);\n1548:     window.setMarkdownSpeed(150);\n1549:     window.setInterviewSpeed(20);\n1550:     window.setAISpeed(6);\n1551:     console.log('📝 Slow markdown mode activated');\n1552: };\n1553: \n1554: window.disableMarkdown = () => {\n1555:     window.setMarkdownEnabled(false);\n1556:     console.log('📝 Markdown processing disabled - plain text only');\n1557: };\n1558: \n1559: window.enableMarkdown = () => {\n1560:     window.setMarkdownEnabled(true);\n1561:     console.log('📝 Markdown processing enabled - formatted text');\n1562: };\n1563: \n1564: // Thinking content filter controls\n1565: window.enableThinkingFilter = () => {\n1566:     if (window.liveInterviewUI) {\n1567:         window.liveInterviewUI.thinkingFilterEnabled = true;\n1568:         console.log('🧠 Thinking content filter enabled - <think> tags will be hidden');\n1569:     }\n1570: };\n1571: \n1572: window.disableThinkingFilter = () => {\n1573:     if (window.liveInterviewUI) {\n1574:         window.liveInterviewUI.thinkingFilterEnabled = false;\n1575:         console.log('🧠 Thinking content filter disabled - <think> tags will be visible');\n1576:     }\n1577: };\n1578: \n1579: window.isThinkingFilterEnabled = () => {\n1580:     if (window.liveInterviewUI) {\n1581:         return window.liveInterviewUI.thinkingFilterEnabled !== false; // Default to true\n1582:     }\n1583:     return true;\n1584: };\n1585: \n1586: \n1587: export default window.liveInterviewUI; \nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those 