{"step_index":32,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-08-21T21:51:49Z","content":"Created At: 2026-08-21T18:51:49-03:00\nCompleted At: 2026-08-21T18:51:49-03:00\nFile Path: `file:///c:/Users/Arthur%20Henrique/Documents/GitHub/Spectra/web/js/preset-manager.js`\nTotal Lines: 444\nTotal Bytes: 15872\nShowing lines 1 to 444\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: // Preset Manager for Dynamic AI Model Switching\n2: // Handles UI updates, notifications, and preset switching functionality\n3: \n4: class PresetManager {\n5:     constructor() {\n6:         this.currentPreset = null;\n7:         this.availablePresets = [];\n8:         this.healthStatus = {};\n9:         this.isInitialized = false;\n10:         this.notificationTimeout = null;\n11:         \n12:         this.setupPresetUI();\n13:         this.setupNotificationStyles();\n14:         console.log('🎯 PresetManager initialized');\n15:     }\n16:     \n17:     setupPresetUI() {\n18:         // Wait for DOM to be ready\n19:         if (document.readyState === 'loading') {\n20:             document.addEventListener('DOMContentLoaded', () => this.createPresetIndicator());\n21:         } else {\n22:             this.createPresetIndicator();\n23:         }\n24:     }\n25:     \n26:     createPresetIndicator() {\n27:         // Create preset indicator for live interview view\n28:         const presetIndicator = document.createElement('div');\n29:         presetIndicator.id = 'preset-indicator';\n30:         presetIndicator.className = 'preset-indicator';\n31:         presetIndicator.innerHTML = `\n32:             <div class=\"preset-display\">\n33:                 <div class=\"preset-header\">\n34:                     <span class=\"preset-label\">AI Model:</span>\n35:                     <span class=\"preset-health-dot\" title=\"Provider Health Status\"></span>\n36:                 </div>\n37:                 <div class=\"preset-details\">\n38:                     <span class=\"preset-name\">Loading...</span>\n39:                     <span class=\"preset-provider\">Initializing...</span>\n40:                 </div>\n41:                 <div class=\"preset-hotkeys\">\n42:                     <span class=\"hotkey-hint\">Alt+Q: Primary | Alt+W: Secondary | Alt+E: Auto</span>\n43:                 </div>\n44:             </div>\n45:         `;\n46:         \n47:         // Store reference for later insertion\n48:         this.presetIndicatorElement = presetIndicator;\n49:         \n50:         // Try to insert into live view if it exists\n51:         this.insertPresetIndicator();\n52:     }\n53:     \n54:     insertPresetIndicator() {\n55:         const liveView = document.getElementById('live-view');\n56:         if (liveView && this.presetIndicatorElement && !document.getElementById('preset-indicator')) {\n57:             const liveHeader = liveView.querySelector('.live-header');\n58:             if (liveHeader) {\n59:                 liveHeader.appendChild(this.presetIndicatorElement);\n60:                 console.log('✅ Preset indicator added to live view');\n61:             }\n62:         }\n63:     }\n64:     \n65:     setupNotificationStyles() {\n66:         // Inject CSS for notifications if not already present\n67:         if (!document.getElementById('preset-manager-styles')) {\n68:             const style = document.createElement('style');\n69:             style.id = 'preset-manager-styles';\n70:             style.textContent = `\n71:                 .preset-indicator {\n72:                     background: rgba(0, 0, 0, 0.9);\n73:                     border: 1px solid var(--border-color, #333);\n74:                     border-radius: 6px;\n75:                     padding: 8px 12px;\n76:                     margin-left: 12px;\n77:                     backdrop-filter: blur(10px);\n78:                     min-width: 200px;\n79:                 }\n80:                 \n81:                 .preset-header {\n82:                     display: flex;\n83:                     align-items: center;\n84:                     gap: 8px;\n85:                     margin-bottom: 4px;\n86:                 }\n87:                 \n88:                 .preset-label {\n89:                     font-size: 11px;\n90:                     font-weight: 600;\n91:                     color: #a0aec0;\n92:                     text-transform: uppercase;\n93:                     letter-spacing: 0.5px;\n94:                 }\n95:                 \n96:                 .preset-health-dot {\n97:                     width: 8px;\n98:                     height: 8px;\n99:                     border-radius: 50%;\n100:                     background: #4a5568;\n101:                     transition: background-color 0.3s ease;\n102:                 }\n103:                 \n104:                 .preset-health-dot.healthy {\n105:                     background: #48bb78;\n106:                     box-shadow: 0 0 4px rgba(72, 187, 120, 0.4);\n107:                 }\n108:                 \n109:                 .preset-health-dot.unhealthy {\n110:                     background: #f56565;\n111:                     box-shadow: 0 0 4px rgba(245, 101, 101, 0.4);\n112:                 }\n113:                 \n114:                 .preset-details {\n115:                     display: flex;\n116:                     flex-direction: column;\n117:                     gap: 2px;\n118:                 }\n119:                 \n120:                 .preset-name {\n121:                     font-size: 12px;\n122:                     font-weight: 600;\n123:                     color: #ffffff;\n124:                 }\n125:                 \n126:                 .preset-provider {\n127:                     font-size: 10px;\n128:                     color: #718096;\n129:                     font-family: 'Monaco', 'Menlo', 'Ubuntu Mono', monospace;\n130:                 }\n131:                 \n132:                 .preset-hotkeys {\n133:                     margin-top: 4px;\n134:                     border-top: 1px solid rgba(255, 255, 255, 0.1);\n135:                     padding-top: 4px;\n136:                 }\n137:                 \n138:                 .hotkey-hint {\n139:                     font-size: 9px;\n140:                     color: #4a5568;\n141:                     font-family: 'Monaco', 'Menlo', 'Ubuntu Mono', monospace;\n142:                 }\n143:                 \n144:                 .preset-notification {\n145:                     position: fixed;\n146:                     top: 50px;\n147:                     right: 20px;\n148:                     z-index: 10000;\n149:                     max-width: 400px;\n150:                     pointer-events: none;\n151:                     animation: slideInRight 0.3s ease-out;\n152:                 }\n153:                 \n154:                 .notification-content {\n155:                     background: rgba(0, 0, 0, 0.95);\n156:                     border: 1px solid var(--border-color, #333);\n157:                     border-radius: 8px;\n158:                     padding: 16px;\n159:                     backdrop-filter: blur(15px);\n160:                     box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);\n161:                 }\n162:                 \n163:                 .notification-content.success {\n164:                     border-left: 4px solid #48bb78;\n165:                 }\n166:                 \n167:                 .notification-content.error {\n168:                     border-left: 4px solid #f56565;\n169:                 }\n170:                 \n171:                 .notification-content.warning {\n172:                     border-left: 4px solid #ed8936;\n173:                 }\n174:                 \n175:                 .notification-content.info {\n176:                     border-left: 4px solid #4299e1;\n177:                 }\n178:                 \n179:                 .notification-title {\n180:                     font-size: 14px;\n181:                     font-weight: 600;\n182:                     color: #ffffff;\n183:                     margin-bottom: 8px;\n184:                     display: flex;\n185:                     align-items: center;\n186:                     gap: 8px;\n187:                 }\n188:                 \n189:                 .notification-message {\n190:                     font-size: 12px;\n191:                     color: #a0aec0;\n192:                     margin-bottom: 8px;\n193:                     line-height: 1.4;\n194:                 }\n195:                 \n196:                 .notification-details {\n197:                     font-size: 11px;\n198:                     color: #718096;\n199:                     font-family: 'Monaco', 'Menlo', 'Ubuntu Mono', monospace;\n200:                     background: rgba(255, 255, 255, 0.05);\n201:                     padding: 8px;\n202:                     border-radius: 4px;\n203:                     border: 1px solid rgba(255, 255, 255, 0.1);\n204:                 }\n205:                 \n206:                 .health-status {\n207:                     display: flex;\n208:                     gap: 8px;\n209:                     margin-top: 8px;\n210:                 }\n211:                 \n212:                 .health-item {\n213:                     display: flex;\n214:                     align-items: center;\n215:                     gap: 4px;\n216:                     font-size: 10px;\n217:                     color: #718096;\n218:                 }\n219:                 \n220:                 .health-item .health-dot {\n221:                     width: 6px;\n222:                     height: 6px;\n223:                     border-radius: 50%;\n224:                     background: #4a5568;\n225:                 }\n226:                 \n227:                 .health-item .health-dot.healthy {\n228:                     background: #48bb78;\n229:                 }\n230:                 \n231:                 .health-item .health-dot.unhealthy {\n232:                     background: #f56565;\n233:                 }\n234:                 \n235:                 @keyframes slideInRight {\n236:                     from {\n237:                         transform: translateX(100%);\n238:                         opacity: 0;\n239:                     }\n240:                     to {\n241:                         transform: translateX(0);\n242:                         opacity: 1;\n243:                     }\n244:                 }\n245:                 \n246:                 .preset-primary {\n247:                     color: #0066ff !important;\n248:                 }\n249:                 \n250:                 .preset-secondary {\n251:                     color: #ff6b35 !important;\n252:                 }\n253:                 \n254:                 .preset-auto {\n255:                     color: #6366f1 !important;\n256:                 }\n257:             `;\n258:             document.head.appendChild(style);\n259:         }\n260:     }\n261:     \n262:     updatePresetDisplay(presetInfo) {\n263:         this.currentPreset = presetInfo;\n264:         this.isInitialized = true;\n265:         \n266:         // Ensure the indicator is in the DOM\n267:         this.insertPresetIndicator();\n268:         \n269:         const presetNameElement = document.querySelector('.preset-name');\n270:         const presetProviderElement = document.querySelector('.preset-provider');\n271:         const healthDot = document.querySelector('.preset-health-dot');\n272:         \n273:         if (presetNameElement) {\n274:             presetNameElement.textContent = presetInfo.description || 'Unknown';\n275:             presetNameElement.className = `preset-name preset-${presetInfo.key}`;\n276:         }\n277:         \n278:         if (presetProviderElement) {\n279:             presetProviderElement.textContent = `${presetInfo.provider} - ${presetInfo.model}`;\n280:         }\n281:         \n282:         if (healthDot) {\n283:             healthDot.className = `preset-health-dot ${presetInfo.is_healthy ? 'healthy' : 'unhealthy'}`;\n284:             healthDot.title = presetInfo.is_healthy ? 'Provider is healthy' : 'Provider has issues';\n285:         }\n286:         \n287:         console.log('✅ Preset display updated:', presetInfo);\n288:     }\n289:     \n290:     updateHealthStatus(healthStatus) {\n291:         this.healthStatus = healthStatus;\n292:         \n293:         // Update the health dot based on current preset\n294:         if (this.currentPreset) {\n295:             const healthDot = document.querySelector('.preset-health-dot');\n296:             if (healthDot) {\n297:                 const isHealthy = healthStatus[this.currentPreset.key];\n298:                 healthDot.className = `preset-health-dot ${isHealthy ? 'healthy' : 'unhealthy'}`;\n299:                 healthDot.title = isHealthy ? 'Provider is healthy' : 'Provider has issues';\n300:             }\n301:         }\n302:     }\n303:     \n304:     showSwitchNotification(switchData) {\n305:         // Handle transparency notifications\n306:         if (switchData.type === 'transparency') {\n307:             this.showNotification('🔍 Transparency Changed', switchData.message, '', 'info');\n308:             return;\n309:         }\n310:         \n311:         // Handle audio control notifications\n312:         if (switchData.type === 'audio') {\n313:             let icon = '🎤';\n314:             if (switchData.message.toLowerCase().includes('system')) {\n315:                 icon = '⏸️';\n316:             }\n317:             this.showNotification(`${icon} Audio Control`, switchData.message, '', 'info');\n318:             return;\n319:         }\n320:         \n321:         // Handle preset switching notifications\n322:         const isAutoSelected = switchData.auto_selected || false;\n323:         const currentPreset = switchData.current_preset || {};\n324:         const previousPreset = switchData.previous_preset || '';\n325:         const healthResults = switchData.health_results || {};\n326:         \n327:         let title, message, type;\n328:         \n329:         if (isAutoSelected) {\n330:             title = '🤖 Auto-Selected Best Provider';\n331:             message = `Automatically switched to ${currentPreset.description}`;\n332:             type = 'success';\n333:         } else {\n334:             title = '🔄 Model Switched';\n335:             message = `Switched from ${previousPreset} to ${currentPreset.description}`;\n336:             type = 'success';\n337:         }\n338:         \n339:         const details = `Provider: ${currentPreset.provider}\\nModel: ${currentPreset.model}\\nHealth: ${currentPreset.is_healthy ? '✅ Healthy' : '❌ Issues detected'}`;\n340:         \n341:         this.showNotification(title, message, details, type, healthResults);\n342:     }\n343:     \n344:     showErrorNotification(error, data = {}) {\n345:         const title = '❌ Preset Switch Failed';\n346:         const message = typeof error === 'string' ? error : 'Failed to switch AI model';\n347:         const details = data.available_presets ? \n348:             `Available presets: ${data.available_presets.join(', ')}` : \n349:             'Please check your configuration';\n350:             \n351:         this.showNotification(title, message, details, 'error', data.health_results);\n352:     }\n353:     \n354:     showNotification(title, message, details = '', type = 'success', healthResults = {}) {\n355:         // Remove existing notification\n356:         this.removeExistingNotification();\n357:         \n358:         const notification = document.createElement('div');\n359:         notification.className = 'preset-notification';\n360:         notification.id = 'preset-notification';\n361:         \n362:         const healthStatusHtml = Object.keys(healthResults).length > 0 ? \n363:             `<div class=\"health-status\">\n364:                 ${Object.entries(healthResults).map(([key, healthy]) => \n365:                     `<div class=\"health-item\">\n366:                         <span class=\"health-dot ${healthy ? 'healthy' : 'unhealthy'}\"></span>\n367:                         <span>${key}</span>\n368:                     </div>`\n369:                 ).join('')}\n370:             </div>` : '';\n371:         \n372:         notification.innerHTML = `\n373:             <div class=\"notification-content ${type}\">\n374:                 <div class=\"notification-title\">${title}</div>\n375:                 <div class=\"notification-message\">${message}</div>\n376:                 ${details ? `<div class=\"notification-details\">${details}</div>` : ''}\n377:                 ${healthStatusHtml}\n378:             </div>\n379:         `;\n380:         \n381:         document.body.appendChild(notification);\n382:         \n383:         // Auto-hide after 4 seconds\n384:         this.notificationTimeout = setTimeout(() => {\n385:             this.removeExistingNotification();\n386:         }, 4000);\n387:     }\n388:     \n389:     removeExistingNotification() {\n390:         const existing = document.getElementById('preset-notification');\n391:         if (existing) {\n392:             existing.remove();\n393:         }\n394:         \n395:         if (this.notificationTimeout) {\n396:             clearTimeout(this.notificationTimeout);\n397:             this.notificationTimeout = null;\n398:         }\n399:     }\n400:     \n401:     // Public API methods\n402:     getCurrentPreset() {\n403:         return this.currentPreset;\n404:     }\n405:     \n406:     getHealthStatus() {\n407:         return this.healthStatus;\n408:     }\n409:     \n410:     isReady() {\n411:         return this.isInitialized;\n412:     }\n413:     \n414:     // Handle manual preset switching with UI feedback\n415:     switchPreset(presetKey) {\n416:         if (!this.isInitialized) {\n417:             this.showErrorNotification('Preset system not initialized');\n418:             return;\n419:         }\n420:         \n421:         // Show loading state\n422:         this.showNotification(\n423:             '🔄 Switching Model...',\n424:             `Changing to ${presetKey} preset`,\n425:             'Please wait...',\n426:             'warning'\n427:         );\n428:         \n429:         // Trigger the actual switch via main.js\n430:         if (window.switchPreset) {\n431:             window.switchPreset(presetKey);\n432:         } else {\n433:             this.showErrorNotification('Preset switching not available');\n434:         }\n435:     }\n436: }\n437: \n438: // Create global instance\n439: const presetManager = new PresetManager();\n440: \n441: // Make it globally accessible\n442: window.presetManager = presetManager;\n443: \n444: export default presetManager; \nThe above content shows the entire, complete file contents of the requested file.\n"}
