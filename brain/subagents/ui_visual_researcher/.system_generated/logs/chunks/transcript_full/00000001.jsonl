{"step_index":28,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-08-21T21:51:43Z","content":"Created At: 2026-08-21T18:51:43-03:00\nCompleted At: 2026-08-21T18:51:43-03:00\nFile Path: `file:///c:/Users/Arthur%20Henrique/Documents/GitHub/Spectra/web/js/live-interview.js`\nTotal Lines: 1587\nTotal Bytes: 59681\nShowing lines 1 to 800\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: // Live Interview Interface Module (Main Coordinator)\n2: import { devLog, isDev } from './config.js';\n3: import { LiveStreaming } from './live-streaming.js';\n4: import { LiveControls } from './live-controls.js';\n5: import muteManager from './mute-manager.js';\n6: import { StreamingMarkdownParser } from './streaming-markdown-parser.js';\n7: \n8: class LiveInterviewUI {\n9:     constructor() {\n10:         this.conversationStream = null;\n11:         this.activityIndicator = null;\n12:         this.endButton = null;\n13:         this.resetButton = null;\n14:         this.muteButton = null;\n15:         this.currentInterviewerElement = null; // Track interviewer message separately\n16:         this.currentCandidateElement = null; // Track candidate message separately\n17:         this.currentAIElement = null; // Track AI message separately\n18:         this.isStreaming = false;\n19:         this.eventsInitialized = false;\n20:         \n21:         // Enhanced smart scroll management\n22:         this.scrollState = {\n23:             mode: 'live_bottom',           // 'live_bottom', 'ai_start', 'user_reading'\n24:             userReadingMode: false,        // User has intentionally scrolled up to read\n25:             lastUserScrollTime: 0,         // When user last scrolled\n26:             lastUserScrollDirection: 'down', // 'up' or 'down'\n27:             consecutiveUpScrolls: 0,       // Count of consecutive up scrolls (indicates intent)\n28:             aiResponseStartElement: null,  // Reference to current AI response element\n29:             isLiveSpeaking: false,         // Whether someone is currently speaking\n30:             lastScrollPosition: 0,         // Track scroll position changes\n31:             isNearBottom: true,            // Is the scroll position near the bottom?\n32:             bottomThreshold: 100,          // Pixels from bottom to consider \"near bottom\"\n33:             readingThreshold: 200,         // Pixels scrolled up to consider \"reading mode\"\n34:             newContentPending: false,      // New content arrived while user is reading\n35:             resumeScrollButton: null,      // Reference to resume button\n36:         };\n37:         \n38:         // Initialize modules\n39:         this.streaming = new LiveStreaming({\n40:             enableStreaming: true,\n41:             streamingSpeed: 15,\n42:             aiStreamingSpeed: 5\n43:         });\n44:         \n45:         this.controls = new LiveControls();\n46:         \n47:         // Initialize real-time markdown parser\n48:         this.markdownParser = new StreamingMarkdownParser();\n49:         \n50:         // Enable thinking content filter by default\n51:         this.thinkingFilterEnabled = true;\n52:     }\n53: \n54:     // Initialize elements\n55:     init() {\n56:         this.conversationStream = document.getElementById('conversation-stream');\n57:         this.activityIndicator = document.getElementById('activity-indicator');\n58:         this.endButton = document.getElementById('end-interview-btn');\n59:         this.resetButton = document.getElementById('reset-interview-btn');\n60:         this.muteButton = document.getElementById('mute-btn');\n61:         \n62:         // Listen to the mute manager for state changes\n63:         muteManager.on('stateChange', (status) => this.handleMuteStateChange(status));\n64:         \n65:         this.setupEventListeners();\n66:     }\n67: \n68:     setupEventListeners() {\n69:         if (this.eventsInitialized) return;\n70: \n71:         if (this.endButton) {\n72:             this.endButton.addEventListener('click', () => this.endInterview());\n73:         }\n74: \n75:         if (this.resetButton) {\n76:             this.resetButton.addEventListener('click', () => this.resetInterview());\n77:         }\n78:         \n79:         if (this.muteButton) {\n80:             this.muteButton.addEventListener('click', () => this.toggleMute());\n81:         }\n82:         \n83:         // Setup smart scroll detection\n84:         this.setupSmartScroll();\n85:         \n86:         // Setup keyboard shortcuts for scroll control\n87:         this.setupScrollKeyboardShortcuts();\n88:         \n89:         this.eventsInitialized = true;\n90:     }\n91: \n92:     setupSmartScroll() {\n93:         if (!this.conversationStream) return;\n94: \n95:         this.conversationStream.addEventListener('scroll', () => {\n96:             this.handleScrollEvent();\n97:         });\n98: \n99:         // Track user scroll intent via wheel events\n100:         this.conversationStream.addEventListener('wheel', (e) => {\n101:             this.handleWheelEvent(e);\n102:         }, { passive: true });\n103: \n104:         // Create resume scroll button (initially hidden)\n105:         this.createResumeScrollButton();\n106:     }\n107: \n108:     handleScrollEvent() {\n109:         const { scrollTop, scrollHeight, clientHeight } = this.conversationStream;\n110:         const currentPosition = scrollTop;\n111:         const maxScrollTop = scrollHeight - clientHeight;\n112:         \n113:         // Determine scroll direction\n114:         const direction = currentPosition > this.scrollState.lastScrollPosition ? 'down' : 'up';\n115:         \n116:         // Update state\n117:         this.scrollState.lastScrollPosition = currentPosition;\n118:         this.scrollState.lastUserScrollTime = Date.now();\n119:         this.scrollState.isNearBottom = currentPosition >= maxScrollTop - this.scrollState.bottomThreshold;\n120:         \n121:         // Track scroll direction changes\n122:         if (direction !== this.scrollState.lastUserScrollDirection) {\n123:             this.scrollState.consecutiveUpScrolls = direction === 'up' ? 1 : 0;\n124:         } else if (direction === 'up') {\n125:             this.scrollState.consecutiveUpScrolls++;\n126:         }\n127:         \n128:         this.scrollState.lastUserScrollDirection = direction;\n129:         \n130:         // Determine if user is intentionally reading (scrolled up significantly)\n131:         const distanceFromBottom = maxScrollTop - currentPosition;\n132:         const wasInReadingMode = this.scrollState.userReadingMode;\n133:         \n134:         if (distanceFromBottom > this.scrollState.readingThreshold && this.scrollState.consecutiveUpScrolls >= 2) {\n135:             // User has scrolled up intentionally (multiple up scrolls + significant distance)\n136:             this.enterReadingMode();\n137:         } else if (this.scrollState.isNearBottom && this.scrollState.userReadingMode) {\n138:             // User has returned to bottom - exit reading mode\n139:             this.exitReadingMode();\n140:         }\n141:         \n142:     }\n143: \n144:     handleWheelEvent(e) {\n145:         // Additional intent detection: rapid up scrolls indicate reading intent\n146:         if (e.deltaY < 0) { // Scrolling up\n147:             this.scrollState.consecutiveUpScrolls++;\n148:         } else {\n149:             this.scrollState.consecutiveUpScrolls = 0;\n150:         }\n151:     }\n152: \n153:     enterReadingMode() {\n154:         if (!this.scrollState.userReadingMode) {\n155:             this.scrollState.userReadingMode = true;\n156:             this.scrollState.mode = 'user_reading';\n157:             console.log('📚 User reading mode activated - auto-scroll paused');\n158:             this.showResumeScrollButton();\n159:         }\n160:     }\n161:     \n162:     exitReadingMode() {\n163:         if (this.scrollState.userReadingMode) {\n164:             this.scrollState.userReadingMode = false;\n165:             this.scrollState.newContentPending = false;\n166:             this.setScrollMode('live_bottom');\n167:             this.hideResumeScrollButton();\n168:             console.log('📜 User returned to bottom - auto-scroll resumed');\n169:         }\n170:     }\n171: \n172:     createResumeScrollButton() {\n173:         // Inject CSS for the button if not already present\n174:         if (!document.getElementById('resume-scroll-styles')) {\n175:             const style = document.createElement('style');\n176:             style.id = 'resume-scroll-styles';\n177:             style.textContent = `\n178:                 .resume-scroll-btn {\n179:                     position: fixed;\n180:                     bottom: 30px;\n181:                     right: 20px;\n182:                     z-index: 1000;\n183:                     background: rgba(255, 255, 255, 0.8);\n184:                     color: rgb(0, 0, 0);;\n185:                     border: none;\n186:                     border-radius: 50%;\n187:                     width: 32px;\n188:                     height: 32px;\n189:                     font-size: 14px;\n190:                     font-weight:700;\n191:                     cursor: pointer;\n192:                     display: flex;\n193:                     align-items: center;\n194:                     justify-content: center;\n195:                     backdrop-filter: blur(10px);\n196:                     transition: all 0.2s ease;\n197:                     transform: translateY(0);\n198:                     opacity: 0.4;\n199:                     line-height: 1;\n200:                 }\n201:                 \n202:                 .resume-scroll-btn.hidden {\n203:                     transform: translateY(50px) scale(0.8);\n204:                     opacity: 0;\n205:                     pointer-events: none;\n206:                 }\n207:                 \n208:                 .resume-scroll-btn:hover {\n209:                     background: rgba(40, 40, 40, 0.8);\n210:                     color: #fff;\n211:                     opacity: 0.9;\n212:                     transform: scale(1.1);\n213:                 }\n214:                 \n215:                 .resume-scroll-btn.has-new-content {\n216:                     background: rgba(34, 139, 34, 0.7);\n217:                     color: #fff;\n218:                     opacity: 0.8;\n219:                     animation: subtlePulse 3s infinite;\n220:                 }\n221:                 \n222:                 .resume-scroll-btn.has-new-content:hover {\n223:                     background: rgba(34, 139, 34, 0.9);\n224:                     opacity: 1;\n225:                 }\n226:                 \n227:                 @keyframes subtlePulse {\n228:                     0%, 100% { \n229:                         opacity: 0.6;\n230:                         transform: scale(1);\n231:                     }\n232:                     50% { \n233:                         opacity: 0.9;\n234:                         transform: scale(1.05);\n235:                     }\n236:                 }\n237:             `;\n238:             document.head.appendChild(style);\n239:         }\n240: \n241:         // Create a floating button that appears when user is in reading mode\n242:         const button = document.createElement('button');\n243:         button.className = 'resume-scroll-btn hidden';\n244:         button.innerHTML = '↓';\n245:         button.title = 'Resume auto-scroll (End key)';\n246:         \n247:         button.addEventListener('click', () => {\n248:             this.resumeAutoScroll();\n249:         });\n250:         \n251:         // Add to body (fixed positioning)\n252:         document.body.appendChild(button);\n253:         this.scrollState.resumeScrollButton = button;\n254:     }\n255: \n256:     showResumeScrollButton() {\n257:         if (this.scrollState.resumeScrollButton) {\n258:             this.scrollState.resumeScrollButton.classList.remove('hidden');\n259:             \n260:             // Update button based on whether new content is pending\n261:             if (this.scrollState.newContentPending) {\n262:                 this.scrollState.resumeScrollButton.innerHTML = '•';\n263:                 this.scrollState.resumeScrollButton.title = 'New content available - Resume auto-scroll (End key)';\n264:                 this.scrollState.resumeScrollButton.classList.add('has-new-content');\n265:             }\n266:         }\n267:     }\n268: \n269:     hideResumeScrollButton() {\n270:         if (this.scrollState.resumeScrollButton) {\n271:             this.scrollState.resumeScrollButton.classList.add('hidden');\n272:             this.scrollState.resumeScrollButton.classList.remove('has-new-content');\n273:             this.scrollState.resumeScrollButton.innerHTML = '↓';\n274:             this.scrollState.resumeScrollButton.title = 'Resume auto-scroll (End key)';\n275:         }\n276:     }\n277: \n278:     resumeAutoScroll() {\n279:         // Manually resume auto-scroll and go to bottom\n280:         this.exitReadingMode();\n281:         this.scrollToBottom();\n282:         console.log('🎯 User manually resumed auto-scroll');\n283:     }\n284: \n285:     setupScrollKeyboardShortcuts() {\n286:         // Add keyboard shortcuts for scroll control\n287:         document.addEventListener('keydown', (e) => {\n288:             // Only handle shortcuts when not typing in an input\n289:             if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') {\n290:                 return;\n291:             }\n292: \n293:             // Ctrl+End or End: Resume auto-scroll / go to bottom\n294:             if (e.key === 'End') {\n295:                 e.preventDefault();\n296:                 this.resumeAutoScroll();\n297:             }\n298:             \n299:             // Ctrl+Home or Home: Enter reading mode and go to top\n300:             else if (e.key === 'Home') {\n301:                 e.preventDefault();\n302:                 this.enterReadingMode();\n303:                 if (this.conversationStream) {\n304:                     this.conversationStream.scrollTop = 0;\n305:                 }\n306:             }\n307:             \n308:             // Escape: Toggle reading mode\n309:             else if (e.key === 'Escape' && !e.ctrlKey && !e.altKey) {\n310:                 e.preventDefault();\n311:                 if (this.scrollState.userReadingMode) {\n312:                     this.resumeAutoScroll();\n313:                 } else {\n314:                     this.enterReadingMode();\n315:                 }\n316:             }\n317:         });\n318:     }\n319: \n320:     // Show activity indicator\n321:     showActivity(text = 'Listening...') {\n322:         if (!this.activityIndicator) return;\n323: \n324:         const status = muteManager.getMuteStatus();\n325:         let indicatorText = text;\n326:         \n327:         if (status.universal) {\n328:             indicatorText = '⏸️ System Paused - Press Alt+U to resume';\n329:             this.activityIndicator.classList.add('paused');\n330:         } else if (status.microphone) {\n331:             indicatorText = '🔇 Microphone Muted - Press Alt+M to unmute';\n332:             this.activityIndicator.classList.remove('paused');\n333:         } else {\n334:             this.activityIndicator.classList.remove('paused');\n335:         }\n336: \n337:         this.activityIndicator.querySelector('span').textContent = indicatorText;\n338:         this.activityIndicator.classList.add('show');\n339:     }\n340: \n341:     hideActivity() {\n342:         if (this.activityIndicator) {\n343:             this.activityIndicator.classList.remove('show');\n344:         }\n345:     }\n346: \n347:     // Add interviewer question\n348:     addInterviewerQuestion(question, isInterim = false) {\n349:         // Live speech is high priority - but respect reading mode\n350:         if (!this.scrollState.userReadingMode) {\n351:             this.setScrollMode('live_bottom');\n352:         }\n353:         this.scrollState.isLiveSpeaking = true;\n354: \n355:         if (isInterim) {\n356:             if (!this.currentInterviewerElement) {\n357:                 this.currentInterviewerElement = this.createMessageElement('', 'interviewer');\n358:                 this.conversationStream.appendChild(this.currentInterviewerElement);\n359:                 this.updateEmptyState();\n360:             }\n361:             this.updateInterviewerMessage(this.currentInterviewerElement.querySelector('.streaming-text').textContent + ' ' + question);\n362:         } else {\n363:             if (this.currentInterviewerElement) {\n364:                 this.finalizeInterviewerMessage(question);\n365:             } else {\n366:                 this.addMessage(question, 'interviewer');\n367:             }\n368:             this.hideActivity();\n369:             this.updateEmptyState();\n370:             this.scrollState.isLiveSpeaking = false;\n371:         }\n372:         \n373:         // For live speech, be more aggressive about scrolling (but still respect reading mode)\n374:         if (!this.scrollState.userReadingMode) {\n375:             this.scrollToBottom();\n376:         } else {\n377:             // Notify user of new content if they're reading\n378:             this.scrollState.newContentPending = true;\n379:             this.showResumeScrollButton();\n380:         }\n381:     }\n382: \n383:     // Add candidate transcript (for when diarization is disabled - all speech from candidate)\n384:     addCandidateTranscript(transcript, isInterim = false) {\n385:         // Live speech is high priority - but respect reading mode\n386:         if (!this.scrollState.userReadingMode) {\n387:             this.setScrollMode('live_bottom');\n388:         }\n389:         this.scrollState.isLiveSpeaking = true;\n390: \n391:         if (isInterim) {\n392:             if (!this.currentCandidateElement) {\n393:                 this.currentCandidateElement = this.createMessageElement('', 'candidate');\n394:                 this.conversationStream.appendChild(this.currentCandidateElement);\n395:                 this.updateEmptyState();\n396:             }\n397:             this.updateCandidateMessage(this.currentCandidateElement.querySelector('.streaming-text').textContent + ' ' + transcript);\n398:         } else {\n399:             if (this.currentCandidateElement) {\n400:                 this.finalizeCandidateMessage(transcript);\n401:             } else {\n402:                 this.addMessage(transcript, 'candidate');\n403:             }\n404:             this.hideActivity();\n405:             this.updateEmptyState();\n406:             this.scrollState.isLiveSpeaking = false;\n407:         }\n408:         \n409:         // For live speech, be more aggressive about scrolling (but still respect reading mode)\n410:         if (!this.scrollState.userReadingMode) {\n411:             this.scrollToBottom();\n412:         } else {\n413:             // Notify user of new content if they're reading\n414:             this.scrollState.newContentPending = true;\n415:             this.showResumeScrollButton();\n416:         }\n417:     }\n418: \n419:     // Add AI response (legacy method)\n420:     addAIResponse(response, metadata = {}) {\n421:         // Filter thinking content from response\n422:         const filteredResponse = this.filterThinkingContent(response);\n423:         \n424:         this.currentAIElement = this.createMessageElement(filteredResponse, 'ai-response');\n425:         this.conversationStream.appendChild(this.currentAIElement);\n426: \n427:         // Use ai_streaming mode to prevent forced scrolling\n428:         this.setScrollMode('ai_streaming', this.currentAIElement);\n429: \n430:         this.startStreaming(this.currentAIElement, filteredResponse, true, () => {\n431:             // Add metadata after streaming completes\n432:             this.addResponseMetadata(this.currentAIElement, metadata);\n433:             \n434:             // On completion, stay in current position - don't force scroll\n435:             // Only set to live_bottom if user is already at bottom\n436:             if (this.isUserNearBottom()) {\n437:                 this.setScrollMode('live_bottom');\n438:             } else {\n439:                 this.setScrollMode('ai_static');\n440:             }\n441:         });\n442:         \n443:         this.hideActivity();\n444:         this.updateEmptyState();\n445:     }\n446: \n447:     // Add vision analysis response\n448:     addVisionAnalysis(analysis, metadata = {}) {\n449:         console.log('🎭 LiveInterviewUI.addVisionAnalysis called:', {\n450:             analysisLength: analysis?.length || 0,\n451:             provider: metadata?.provider,\n452:             model: metadata?.model,\n453:             screenshotCount: metadata?.screenshotCount\n454:         });\n455:         \n456:         // Filter thinking content from analysis\n457:         const filteredAnalysis = this.filterThinkingContent(analysis);\n458:         \n459:         const visionElement = this.createVisionAnalysisElement(filteredAnalysis, metadata);\n460:         this.conversationStream.appendChild(visionElement);\n461: \n462:         // Use ai_streaming mode to prevent forced scrolling\n463:         this.setScrollMode('ai_streaming', visionElement);\n464: \n465:         this.startStreaming(visionElement, filteredAnalysis, true, () => {\n466:             // On completion, stay in current position - don't force scroll\n467:             // Only set to live_bottom if user is already at bottom\n468:             if (this.isUserNearBottom()) {\n469:                 this.setScrollMode('live_bottom');\n470:             } else {\n471:                 this.setScrollMode('ai_static');\n472:             }\n473:             console.log('🎭 Vision analysis streaming completed');\n474:         });\n475:         \n476:         this.hideActivity();\n477:         this.updateEmptyState();\n478:     }\n479: \n480:     // Add message to conversation\n481:     addMessage(content, type) {\n482:         // Filter thinking content from all messages\n483:         const filteredContent = this.filterThinkingContent(content);\n484:         \n485:         const messageElement = this.createMessageElement(filteredContent, type);\n486:         this.conversationStream.appendChild(messageElement);\n487:         this.startStreaming(messageElement, filteredContent);\n488:         \n489:         // Only auto-scroll if user is near bottom, otherwise respect their position\n490:         if (this.isUserNearBottom()) {\n491:             this.scrollToBottom();\n492:         }\n493:         \n494:         this.updateEmptyState();\n495:     }\n496: \n497:     // Create message element\n498:     createMessageElement(content, type) {\n499:         const messageDiv = document.createElement('div');\n500:         messageDiv.className = `message ${type}`;\n501:         \n502:         const label = document.createElement('span');\n503:         label.className = 'label';\n504:         \n505:         // Set label based on type\n506:         switch (type) {\n507:             case 'interviewer':\n508:                 label.textContent = '🎤 Interviewer';\n509:                 break;\n510:             case 'candidate':\n511:                 label.textContent = '👤 Candidate';\n512:                 break;\n513:             default:\n514:                 label.textContent = '🤖 AI Assistant';\n515:                 break;\n516:         }\n517:         \n518:         const contentDiv = document.createElement('div');\n519:         contentDiv.className = 'streaming-text';\n520:         \n521:         messageDiv.appendChild(label);\n522:         messageDiv.appendChild(contentDiv);\n523:         \n524:         return messageDiv;\n525:     }\n526: \n527:     // Create vision analysis element with enhanced styling\n528:     createVisionAnalysisElement(content, metadata = {}) {\n529:         const messageDiv = document.createElement('div');\n530:         messageDiv.className = 'message ai-response vision-analysis';\n531:         \n532:         // Create header with vision-specific information\n533:         const headerDiv = document.createElement('div');\n534:         headerDiv.className = 'vision-header';\n535:         \n536:         const label = document.createElement('span');\n537:         label.className = 'label';\n538:         label.innerHTML = '👁️ Vision AI Analysis';\n539:         \n540:         const metaInfo = document.createElement('div');\n541:         metaInfo.className = 'vision-meta';\n542:         \n543:         let metaText = '';\n544:         if (metadata.provider && metadata.model) {\n545:             metaText += `${metadata.provider} - ${metadata.model}`;\n546:         }\n547:         if (metadata.screenshotCount) {\n548:             metaText += ` • ${metadata.screenshotCount} screenshot${metadata.screenshotCount > 1 ? 's' : ''}`;\n549:         }\n550:         if (metadata.languages && metadata.languages.length > 0) {\n551:             metaText += ` • ${metadata.languages.join(', ')}`;\n552:         }\n553:         \n554:         metaInfo.textContent = metaText;\n555:         \n556:         headerDiv.appendChild(label);\n557:         headerDiv.appendChild(metaInfo);\n558:         \n559:         const contentDiv = document.createElement('div');\n560:         contentDiv.className = 'streaming-text vision-content';\n561:         \n562:         messageDiv.appendChild(headerDiv);\n563:         messageDiv.appendChild(contentDiv);\n564:         \n565:         // Add vision-specific styling if not already present\n566:         this.addVisionStyles();\n567:         \n568:         return messageDiv;\n569:     }\n570: \n571:     // Add CSS styles for vision analysis elements\n572:     addVisionStyles() {\n573:         if (!document.getElementById('vision-analysis-styles')) {\n574:             const style = document.createElement('style');\n575:             style.id = 'vision-analysis-styles';\n576:             style.textContent = `\n577:                 .message.vision-analysis {\n578:                     border-left: 4px solid #6366f1;\n579:                     background: linear-gradient(135deg, rgba(99, 102, 241, 0.05) 0%, rgba(139, 92, 246, 0.05) 100%);\n580:                 }\n581:                 \n582:                 .vision-header {\n583:                     display: flex;\n584:                     justify-content: space-between;\n585:                     align-items: center;\n586:                     margin-bottom: 12px;\n587:                     padding-bottom: 8px;\n588:                     border-bottom: 1px solid rgba(99, 102, 241, 0.2);\n589:                 }\n590:                 \n591:                 .vision-header .label {\n592:                     color: #6366f1;\n593:                     font-weight: 600;\n594:                     font-size: 14px;\n595:                 }\n596:                 \n597:                 .vision-meta {\n598:                     font-size: 11px;\n599:                     color: #64748b;\n600:                     font-weight: 500;\n601:                     text-align: right;\n602:                 }\n603:                 \n604:                 .vision-content {\n605:                     line-height: 1.6;\n606:                 }\n607:                 \n608:                 .vision-content h1,\n609:                 .vision-content h2,\n610:                 .vision-content h3 {\n611:                     color: #6366f1;\n612:                     margin-top: 20px;\n613:                     margin-bottom: 10px;\n614:                 }\n615:                 \n616:                 .vision-content h1 {\n617:                     font-size: 18px;\n618:                     border-bottom: 2px solid rgba(99, 102, 241, 0.3);\n619:                     padding-bottom: 5px;\n620:                 }\n621:                 \n622:                 .vision-content h2 {\n623:                     font-size: 16px;\n624:                 }\n625:                 \n626:                 .vision-content h3 {\n627:                     font-size: 14px;\n628:                 }\n629:                 \n630:                 .vision-content code {\n631:                     background: rgba(99, 102, 241, 0.1);\n632:                     padding: 2px 6px;\n633:                     border-radius: 3px;\n634:                     font-family: 'Fira Code', 'Monaco', 'Consolas', monospace;\n635:                     font-size: 13px;\n636:                 }\n637:                 \n638:                 .vision-content pre {\n639:                     background: rgba(15, 23, 42, 0.95);\n640:                     border: 1px solid rgba(99, 102, 241, 0.3);\n641:                     border-radius: 6px;\n642:                     padding: 16px;\n643:                     margin: 12px 0;\n644:                     overflow-x: auto;\n645:                     position: relative;\n646:                 }\n647:                 \n648:                 .vision-content pre code {\n649:                     background: none;\n650:                     padding: 0;\n651:                     color: #e2e8f0;\n652:                     font-size: 13px;\n653:                     line-height: 1.5;\n654:                 }\n655:                 \n656:                 .vision-content ul,\n657:                 .vision-content ol {\n658:                     margin: 12px 0;\n659:                     padding-left: 20px;\n660:                 }\n661:                 \n662:                 .vision-content li {\n663:                     margin: 6px 0;\n664:                     line-height: 1.5;\n665:                 }\n666:                 \n667:                 .vision-content s