{"step_index":26,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-08-21T21:51:41Z","content":"Created At: 2026-08-21T18:51:41-03:00\nCompleted At: 2026-08-21T18:51:41-03:00\nFile Path: `file:///c:/Users/Arthur%20Henrique/Documents/GitHub/Spectra/web/js/main.js`\nTotal Lines: 442\nTotal Bytes: 16504\nShowing lines 1 to 442\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: // Modular main.js - Entry point and coordination\n2: import { StateManager } from './state-manager.js';\n3: import { WebSocketHandler } from './websocket-handler.js';\n4: import { ProviderManager } from './provider-manager.js';\n5: import {\n6:     setupMicrophone,\n7:     startAudioProcessing,\n8:     stopAudioProcessing,\n9:     getScreenVideoTrack,\n10:     isScreenSharingAvailable\n11: } from './audio_handler.js';\n12: import muteManager from './mute-manager.js';\n13: import { autofillForTesting } from './dev.js';\n14: import { loadConfig, isDev, devLog, devWarn, devError, applyConsoleGate } from './config.js';\n15: import liveInterviewUI from './live-interview.js';\n16: import hotkeyManager from './hotkeys.js';\n17: import presetManager from './preset-manager.js';\n18: import screenshotService from './screenshot-service.js';\n19: import { ConfigManager } from './config-manager.js';\n20: import { testStreamingMarkdown, testSampleMarkdown } from './streaming-markdown-demo.js';\n21: \n22: // Initialize managers\n23: const stateManager = new StateManager();\n24: const webSocketHandler = new WebSocketHandler(stateManager);\n25: const providerManager = new ProviderManager(stateManager, webSocketHandler);\n26: const configManager = new ConfigManager(stateManager);\n27: \n28: // Expose to window for inter-module integration\n29: window.providerManager = providerManager;\n30: window.configManager = configManager;\n31: \n32: // --- Dependency Injection ---\n33: // Wire the managers together to avoid race conditions and reliance on globals.\n34: // This ensures the WebSocketHandler has a direct reference to the ProviderManager.\n35: webSocketHandler.setProviderManager(providerManager);\n36: \n37: // --- DOM Elements ---\n38: const views = {\n39:     onboarding: document.getElementById('onboarding-view'),\n40:     preflight: document.getElementById('preflight-view'),\n41:     live: document.getElementById('live-view'),\n42: };\n43: \n44: const micSelect = document.getElementById('mic-select');\n45: const proceedButton = document.getElementById('proceed-to-checks');\n46: const startButton = document.getElementById('start-interview-button');\n47: const backButton = document.getElementById('back-to-onboarding-btn');\n48: \n49: // --- Tab Management ---\n50: function setupTabs() {\n51:     const tabBtns = document.querySelectorAll('.tab-btn');\n52:     const tabPanes = document.querySelectorAll('.tab-pane');\n53: \n54:     tabBtns.forEach(btn => {\n55:         btn.addEventListener('click', () => {\n56:             const targetId = btn.getAttribute('data-tab');\n57: \n58:             // Update buttons\n59:             tabBtns.forEach(b => b.classList.remove('active'));\n60:             btn.classList.add('active');\n61: \n62:             // Update panes\n63:             tabPanes.forEach(p => p.classList.remove('active'));\n64:             const targetPane = document.getElementById(targetId);\n65:             if (targetPane) targetPane.classList.add('active');\n66: \n67:             // Refresh advanced config if switching to that tab\n68:             if (targetId === 'advanced-config-tab') {\n69:                 configManager.loadInitialData();\n70:             }\n71:         });\n72:     });\n73: \n74:     // Wire up the Fill Demo Data button\n75:     const fillDemoBtn = document.getElementById('fill-demo-btn');\n76:     if (fillDemoBtn) {\n77:         fillDemoBtn.addEventListener('click', (e) => {\n78:             e.preventDefault();\n79:             e.stopPropagation();\n80:             autofillForTesting();\n81:             fillDemoBtn.textContent = '✅ Filled!';\n82:             setTimeout(() => { fillDemoBtn.textContent = '⚡ Demo'; }, 1500);\n83:         });\n84:     }\n85: \n86:     // Wire up Quick Presets\n87:     setupQuickPresets();\n88: }\n89: \n90: function setupQuickPresets() {\n91:     const cards = document.querySelectorAll('.preset-card');\n92:     const focusCheckboxes = document.querySelectorAll('input[name=\"focus\"]');\n93: \n94:     cards.forEach(card => {\n95:         card.addEventListener('click', () => {\n96:             cards.forEach(c => c.classList.remove('active'));\n97:             card.classList.add('active');\n98: \n99:             const preset = card.getAttribute('data-preset');\n100:             focusCheckboxes.forEach(cb => { cb.checked = false; });\n101: \n102:             if (preset === 'coding') {\n103:                 focusCheckboxes.forEach(cb => {\n104:                     if (cb.value === 'coding' || cb.value === 'dsa') cb.checked = true;\n105:                 });\n106:             } else if (preset === 'system-design') {\n107:                 focusCheckboxes.forEach(cb => {\n108:                     if (cb.value === 'system-design' || cb.value === 'coding') cb.checked = true;\n109:                 });\n110:             } else if (preset === 'behavioral') {\n111:                 focusCheckboxes.forEach(cb => {\n112:                     if (cb.value === 'behavioral' || cb.value === 'brief-human' || cb.value === 'cultural-fit') cb.checked = true;\n113:                 });\n114:             }\n115:         });\n116:     });\n117: }\n118: \n119: \n120: // --- View Management ---\n121: function switchView(targetView) {\n122:     Object.values(views).forEach(view => view.classList.remove('active'));\n123:     views[targetView].classList.add('active');\n124: }\n125: \n126: function handleOnboarding() {\n127:     if (stateManager.handleOnboarding()) {\n128:         switchView('preflight');\n129:         runPreFlightChecks();\n130:     }\n131: }\n132: \n133: async function runPreFlightChecks() {\n134:     // --- 1. Microphone Check ---\n135:     // First, ensure we have microphone permissions as this is a prerequisite.\n136:     const micPermissionCheck = document.getElementById('check-mic-permission');\n137:     const micSelectionCheck = document.getElementById('check-mic-selection');\n138: \n139:     providerManager.webSocketHandler.updateCheckStatus(micPermissionCheck, 'pending', 'Requesting Microphone...');\n140:     const micPermission = await setupMicrophone();\n141:     if (micPermission) {\n142:         providerManager.webSocketHandler.updateCheckStatus(micPermissionCheck, 'success', 'Microphone Permission OK');\n143:         providerManager.webSocketHandler.updateCheckStatus(micSelectionCheck, 'success', 'Microphone Selection Ready');\n144:     } else {\n145:         providerManager.webSocketHandler.updateCheckStatus(micPermissionCheck, 'error', 'Microphone Permission Denied');\n146:         providerManager.webSocketHandler.updateCheckStatus(micSelectionCheck, 'error', 'Microphone Selection Failed');\n147:         return;\n148:     }\n149: \n150:     // --- 2. Backend Connection and Session Establishment (NEW ASYNC FLOW) ---\n151:     // We now `await` the connection. The `connect` method returns a promise that\n152:     // only resolves after the WebSocket is open AND the server has confirmed\n153:     // that a session (new or resumed) is established.\n154:     try {\n155:         providerManager.webSocketHandler.updateCheckStatus(providerManager.checks.backend, 'pending', 'Connecting to Backend...');\n156:         await webSocketHandler.connect();\n157:         providerManager.webSocketHandler.updateCheckStatus(providerManager.checks.backend, 'success', 'Backend Connected');\n158:     } catch (error) {\n159:         providerManager.webSocketHandler.updateCheckStatus(providerManager.checks.backend, 'error', 'Backend Connection Failed');\n160:         console.error(\"Failed to establish WebSocket connection and session:\", error);\n161:         // The error status is already set within the WebSocketHandler's onError method.\n162:         return; // Stop checks if backend connection fails.\n163:     }\n164: \n165:     // --- 3. AI Provider and Deepgram API Verification ---\n166:     // These checks are now only run *after* the backend session is confirmed to be ready.\n167:     // This ensures that the verification messages can be sent reliably.\n168:     await providerManager.runPreFlightChecks();\n169: }\n170: \n171: // These functions are now handled by the modules\n172: \n173: // This function is now handled by WebSocketHandler\n174: \n175: // This function is now handled by WebSocketHandler\n176: \n177: async function startInterview() {\n178:     switchView('live');\n179:     liveInterviewUI.init();\n180:     liveInterviewUI.initialize();\n181:     hotkeyManager.setEnabled(true);\n182: \n183:     const onAudioData = (audioData, speakerHint) => {\n184:         webSocketHandler.sendAudioChunk(audioData, muteManager.isMicrophoneMuted());\n185:     };\n186: \n187:     const processingStarted = await startAudioProcessing(micSelect.value, onAudioData);\n188: \n189:     if (!processingStarted) {\n190:         alert(\"Could not start audio streams. Please check permissions and try again.\");\n191:         switchView('preflight');\n192:         return;\n193:     }\n194: \n195:     webSocketHandler.startInterview();\n196: }\n197: \n198: async function endInterview() {\n199:     console.log('🔚 Ending interview and clearing state...');\n200: \n201:     // Stop all audio processing\n202:     stopAudioProcessing();\n203: \n204:     // Send end interview signal to backend\n205:     webSocketHandler.endInterview();\n206: \n207:     // Disable hotkeys\n208:     hotkeyManager.setEnabled(false);\n209: \n210:     // Clear conversation UI\n211:     if (window.liveInterviewUI) {\n212:         liveInterviewUI.clearConversation();\n213:     }\n214: \n215:     // Comprehensive state clearing\n216:     stateManager.clearInterviewState();\n217: \n218:     // Reset preset manager if available\n219:     if (window.presetManager) {\n220:         presetManager.clearNotifications?.();\n221:     }\n222: \n223:     // Switch back to onboarding\n224:     switchView('onboarding');\n225: \n226:     console.log('✅ Interview ended and state cleared successfully');\n227: }\n228: \n229: async function resetInterview() {\n230:     console.log('🔄 Resetting interview...');\n231: \n232:     // Send reset signal to backend\n233:     webSocketHandler.sendMessage('reset_session', {});\n234: \n235:     // Clear conversation UI\n236:     if (window.liveInterviewUI) {\n237:         liveInterviewUI.clearConversation();\n238:         liveInterviewUI.showActivity('Listening...');\n239:     }\n240: \n241:     console.log('✅ Interview reset successfully');\n242: }\n243: \n244: // Provider management functions are now handled by ProviderManager\n245: \n246: \n247: // --- Preset Switching Functions ---\n248: function switchPreset(presetKey) {\n249:     return webSocketHandler.switchPreset(presetKey);\n250: }\n251: \n252: // --- Transparency Functions ---\n253: async function setTransparency(level) {\n254:     return await liveInterviewUI.setTransparency(level);\n255: }\n256: \n257: function getSystemStatus() {\n258:     return stateManager.getSystemStatus();\n259: }\n260: \n261: // --- Vision Mode Functions ---\n262: function switchVisionModel() {\n263:     return stateManager.switchVisionModel();\n264: }\n265: \n266: function toggleVisionMode() {\n267:     return stateManager.toggleVisionMode();\n268: }\n269: \n270: // --- Screenshot Functions ---\n271: async function captureScreenshot() {\n272:     return await stateManager.captureScreenshot();\n273: }\n274: \n275: async function processScreenshots() {\n276:     return await stateManager.processScreenshots();\n277: }\n278: \n279: async function resetScreenshotQueue() {\n280:     return await stateManager.resetScreenshotQueue();\n281: }\n282: \n283: // --- Audio Toggle Functions ---\n284: function toggleMicMute() {\n285:     return stateManager.toggleMicMute();\n286: }\n287: \n288: function toggleUniversalMute() {\n289:     return stateManager.toggleUniversalMute();\n290: }\n291: \n292: // --- Event Listeners ---\n293: function setupEventListeners() {\n294:     proceedButton?.addEventListener('click', handleOnboarding);\n295:     startButton?.addEventListener('click', startInterview);\n296:     backButton?.addEventListener('click', () => switchView('onboarding'));\n297: \n298:     // Provider change listeners\n299:     const providerSelect = document.getElementById('ai-provider-select');\n300:     const secondaryProviderSelect = document.getElementById('ai-secondary-provider-select');\n301:     const visionProviderSelect = document.getElementById('vision-provider-select');\n302:     const visionSecondaryProviderSelect = document.getElementById('vision-secondary-provider-select');\n303: \n304:     providerSelect?.addEventListener('change', providerManager.updateModelDropdown.bind(providerManager));\n305:     secondaryProviderSelect?.addEventListener('change', providerManager.updateSecondaryModelDropdown.bind(providerManager));\n306:     visionProviderSelect?.addEventListener('change', providerManager.updateVisionModelDropdown.bind(providerManager));\n307:     visionSecondaryProviderSelect?.addEventListener('change', providerManager.updateSecondaryVisionModelDropdown.bind(providerManager));\n308: }\n309: \n310: // Main initialization\n311: window.addEventListener('DOMContentLoaded', async () => {\n312:     await loadConfig();\n313:     applyConsoleGate(); // Suppress console.log/debug/info when DEV_MODE is off\n314:     await providerManager.loadAiProviders();\n315:     liveInterviewUI.init();\n316:     setupEventListeners();\n317:     setupDeveloperShortcuts();\n318:     setupPresetHotkeys();\n319:     setupTabs();\n320:     hotkeyManager.setEnabled(false);\n321:     switchView('onboarding');\n322: });\n323: \n324: // --- Developer Shortcuts ---\n325: function setupDeveloperShortcuts() {\n326: \n327:     devLog('🛠️ Developer shortcuts enabled');\n328: \n329:     // Console helper functions\n330:     if (isDev) {\n331:         console.log(`\n332: 🧪 === AURA DEVELOPER TOOLS ===\n333: Available testing functions:\n334: • testSampleMarkdown() - Test with sample markdown content  \n335: • testStreamingMarkdown() - Test with comprehensive scenarios\n336: • closeAllTestWindows() - Close all test windows manually\n337: • closeTestWindow('id') - Close specific test window\n338: • autofillForTesting() - Auto-fill onboarding form\n339: • Ctrl+J - Auto-fill form shortcut\n340: \n341: 📝 Real-time Markdown Testing:\n342: The new hybrid streaming markdown parser integrates with the existing \n343: MarkdownProcessor to provide real-time rendering that's compatible \n344: with code blocks, syntax highlighting, and all existing features.\n345: \n346: 🕒 Auto-Close Feature:\n347: Test windows now auto-close after 10 seconds with countdown display.\n348: Manual close (× button) cancels auto-close timer.\n349: \n350: Try: testSampleMarkdown()\n351: \n352: 🔧 Code Block Fix Applied:\n353: • Fixed missing code blocks in streaming responses\n354: • Added proper syntax highlighting with Prism.js\n355: • Integrated with existing MarkdownProcessor system\n356: • Real-time code block rendering during streaming\n357:         `);\n358:     }\n359: \n360:     window.addEventListener('keydown', (e) => {\n361:         if (e.ctrlKey && e.key === 'j') {\n362:             e.preventDefault();\n363:             devLog('🛠️ Auto-filling form via Ctrl+J');\n364:             autofillForTesting();\n365:         }\n366:     });\n367: }\n368: \n369: function setupPresetHotkeys() {\n370:     devLog('🎹 Setting up preset switching and vision hotkeys');\n371:     document.addEventListener('keydown', (e) => {\n372:         // Only work during live interview and if not focusing on input fields\n373:         if (!e.target.matches('input, textarea, select') && stateManager.isLiveInterviewActive()) {\n374:             if (e.altKey && !e.ctrlKey && !e.shiftKey) {\n375:                 switch (e.key.toLowerCase()) {\n376:                     case 'q':\n377:                         e.preventDefault();\n378:                         switchPreset('primary');\n379:                         devLog('🔄 Hotkey: Switching to primary preset');\n380:                         break;\n381:                     case 'w':\n382:                         e.preventDefault();\n383:                         switchPreset('secondary');\n384:                         devLog('🔄 Hotkey: Switching to secondary preset');\n385:                         break;\n386:                     case 'e':\n387:                         e.preventDefault();\n388:                         switchPreset('auto');\n389:                         devLog('🔄 Hotkey: Auto-selecting best preset');\n390:                         break;\n391:                     case 't':\n392:                         e.preventDefault();\n393:                         switchVisionModel();\n394:                         devLog('🔄 Hotkey: Switching vision model');\n395:                         break;\n396:                     case 'v':\n397:                         e.preventDefault();\n398:                         toggleVisionMode();\n399:                         devLog('👁️ Hotkey: Toggling vision mode');\n400:                         break;\n401:                     case 's':\n402:                         e.preventDefault();\n403:                         captureScreenshot();\n404:                         devLog('📸 Hotkey: Capturing screenshot');\n405:                         break;\n406:                     case 'p':\n407:                         e.preventDefault();\n408:                         processScreenshots();\n409:                         devLog('🔄 Hotkey: Processing screenshots');\n410:                         break;\n411:                 }\n412:             }\n413:         }\n414:     });\n415: }\n416: \n417: // --- Global Exports ---\n418: // Make functions globally accessible for hotkeys and external calls\n419: window.switchPreset = switchPreset;\n420: window.setTransparency = setTransparency;\n421: window.getSystemStatus = getSystemStatus;\n422: window.switchVisionModel = switchVisionModel;\n423: window.toggleVisionMode = toggleVisionMode;\n424: window.captureScreenshot = captureScreenshot;\n425: window.processScreenshots = processScreenshots;\n426: window.resetScreenshotQueue = resetScreenshotQueue;\n427: window.toggleMicMute = toggleMicMute;\n428: window.toggleUniversalMute = toggleUniversalMute;\n429: window.endInterview = endInterview;\n430: window.resetInterview = resetInterview;\n431: window.getScreenVideoTrack = getScreenVideoTrack;\n432: window.isScreenSharingAvailable = isScreenSharingAvailable;\n433: window.testStreamingMarkdown = testStreamingMarkdown;\n434: window.testSampleMarkdown = testSampleMarkdown;\n435: \n436: // Export managers for other modules\n437: window.appState = stateManager.getState();\n438: window.sendSocketMessage = (type, payload) => webSocketHandler.sendMessage(type, payload);\n439: window.webSocketHandler = webSocketHandler;\n440: \n441: // Export for external use\n442: export { switchView, startInterview, endInterview, stateManager, webSocketHandler, providerManager };\nThe above content shows the entire, complete file contents of the requested file.\n"}
